package LockDeferral {
  /** A door lock in the shape of the door model's LockControl. A lock or unlock request that arrives during the 250 ms motor pulse has no transition in 2.2 and is discarded (discardInput, inactiveOwner): DiscardingLock loses a request that changes the outcome, so a lock followed by an unlock during the pulse ends locked although the last request was unlock (in the case below the last request equals the first, so both locks end locked). With states in the flow a request is remembered in a variable: RememberingLock's states all write the latest request to wanted, and the resting states leave when wanted differs from where they rest, so it ends locked. Only the latest request is kept: requests that arrive during one pulse do not queue up a sequence of pulses. */
  import Swaml::Qos;
  qos def Queued: Policy {
    delivery = Delivery.atMostOnce;
    ordering = Ordering.fifo;
    capacity = 8;
    overflow = Overflow.dropOldest;
    requestTimeout = 1s;
  }
  port def Requests {
    provides event request(lock: bool);
  }
  component def DiscardingLock {
    /** The 2.2 shape, migrated. */
    reversed port requests: Requests;
    attribute locked: bool = false;
    attribute pulses: uint = 0;
    operation control() {
      state unlocked {
        on receive requests.request(lock) {
          if (lock) {
            exit;
          }
        }
      }
      state locking {
        on entry {
          pulses = pulses + 1;
        }
        after 250ms {
          locked = true;
          exit;
        }
      }
      state isLocked {
        on receive requests.request(lock) {
          if (not lock) {
            exit;
          }
        }
      }
      state unlocking {
        on entry {
          pulses = pulses + 1;
        }
        after 250ms {
          locked = false;
          to unlocked;
        }
      }
    }
    schedule {
      on start control();
    }
  }
  component def RememberingLock {
    /** The 3.0 shape: every state remembers the latest request in wanted; the resting states ask it. */
    reversed port requests: Requests;
    attribute locked: bool = false;
    attribute pulses: uint = 0;
    attribute wanted: bool = false;
    operation control() {
      state unlocked {
        on receive requests.request(lock) {
          wanted = lock;
        }
        if (wanted) exit;
      }
      state locking {
        on entry {
          pulses = pulses + 1;
        }
        on receive requests.request(lock) {
          wanted = lock;
        }
        after 250ms {
          locked = true;
          exit;
        }
      }
      state isLocked {
        on receive requests.request(lock) {
          wanted = lock;
        }
        if (not wanted) exit;
      }
      state unlocking {
        on entry {
          pulses = pulses + 1;
        }
        on receive requests.request(lock) {
          wanted = lock;
        }
        after 250ms {
          locked = false;
          to unlocked;
        }
      }
    }
    schedule {
      on start control();
    }
  }
  component def Body {
    /** Interface-only actor that sends lock requests to both locks. */
    port toDiscarding: Requests;
    port toRemembering: Requests;
  }
  component def Fob {
    /** Interface-only actor: a key fob with its own connection to the remembering lock, so its requests have their own queue. */
    port toRemembering: Requests;
  }
  component discarding: DiscardingLock;
  component remembering: RememberingLock;
  component body: Body;
  component fob: Fob;
  connect: Queued (body.toDiscarding, discarding.requests);
  connect: Queued (body.toRemembering, remembering.requests);
  connect: Queued (fob.toRemembering, remembering.requests);
  associate body, discarding to 'Requests during the pulse';
  associate body, fob to 'Request order across the pulse';
  test 'Requests during the pulse' of remembering {
    /** lock at 0 ms, then unlock at 100 ms and lock at 200 ms, both during the first pulse. The discarding lock drops both and stays locked after one pulse. The remembering lock keeps only the latest request, lock, so after the pulse ends at 250 ms it rests locked: one pulse, locked. A request queue (3.0 has no deferral) would have pulsed three times. */
    publish body.toDiscarding.request(true);
    publish body.toRemembering.request(true);
    wait 100ms;
    publish body.toDiscarding.request(false);
    publish body.toRemembering.request(false);
    wait 100ms;
    publish body.toDiscarding.request(true);
    publish body.toRemembering.request(true);
    wait 600ms;
    assert discarding.locked and discarding.pulses == 1;
    assert remembering.locked and remembering.pulses == 1;
  }
  test 'Request order across the pulse' of remembering {
    /** Two requests during one pulse are looked at in delivery order across their queues: the fob's unlock, then the body's lock, so wanted ends true and the lock rests locked after one pulse. The body's queue is the older one (its first lock request started the pulse), so taking the queues in creation order would leave wanted false and unlock: two pulses, unlocked. */
    publish body.toRemembering.request(true);
    wait 10ms;
    publish fob.toRemembering.request(false);
    publish body.toRemembering.request(true);
    wait 900ms;
    assert remembering.locked and remembering.pulses == 1;
  }
}
