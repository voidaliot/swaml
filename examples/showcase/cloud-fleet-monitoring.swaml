  view 'periodic jobs': Timing {
    /** Aggregation window, retention, health probes, audit sealing, dead-letter rotation, campaign evaluation and rate-limit refill. */
    include backend.writer.flushWindow;
    include backend.store.retention;
    include backend.monitor.probe;
    include backend.audit.seal;
    include backend.deadLetters.rotate;
    include backend.campaign.evaluate;
    include backend.sessions[0].refill;
  }
}
package FleetCloud::Resilience {
  /** An isolation package for the persistence writer: a telemetry source and a store stub driven by the test script, so a store outage can be staged. */
  import FleetCloud;
  import Swaml::Views;
  component def TelemetrySource {
    /** Actor: the accepted-telemetry stream. */
    port stream: TelemetryStream;
  }
  component def StoreStub {
    /** Stub: the test answers or ignores the store's write requests. */
    port data: SeriesApi;
  }
  component writer: PersistenceWriter;
  component feed: TelemetrySource;
  component store: StoreStub;
  connect buffered: WriterBuffer (feed.stream, writer.stream);
  connect writes: StoreCalls (writer.store, store.data);
  test 'Store outage trips the breaker and recovers' of writer {
    /**
    Three writes time out against a silent store and the next arrival opens the breaker; a point during the cool-down
    is shed. After 2 s the half-open probe also times out, so the following arrival re-opens the breaker. After a
    second cool-down the next probe reaches the recovered store and closes the breaker.
    */
    publish feed.stream.accepted(Sample("TRK-101", 1, 50.0));
    publish feed.stream.accepted(Sample("TRK-101", 2, 52.0));
    publish feed.stream.accepted(Sample("TRK-101", 3, 54.0));
    wait 1s;
    assert writer.consecutiveFailures == 3 and writer.breaker == Breaker.closed and writer.written == 0;
    publish feed.stream.accepted(Sample("TRK-101", 4, 56.0));
    wait 10ms;
    assert writer.breaker == Breaker.open and writer.opened == 1 and writer.trippingArrivals == 1;
    publish feed.stream.accepted(Sample("TRK-101", 5, 58.0));
    wait 1s;
    assert writer.breaker == Breaker.open and writer.written == 0;
    wait 1s;
    assert writer.breaker == Breaker.halfOpen and writer.consecutiveFailures == 0;
    publish feed.stream.accepted(Sample("TRK-101", 6, 60.0));
    wait 300ms;
    assert writer.breaker == Breaker.closed and writer.consecutiveFailures == 3 and writer.written == 0;
    publish feed.stream.accepted(Sample("TRK-101", 7, 62.0));
    wait 10ms;
    assert writer.breaker == Breaker.open and writer.opened == 2 and writer.trippingArrivals == 2;
    wait 2s;
    assert writer.breaker == Breaker.halfOpen;
    publish feed.stream.accepted(Sample("TRK-101", 8, 64.0));
    on call store.data.append(t) {
      assert t.sequence == 8;
      return true;
    } or after 1s {
      fail "no probe after the second cool-down";
    }
    wait 10ms;
    assert writer.breaker == Breaker.closed and writer.consecutiveFailures == 0 and writer.written == 1;
  }
  associate feed to 'Store outage trips the breaker and recovers';
  associate store to 'Store outage trips the breaker and recovers';
  verify 'Store resilience' by 'Store outage trips the breaker and recovers';
  view isolation: Interconnect {
    include writer;
    include feed;
    include store;
  }
  view outage: Sequence of 'Store outage trips the breaker and recovers';
  view 'outage timing': Timing of 'Store outage trips the breaker and recovers';
}
package FleetCloud::Edge {
  /** An isolation package for one device gateway: the vehicle, the registry and ingestion are stubs driven by the test scripts, so retries, backoff and watermarks can be timed exactly. */
  import FleetCloud;
  import Swaml::Views;
  component def DirectoryStub {
    /** Stub: the test answers device authentication. */
    port directory: DeviceAuth;
  }
  component def IngestionStub {
    /** Stub: the test answers, or lets time out, frame submissions and sets the backlog. */
    port intake: Intake;
  }
  component def LivenessSink {
    /** Stub: receives forwarded heartbeats. */
    reversed port liveness: Liveness;
  }
  component def AuditSink {
    /** Stub: receives the gateway's audit entries. */
    reversed port entries: AuditFeed;
  }
  component def CommandStub {
    /** Stub: the command service side of the gateway. */
    port downlink: CommandDownlink;
    reversed port acks: CommandAcks;
  }
  component gateway: DeviceGateway;
  component vehicle: Vehicle;
  component directory: DirectoryStub;
  component ingest: IngestionStub;
  component beats: LivenessSink;
  component commands: CommandStub;
  component auditTrail: AuditSink;
  connect uplink: VehicleUplink (vehicle.link, gateway.vehicle);
  connect deviceAuth: ControlCalls (gateway.directory, directory.directory);
  connect submissions: TelemetryIntake (gateway.intake, ingest.intake);
  connect (gateway.liveness, beats.liveness);
  connect (commands.downlink, gateway.downlink);
  connect (gateway.commandAcks, commands.acks);
  connect (gateway.audit, auditTrail.entries);
  test 'Gateway retries with backoff' of gateway {
    /** The first submission times out after 200 ms; the retry follows the 50 ms backoff, not earlier, and its success is acknowledged to the vehicle. */
    publish vehicle.link.hello("TRK-101", "key-101");
    on call directory.directory.authenticate(id, deviceKey) {
      assert id == "TRK-101" and deviceKey == "key-101";
      return Known("TRK-101", "alder", 0, 1);
    } or after 1s {
      fail "no authentication request";
    }
    on receive vehicle.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "session not opened";
    }
    publish vehicle.link.frame(Reading("TRK-101", 1, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true));
    wait 201ms;
    on call ingest.intake.submit(e) {
      fail "retried before the 50 ms backoff";
    } or after 40ms {
    }
    on call ingest.intake.submit(e) {
      assert e.frame.sequence == 1 and e.tenantId == "alder" and e.epoch == 1;
      return IngestOutcome.accepted;
    } or after 20ms {
      fail "no retry after the backoff";
    }
    on receive vehicle.link.ack(sequence, outcome) {
      assert sequence == 1 and outcome == IngestOutcome.accepted;
    } or after 100ms {
      fail "retried frame not acknowledged";
    }
    assert gateway.retries == 1 and gateway.forwarded == 1;
  }
  test 'Gateway gives up after three attempts' of gateway {
    /** With ingestion silent, three attempts (at 0, 250 and 600 ms) time out and the vehicle is told the frame is unavailable at 800 ms, so it keeps it for retransmission. */
    publish vehicle.link.hello("TRK-101", "key-101");
    on call directory.directory.authenticate(id, deviceKey) {
      return Known("TRK-101", "alder", 0, 1);
    } or after 1s {
      fail "no authentication request";
    }
    on receive vehicle.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "session not opened";
    }
    publish vehicle.link.frame(Reading("TRK-101", 1, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true));
    on receive vehicle.link.ack(sequence, outcome) {
      fail "gave up before the third attempt";
    } or after 790ms {
    }
    on receive vehicle.link.ack(sequence, outcome) {
      assert sequence == 1 and outcome == IngestOutcome.unavailable;
    } or after 20ms {
      fail "no unavailable acknowledgement after three attempts";
    }
    assert gateway.retries == 2 and gateway.forwarded == 0;
  }
  test 'Back-pressure watermarks' of gateway {
    /** A backlog below the high watermark (6) does not throttle, reaching it does; a backlog above the low watermark (1) keeps the throttle, reaching it releases. */
    publish vehicle.link.hello("TRK-101", "key-101");
    on call directory.directory.authenticate(id, deviceKey) {
      return Known("TRK-101", "alder", 0, 1);
    } or after 1s {
      fail "no authentication request";
    }
    on receive vehicle.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "session not opened";
    }
    send ingest.intake.backlog(5);
    on receive vehicle.link.throttle(intervalMs) {
      fail "throttled below the high watermark";
    } or after 5ms {
    }
    send ingest.intake.backlog(6);
    on receive vehicle.link.throttle(intervalMs) {
      assert intervalMs == 5000;
    } or after 5ms {
      fail "not throttled at the high watermark";
    }
    send ingest.intake.backlog(2);
    on receive vehicle.link.throttle(intervalMs) {
      fail "released above the low watermark";
    } or after 5ms {
    }
    send ingest.intake.backlog(1);
    on receive vehicle.link.throttle(intervalMs) {
      assert intervalMs == 1000;
    } or after 5ms {
      fail "not released at the low watermark";
    }
    assert gateway.backlog == 1 and not gateway.throttled;
  }
  associate vehicle to 'Gateway retries with backoff';
  associate directory to 'Gateway retries with backoff';
  associate ingest to 'Gateway retries with backoff';
  associate vehicle to 'Gateway gives up after three attempts';
  associate directory to 'Gateway gives up after three attempts';
  associate vehicle to 'Back-pressure watermarks';
  associate directory to 'Back-pressure watermarks';
  associate ingest to 'Back-pressure watermarks';
  verify 'Lossless ingestion' by 'Gateway gives up after three attempts';
  verify 'Back-pressure' by 'Back-pressure watermarks';
  view 'gateway isolation': Interconnect {
    include gateway;
    include vehicle;
    include directory;
    include ingest;
    include beats;
    include commands;
    include auditTrail;
  }
  view 'retry timing': Timing of 'Gateway retries with backoff';
  view 'retry sequence': Sequence of 'Gateway retries with backoff';
}
package FleetCloud::Ingest {
  /** An isolation package for the ingestion pipeline: its test submits stamped envelopes directly, so a frame of an older session can arrive after the new session's first frame. */
  import FleetCloud;
  import Swaml::Views;
  component def GatewaySide {
    /** Stub: the gateway end of the intake. */
    reversed port intake: Intake;
  }
  component def StreamSink {
    reversed port stream: TelemetryStream;
  }
  component def QuarantineSink {
    reversed port letters: DeadLetterFeed;
  }
  component def Prober {
    reversed port health: Health;
  }
  component pipeline: IngestionPipeline;
  component gateway: GatewaySide;
  component stream: StreamSink;
  component quarantine: QuarantineSink;
  component prober: Prober;
  connect (gateway.intake, pipeline.intake);
  connect (pipeline.stream, stream.stream);
  connect (pipeline.deadLetters, quarantine.letters);
  connect (prober.health, pipeline.health);
  test 'Late frame of an older session is superseded' of pipeline {
    /** After session 2 delivered its first frame, a late frame of session 1 is superseded however high its sequence; a retransmission in session 2 is a duplicate and session 3 starts afresh. */
    var first: IngestOutcome = pipeline.submit(Stamped(Reading("TRK-101", 1, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true), 2));
    assert first == IngestOutcome.accepted;
    var late: IngestOutcome = pipeline.submit(Stamped(Reading("TRK-101", 9, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true), 1));
    assert late == IngestOutcome.superseded;
    var again: IngestOutcome = pipeline.submit(Stamped(Reading("TRK-101", 1, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true), 2));
    assert again == IngestOutcome.duplicate;
    var fresh: IngestOutcome = pipeline.submit(Stamped(Reading("TRK-101", 1, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true), 3));
    assert fresh == IngestOutcome.accepted;
    assert pipeline.supersededFrames == 1 and pipeline.duplicateFrames == 1 and pipeline.acceptedFrames == 2;
  }
  verify 'Lossless ingestion' by 'Late frame of an older session is superseded';
  view 'ingestion isolation': Interconnect {
    include pipeline;
    include gateway;
    include stream;
    include quarantine;
    include prober;
  }
}
