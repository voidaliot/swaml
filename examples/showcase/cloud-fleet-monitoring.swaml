  associate birchDispatcher to 'Console guards';
  test 'Superseded session closes' of backend {
    /** The truck reconnects over a second link: the old session is told it is closed, its frames are refused and its heartbeats no longer keep the twin online, while the new session carries on with a restarted sequence. */
    var me: Principal = alderDispatcher.console.login("tok-alder-ana");
    assert me.authenticated;
    publish alderDispatcher.console.subscribe();
    publish truck.link.hello("TRK-101", "key-101");
    on receive truck.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "first session not opened";
    }
    publish truck.link.frame(Reading("TRK-101", 5, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true));
    on receive truck.link.ack(sequence, outcome) {
      assert outcome == IngestOutcome.accepted;
    } or after 1s {
      fail "first session frame not acknowledged";
    }
    on receive alderDispatcher.console.vehicleUpdate(v) {
      assert v.link == LinkState.online;
    } or after 1s {
      fail "vehicle not shown online";
    }
    publish van.link.hello("TRK-101", "key-101");
    on receive van.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "second session not opened";
    }
    on receive truck.link.welcome(accepted) {
      assert not accepted;
    } or after 1s {
      fail "old session not told it is closed";
    }
    publish truck.link.frame(Reading("TRK-101", 6, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true));
    on receive truck.link.ack(sequence, outcome) {
      assert sequence == 6 and outcome == IngestOutcome.unauthenticated;
    } or after 1s {
      fail "old session frame not refused";
    }
    publish truck.link.heartbeat("TRK-101", 7);
    on receive alderDispatcher.console.vehicleUpdate(v) {
      fail "old session heartbeat refreshed the twin";
    } or after 200ms {
    }
    publish van.link.frame(Reading("TRK-101", 1, 2, 12.0, 10.0, 52.0, 85.0, 69.0, true));
    on receive van.link.ack(sequence, outcome) {
      assert sequence == 1 and outcome == IngestOutcome.accepted;
    } or after 1s {
      fail "new session frame not acknowledged";
    }
    on receive alderDispatcher.console.vehicleUpdate(v) {
      assert v.position.xKm == 12.0 and v.lastSequence == 1;
    } or after 1s {
      fail "new session data not shown";
    }
    assert backend.registry.authentications == 2 and backend.ingestion.acceptedFrames == 2;
    assert backend.audit.accessEntries == 2 and backend.audit.refusalEntries == 1;
  }
  test 'Command acknowledgements are authenticated' of backend {
    /**
    Acknowledgements of a pending command are refused from an unauthenticated link, from another tenant's
    authenticated vehicle, from the truck after it re-authenticated on the same link (a new session that was not sent
    the command) and from the truck's session after it was superseded; the command times out instead of
    being reported delivered. A second command, after the first completed, reaches only the new session and its
    genuine acknowledgement is accepted.
    */
    var me: Principal = alderDispatcher.console.login("tok-alder-ana");
    assert me.authenticated;
    publish truck.link.hello("TRK-101", "key-101");
    on receive truck.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "truck session not opened";
    }
    var issued: CommandUpdate = alderDispatcher.console.issueCommand("TRK-101", CommandKind.immobilize, 0);
    assert issued.status == CommandStatus.pending;
    on receive truck.link.command(c) {
      assert c.commandId == issued.commandId;
    } or after 1s {
      fail "command not delivered";
    }
    publish van.link.commandAck(issued.commandId, true);
    publish van.link.hello("VAN-202", "key-202");
    on receive van.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "van session not opened";
    }
    publish van.link.commandAck(issued.commandId, true);
    publish truck.link.hello("TRK-101", "key-101");
    on receive truck.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "truck could not re-authenticate on its link";
    }
    publish truck.link.commandAck(issued.commandId, true);
    publish van.link.hello("TRK-101", "key-101");
    on receive van.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "truck could not reconnect over the second link";
    }
    on receive truck.link.welcome(accepted) {
      assert not accepted;
    } or after 1s {
      fail "old session not closed";
    }
    publish truck.link.commandAck(issued.commandId, true);
    on receive alderDispatcher.console.commandUpdate(u) {
      assert u.commandId == issued.commandId and u.status == CommandStatus.timedOut;
    } or after 2s {
      fail "spoofed command did not time out";
    }
    var next: CommandUpdate = alderDispatcher.console.issueCommand("TRK-101", CommandKind.locate, 0);
    assert next.status == CommandStatus.pending;
    on receive truck.link.command(c) {
      fail "superseded session received a command";
    } or after 100ms {
    }
    on receive van.link.command(c) {
      assert c.commandId == next.commandId;
      publish van.link.commandAck(c.commandId, true);
    } or after 1s {
      fail "new session did not receive the command";
    }
    on receive alderDispatcher.console.commandUpdate(u) {
      assert u.commandId == next.commandId and u.status == CommandStatus.delivered;
    } or after 1s {
      fail "genuine acknowledgement not accepted";
    }
    assert backend.commands.intake.timedOut == 1 and backend.commands.intake.delivered == 1;
    assert backend.audit.refusalEntries == 4;
  }
  test 'Paging queue follows alert state' of backend {
    /**
    The desk is busy with a truck breach while a van overheat and then a truck overheat are queued. The truck overheat
    clears while queued, which withdraws nothing. When the breach is acknowledged the van overheat is handed over and
    paged; when it clears, its paging is withdrawn, and the resolved truck overheat is skipped instead of paged.
    */
    publish truck.link.hello("TRK-101", "key-101");
    publish van.link.hello("VAN-202", "key-202");
    on receive truck.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "truck session not opened";
    }
    on receive van.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "van session not opened";
    }
    publish truck.link.frame(Reading("TRK-101", 1, 2, 30.0, 20.0, 60.0, 85.0, 55.0, true));
    publish truck.link.frame(Reading("TRK-101", 2, 2, 41.2, 20.0, 60.0, 85.0, 55.0, true));
    on call pager.api.deliver(p) {
      assert p.alertId == 1;
      return true;
    } or after 1s {
      fail "breach not paged";
    }
    publish van.link.frame(Reading("VAN-202", 1, 2, 20.0, 5.0, 40.0, 80.0, 65.0, true));
    publish van.link.frame(Reading("VAN-202", 2, 2, 20.0, 5.0, 40.0, 110.0, 65.0, true));
    wait 20ms;
    publish truck.link.frame(Reading("TRK-101", 3, 2, 41.2, 20.0, 60.0, 110.0, 55.0, true));
    wait 20ms;
    assert backend.alerting.router.paged == 3 and backend.alerting.router.waitingCount == 2;
    publish truck.link.frame(Reading("TRK-101", 4, 2, 41.2, 20.0, 60.0, 90.0, 55.0, true));
    wait 20ms;
    assert backend.alerting.router.resolved == 1 and backend.alerting.router.withdrawn == 0;
    publish onCall.console.acknowledge(1, "dana");
    on call pager.api.deliver(p) {
      assert p.alertId == 2 and p.channel == Channel.push;
      return true;
    } or after 1s {
      fail "queued page not handed over";
    }
    publish van.link.frame(Reading("VAN-202", 3, 2, 20.0, 5.0, 40.0, 90.0, 65.0, true));
    wait 20ms;
    assert backend.alerting.router.withdrawn == 1 and backend.alerting.desk.withdrawals == 1;
    on call pager.api.deliver(p) {
      fail "paged an alert that resolved while queued";
    } or after 1s {
    }
    assert not backend.alerting.router.deskBusy and backend.alerting.router.waitingCount == 0;
    assert backend.alerting.desk.acknowledged == 1 and backend.alerting.desk.escalations == 0;
  }
  test 'Gateway audit names the responsible tenant' of backend {
    /** A refusal carries a tenant only when an authenticated session is responsible: a refused re-hello keeps the truck session, a frame claiming the van is charged to the truck's tenant, and after the truck session is superseded its refusals, like an unauthenticated link's, carry no tenant. */
    publish van.link.hello("VAN-202", "key-999");
    on receive van.link.welcome(accepted) {
      assert not accepted;
    } or after 1s {
      fail "wrong van key accepted";
    }
    wait 10ms;
    assert backend.audit.lastEntry.actor == "VAN-202" and backend.audit.lastEntry.tenantId == "";
    publish truck.link.hello("TRK-101", "key-101");
    on receive truck.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "truck session not opened";
    }
    publish truck.link.hello("TRK-101", "key-999");
    on receive truck.link.welcome(accepted) {
      assert not accepted;
    } or after 1s {
      fail "wrong re-hello key accepted";
    }
    wait 10ms;
    assert backend.audit.lastEntry.action == "device re-authentication refused: session kept" and backend.audit.lastEntry.tenantId == "";
    publish truck.link.frame(Reading("TRK-101", 1, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true));
    on receive truck.link.ack(sequence, outcome) {
      assert outcome == IngestOutcome.accepted;
    } or after 1s {
      fail "session lost after a refused re-hello";
    }
    publish truck.link.frame(Reading("VAN-202", 1, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true));
    on receive truck.link.ack(sequence, outcome) {
      assert outcome == IngestOutcome.unauthenticated;
    } or after 1s {
      fail "frame claiming the van not refused";
    }
    wait 10ms;
    assert backend.audit.lastEntry.actor == "TRK-101" and backend.audit.lastEntry.tenantId == "alder" and backend.audit.lastEntry.subject == "VAN-202";
    publish van.link.frame(Reading("VAN-202", 1, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true));
    on receive van.link.ack(sequence, outcome) {
      assert outcome == IngestOutcome.unauthenticated;
    } or after 1s {
      fail "unauthenticated van frame not refused";
    }
    wait 10ms;
    assert backend.audit.lastEntry.actor == "VAN-202" and backend.audit.lastEntry.tenantId == "";
    publish van.link.hello("TRK-101", "key-101");
    on receive van.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "truck could not reconnect over the second link";
    }
    on receive truck.link.welcome(accepted) {
      assert not accepted;
    } or after 1s {
      fail "old session not closed";
    }
    publish truck.link.frame(Reading("VAN-202", 2, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true));
    on receive truck.link.ack(sequence, outcome) {
      assert outcome == IngestOutcome.unauthenticated;
    } or after 1s {
      fail "frame on the closed session not refused";
    }
    wait 10ms;
    assert backend.audit.lastEntry.actor == "VAN-202" and backend.audit.lastEntry.tenantId == "" and backend.audit.lastEntry.action == "frame refused: no session";
    publish truck.link.commandAck(1001, true);
    wait 10ms;
    assert backend.audit.lastEntry.action == "command acknowledgement refused" and backend.audit.lastEntry.tenantId == "" and backend.audit.lastEntry.actor == "";
    assert backend.audit.refusalEntries == 6 and backend.audit.accessEntries == 1 and backend.ingestion.acceptedFrames == 1;
  }
  associate truck to 'Gateway audit names the responsible tenant';
  associate van to 'Gateway audit names the responsible tenant';
  test 'Supersede during a refused re-hello' of backend {
    /** The van link opens a new TRK-101 session while the truck link's re-hello with a wrong key is being authenticated: once the re-hello is refused, the truck session is still closed. */
    var me: Principal = alderDispatcher.console.login("tok-alder-ana");
    assert me.authenticated;
    publish truck.link.hello("TRK-101", "key-101");
    on receive truck.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "truck session not opened";
    }
    publish van.link.hello("TRK-101", "key-101");
    publish truck.link.hello("TRK-101", "key-999");
    on receive van.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "second session not opened";
    }
    on receive truck.link.welcome(accepted) {
      assert not accepted;
    } or after 1s {
      fail "re-hello not refused";
    }
    on receive truck.link.welcome(accepted) {
      assert not accepted;
    } or after 300ms {
      fail "truck session not told it is closed";
    }
    publish truck.link.frame(Reading("TRK-101", 9, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true));
    on receive truck.link.ack(sequence, outcome) {
      assert outcome == IngestOutcome.unauthenticated;
    } or after 1s {
      fail "frame on the superseded session not refused";
    }
    var c: CommandUpdate = alderDispatcher.console.issueCommand("TRK-101", CommandKind.locate, 0);
    assert c.status == CommandStatus.pending;
    on receive truck.link.command(x) {
      fail "superseded session received a command";
    } or after 100ms {
    }
    on receive van.link.command(x) {
      assert x.commandId == c.commandId;
    } or after 1s {
      fail "new session did not receive the command";
    }
    assert backend.audit.accessEntries == 2;
  }
  test 'Supersede after a refused re-hello' of backend {
    /** The same race with the hellos in the opposite order: the truck re-hello with a wrong key is sent first, then the van link opens the new TRK-101 session; the truck session ends closed. */
    var me: Principal = alderDispatcher.console.login("tok-alder-ana");
    assert me.authenticated;
    publish truck.link.hello("TRK-101", "key-101");
    on receive truck.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "truck session not opened";
    }
    publish truck.link.hello("TRK-101", "key-999");
    publish van.link.hello("TRK-101", "key-101");
    on receive van.link.welcome(accepted) {
      assert accepted;
    } or after 1s {
      fail "second session not opened";
    }
    on receive truck.link.welcome(accepted) {
      assert not accepted;
    } or after 1s {
      fail "re-hello not refused";
    }
    on receive truck.link.welcome(accepted) {
      assert not accepted;
    } or after 300ms {
      fail "truck session not told it is closed";
    }
    publish truck.link.frame(Reading("TRK-101", 9, 2, 10.0, 10.0, 50.0, 85.0, 70.0, true));
    on receive truck.link.ack(sequence, outcome) {
      assert outcome == IngestOutcome.unauthenticated;
    } or after 1s {
      fail "frame on the superseded session not refused";
    }
    var c: CommandUpdate = alderDispatcher.console.issueCommand("TRK-101", CommandKind.locate, 0);
    on receive truck.link.command(x) {
      fail "superseded session received a command";
    } or after 100ms {
    }
    assert c.status == CommandStatus.pending and backend.audit.accessEntries == 2;
  }
  associate truck to 'Supersede during a refused re-hello';
  associate van to 'Supersede during a refused re-hello';
  associate alderDispatcher to 'Supersede during a refused re-hello';
  associate truck to 'Supersede after a refused re-hello';
  associate van to 'Supersede after a refused re-hello';
  associate alderDispatcher to 'Supersede after a refused re-hello';
  associate truck to 'Superseded session closes';
  associate van to 'Superseded session closes';
  associate alderDispatcher to 'Superseded session closes';
  associate truck to 'Command acknowledgements are authenticated';
  associate van to 'Command acknowledgements are authenticated';
  associate alderDispatcher to 'Command acknowledgements are authenticated';
  associate truck to 'Paging queue follows alert state';
  associate van to 'Paging queue follows alert state';
  associate pager to 'Paging queue follows alert state';
  associate onCall to 'Paging queue follows alert state';
