  verify 'Switch panel communication' by 'Switch panel lost';
  verify 'Network-managed sleep' by 'Sleep and wake';
  verify 'Network-managed sleep' by 'Bus keeps the ECU awake after ignition off';
  verify 'Network-managed sleep' by 'Calibration stored at shutdown';
  verify 'Watchdog supervision' by 'Watchdog serviced';
  verify 'Watchdog supervision' by 'Watchdog stops on a supervision failure';

  // ---------------------------------------------------------------------- views

  view overview: General of dcu /** Ownership of the door control unit software: services and application components. */;
  view routing: Interconnect of dcu;
  view bench: Interconnect {
    /** The package context: ECU, switch panel, plant, watchdog and actors with their package connections. */
    include dcu;
    include switchPanel;
    include door;
    include watchdogIc;
    include driver;
    include passenger;
    include bcm;
    include tester;
    include supply;
  }
  view cases: Case of DoorEcu;
  view pinchSequence: Sequence of 'Pinch reversal';
  view lockSequence: Sequence of 'Lock and unlock';
  view inventory: Grid of dcu;
  view runnables: Grid {
    /** Every runnable of the composition, for the task-mapping review. */
    include dcu recursive where kind == "operation";
  }
  view windowStates: Flow of dcu.window.control;
  view lockStates: Flow of dcu.lock.control;
  view modeStates: Flow of dcu.ecuMode.control;
  view foldStates: Flow of dcu.mirror.foldControl;
  view antiPinchFlow: Flow of dcu.antiPinch.evaluate;
  view writeAllFlow: Flow of dcu.nvm.writeAllJob;
  view sensingTiming: Timing {
    /** The conversion-triggered sense, decide and actuate chain and the 20 ms LIN and CAN main functions. */
    include dcu.ioIn.acquire;
    include dcu.ioIn.distribute;
    include dcu.antiPinch.evaluate;
    include dcu.ioOut.driveWindow;
    include dcu.linIf.slot;
    include dcu.comMain.rxMainFunction;
    include dcu.comMain.txMainFunction;
  }
  view crashTiming: Timing of 'Crash unlocks a locked door';
}
