// Door control unit software in the style of AUTOSAR Classic.
// A showcase model: application software components, an explicit basic-software-like
// boundary (I/O hardware abstraction, CAN and LIN communication, network-managed sleep,
// diagnostics, NVRAM, watchdog, mode management), an RTE-like routing of owned ports,
// the task mapping, a body-electronics test bench (door mechanics, external watchdog,
// switch panel) and executable use cases and tests. Values are illustrative; this model
// makes no claim of conformance to any AUTOSAR or vehicle-manufacturer specification.
package DoorEcu::Types {
  /** Value types shared by the door control unit, its bus peers and the test bench. */
  enum PowerMode {
    /** ECU state as managed by the mode manager (EcuM/BswM/ComM-like). */
    startup, run, postRun, readySleep, shutdown, sleep, wakeup
  }
  enum WakeSource {
    /** Validated wake-up source or local user activity reported to the mode manager. */
    none, can, lin, localInput
  }
  enum WindowRequest {
    /** Window switch position: two detents per direction, the second is one-touch. */
    neutral, manualUp, autoUp, manualDown, autoDown
  }
  enum LockRequest { none, lock, unlock }
  enum LockState { unlocked, locked }
  enum LatchState {
    /** Rotary latch position from the primary and secondary latch switches. */
    open, secondary, primary
  }
  enum MotorDirection { stop, up, down }
  enum LockDrive {
    /** Lock actuator H-bridge state: the actuator is driven by timed pulses. */
    idle, lockPulse, unlockPulse
  }
  enum MirrorRequest { none, left, right, up, down }
  enum MirrorSide { driver, passenger }
  enum FoldRequest { none, fold, unfold }
  enum FaultId {
    /** Diagnostic events monitored by the door control unit. */
    motorOvercurrent, hallSensor, lockActuator, supplyUndervoltage, linNoResponse, canTimeout
  }
  enum SupervisedEntity {
    /** Supervised entities of the watchdog manager's alive supervision: the periodic main functions. */
    linInterface, latchMonitor, supplyMonitor, communication
  }
  datatype SwitchFrame {
    /** Switch states carried in the LIN response of the driver's switch panel (12 bits). */
    window: WindowRequest;
    lock: LockRequest;
    mirror: MirrorRequest;
    side: MirrorSide;
    fold: FoldRequest;
    mirrorHeat: bool;
  }
  datatype LinResponse {
    /** One LIN frame response, 3 data bytes: switch states, alive counter and checksum result. */
    switches: SwitchFrame;
    alive: uint /** Rolling 0..255 counter incremented by the slave for every response. */;
    valid: bool /** False when the checksum was invalid. */;
  }
  datatype VehicleStatusPdu {
    /** CAN frame VehicleStatus, sent by the body control module every 100 ms. */
    speedKph: real;
    ignitionOn: bool;
    rolling: uint /** Alive counter 0..15, incremented by the sender for every frame. */;
  }
  datatype VehicleSignals {
    /** Received vehicle signals after alive-counter check, deadline monitoring and substitution. */
    speedKph: real;
    speedValid: bool;
    ignitionOn: bool;
  }
  datatype DoorStatusPdu {
    /** CAN frame DoorStatusFL, sent by the door control unit every 100 ms. */
    ajar: bool;
    locked: bool;
    windowCounts: uint;
    pinchActive: bool;
    powerMode: PowerMode;
    alive: uint;
  }
  datatype MotorCommand {
    /** Window lifter H-bridge command: direction and PWM duty cycle. */
    direction: MotorDirection;
    dutyPercent: uint;
  }
  datatype MirrorDrive {
    /** Mirror glass motors: -1, 0 or +1 for the horizontal and vertical axes. */
    horizontal: int;
    vertical: int;
  }
  datatype PinInputs {
    /** Electrical inputs at the ECU connector after the ADC, ICU and DIO drivers. */
    hallCount: uint /** Quadrature Hall pulse counter of the window motor; 0 is fully closed. */;
    currentRaw: uint /** 12-bit ADC value of the window motor shunt, 10 mA per bit. */;
    supplyRaw: uint /** 12-bit ADC value of the supply divider, 5 mV per bit. */;
    latchPrimary: bool;
    latchSecondary: bool;
    lockSwitchLocked: bool;
    foldEndStop: bool;
  }
  datatype LatchSample {
    primary: bool;
    secondary: bool;
  }
  datatype WindowFeedback {
    /** Converted window motor feedback for one conversion (every 10 ms while the motor runs). */
    positionCounts: uint;
    currentMa: uint;
    supplyMv: uint;
  }
  datatype WindowStatus {
    positionCounts: uint;
    pinchActive: bool;
    learned: bool;
  }
  datatype WindowCalibration {
    /** NVRAM block WindowCalibration: learned stops and anti-pinch parameters. */
    closedCounts: uint;
    openCounts: uint;
    softStopCounts: uint;
    pinchZoneCounts: uint;
    pinchDeltaMa: uint;
    learned: bool;
  }
  datatype DtcStatus {
    /** Status of one diagnostic trouble code, in the style of a UDS status byte. */
    testFailed: bool;
    testFailedThisCycle: bool;
    pending: bool;
    confirmed: bool;
    occurrences: uint;
  }
  datatype FunctionPermission {
    /** Function inhibition derived from the fault memory. */
    windowMotion: bool;
    oneTouch: bool;
  }
  operation def pickInt(condition: bool, whenTrue: int, otherwise: int) returns int {
    if (condition) {
      return whenTrue;
    }
    return otherwise;
  }
  operation def pickStatus(condition: bool, whenTrue: DtcStatus, otherwise: DtcStatus) returns DtcStatus {
    if (condition) {
      return whenTrue;
    }
    return otherwise;
  }
  operation def clampInt(value: int, low: int, high: int) returns int {
    if (value < low) {
      return low;
    }
    if (value > high) {
      return high;
    }
    return value;
  }
}
package DoorEcu::Interfaces {
  /** Port interfaces and communication policies. Each port definition is written from its provider's side. */
  import Swaml::Qos;
  import DoorEcu::Types;
  qos def BodyCanFrames: Policy {
    /**
     * Body CAN: event-triggered frames are queued and retransmitted until acknowledged;
     * cyclic frames are attributes and always keep only their latest value.
     */
    delivery = Delivery.atLeastOnce;
    ordering = Ordering.fifo;
    capacity = 8;
    overflow = Overflow.reject;
    requestTimeout = 1s;
    maxLatency = 5ms;
  }
  qos def LinSlot: Policy {
    /**
     * One LIN schedule-table slot at 19.2 kbit/s: header plus a 3-byte response is 74 bit
     * times (3.9 ms) nominal and at most 5.4 ms with the 40 % frame tolerance, inside the
     * 20 ms slot. A header or response is never queued behind another.
     */
    delivery = Delivery.atMostOnce;
    ordering = Ordering.fifo;
    capacity = 1;
    overflow = Overflow.dropOldest;
    requestTimeout = 6ms;
    maxLatency = 6ms;
  }
  qos def UdsSession: Policy {
    /** Diagnostic requests: the server answers within its 50 ms response time. */
    delivery = Delivery.atMostOnce;
    ordering = Ordering.fifo;
    capacity = 4;
    overflow = Overflow.reject;
    requestTimeout = 50ms;
  }
  qos def RteQueued: Policy {
    /** Intra-core queued events with a short queue that never loses an event silently. */
    delivery = Delivery.atLeastOnce;
    ordering = Ordering.fifo;
    capacity = 8;
    overflow = Overflow.reject;
    requestTimeout = 10ms;
  }
  qos def CrossCore: Policy {
    /** Inter-core queued events through the inter-OS-application communicator, delivered within 1 ms. */
    delivery = Delivery.atLeastOnce;
    ordering = Ordering.fifo;
    capacity = 8;
    overflow = Overflow.reject;
    requestTimeout = 10ms;
    maxLatency = 1ms;
  }
  // ECU connector and environment
  port def EcuInputs {
    /** Sensor side of the ECU connector, provided by the door hardware. */
    provides attribute inputs: PinInputs;
  }
  port def EcuOutputs {
    /** Power stages of the ECU connector, provided by the I/O hardware abstraction. */
    provides attribute windowBridge: MotorCommand;
    provides attribute lockMotor: LockDrive;
    provides attribute mirrorMotors: MirrorDrive;
    provides attribute foldMotor: FoldRequest;
    provides attribute mirrorHeaterPercent: uint;
    provides attribute puddleLampPercent: uint;
    provides attribute courtesyLampPercent: uint;
  }
  port def WatchdogLine {
    /** Trigger line and mode pin of the external window watchdog in the system basis chip. */
    provides attribute trigger: bool;
    provides attribute lowPower: bool;
  }
  port def SwitchContacts {
    /** Switch contacts of the driver's door switch panel, operated by the driver. */
    provides attribute window: WindowRequest;
    provides attribute lock: LockRequest;
    provides attribute mirror: MirrorRequest;
    provides attribute side: MirrorSide;
    provides attribute fold: FoldRequest;
    provides attribute mirrorHeat: bool;
  }
  port def LinBus {
    /** LIN slave side: the switch panel answers each frame header of the master with its response. */
    requires event header();
    provides event response(frame: LinResponse);
  }
  port def LinWakeLine {
    /** LIN wake-up pulse, seen by the door module's transceiver as a wake-capable input. */
    provides event wakeup();
  }
  port def PassengerInteraction {
    /** Physical interaction of an occupant with the door. */
    provides attribute handInWindow: bool;
    provides attribute innerHandle: bool;
  }
  port def SupplyTerminal {
    /** Battery voltage at the door module supply pin (terminal 30). */
    provides attribute batteryMv: uint;
  }
  port def BodyCan {
    /** Body CAN, provided from the body control module's side. */
    provides attribute vehicleStatus: VehicleStatusPdu;
    provides event crash(severity: uint);
    provides event centralLock(request: LockRequest);
    provides event comfortClose();
    requires attribute doorStatus: DoorStatusPdu;
    requires event lockStatus(reported: LockState);
    requires event remoteMirror(direction: MirrorRequest);
  }
  port def Diagnostics {
    /** Diagnostic services offered to an off-board tester. */
    provides operation readDtcStatus(dtc: uint) returns DtcStatus;
    provides operation clearDtcs() returns uint;
    provides operation readData(did: uint) returns uint;
  }
  // RTE-like interfaces between software components
  port def WindowFeedbackPort { provides attribute feedback: WindowFeedback; }
  port def SupplyVoltage { provides attribute supplyMv: uint; }
  port def LatchInputs { provides attribute latchSample: LatchSample; }
  port def LockFeedback { provides attribute lockSwitchLocked: bool; }
  port def MirrorFeedback { provides event foldEndStop(); }
  port def BridgeTrip { provides event tripped(); }
  port def WakeIndication { provides event request(source: WakeSource); }
  port def BusActivity { provides event frameReceived(); }
  port def ModeBroadcast { provides event changed(powerMode: PowerMode); }
  port def SwitchFrames { provides event frame(switches: SwitchFrame); }
  port def WindowRequests { provides event request(command: WindowRequest); }
  port def LockRequests { provides event request(command: LockRequest); }
  port def MirrorRequests {
    provides event adjust(direction: MirrorRequest);
    provides event fold(command: FoldRequest);
  }
  port def HeaterRequest { provides event heat(enabled: bool); }
  port def RemoteMirror { provides event adjust(direction: MirrorRequest); }
  port def RxPdu { provides attribute vehicleStatus: VehicleStatusPdu; }
  port def TxPdu { provides attribute doorStatus: DoorStatusPdu; }
  port def VehicleSignalsPort { provides attribute signals: VehicleSignals; }
  port def CrashPort { provides event crashUnlock(); }
  port def LockStatus { provides event changed(current: LockState); }
  port def DoorState { provides attribute ajar: bool; }
  port def WindowSupervision {
    /** Anti-pinch and position supervision results for the window lifter state machine. */
    provides event pinchDetected();
    provides event reversalComplete();
    provides event endPosition(closed: bool);
    provides event sensorFault();
  }
  port def WindowStatusPort { provides attribute windowStatus: WindowStatus; }
  port def WindowMotorPort { provides attribute windowMotor: MotorCommand; }
  port def LockMotorPort { provides attribute lockMotor: LockDrive; }
  port def MirrorMotorPort {
    provides attribute mirrorMotors: MirrorDrive;
    provides attribute foldMotor: FoldRequest;
  }
  port def HeaterPort { provides attribute heaterPercent: uint; }
  port def LampRequest { provides attribute lampOn: bool; }
  port def LampPwm { provides attribute dutyPercent: uint; }
  port def PermissionPort {
    /** Function inhibition: the current permission and an event when window motion is withdrawn. */
    provides attribute permission: FunctionPermission;
    provides event motionInhibited();
  }
  port def DiagEvents {
    /** Monitor results reported to the diagnostic event manager (pre-failed or pre-passed). */
    provides event report(fault: FaultId, failed: bool);
  }
  port def DtcAccess {
    provides idempotent operation readStatus(fault: FaultId) returns DtcStatus;
    provides operation clearAll() returns uint;
  }
  port def CalibrationBlock {
    /** NVRAM block access: the manager provides the RAM mirror and accepts write requests. */
    provides attribute windowCalibration: WindowCalibration;
    requires event store(block: WindowCalibration);
  }
  port def NvmJobs {
    /** Asynchronous NVRAM jobs: write-all and its cancellation are requested, completion is reported. */
    requires event writeAll();
    requires event cancelWriteAll();
    provides event writeAllDone(ok: bool);
  }
  port def AliveSupervision { provides event checkpoint(entity: SupervisedEntity); }
}
package DoorEcu::Requirements {
  /** Stakeholder and system requirements of the front-left door control unit. */
  requirement 'Anti-pinch protection' {
    /**
     * During a one-touch close in the pinch zone the window reverses before the clamping
     * force reaches the limit and then opens by the reversal distance (illustrative value
     * of the order used by power-window regulations). Detection is re-armed for every
     * close, including after a reversal that could not complete.
     */
    attribute maxForceN: real = 100.0;
    attribute pinchZoneMm: uint = 200;
    attribute reversalMm: uint = 125;
  }
  requirement 'One-touch close' {
    /** A one-touch request closes the window completely without holding the switch. */
    attribute maxTravelS: uint = 5;
  }
  requirement 'Central locking' {
    /** Lock and unlock requests from the switch panel or the key fob complete within 400 ms. */
    attribute responseMs: uint = 400;
  }
  requirement 'Lock actuator supervision' {
    /** A lock pulse that does not reach the locked position is a pre-failed lock actuator report. */
    attribute pulseMs: uint = 250;
  }
  requirement 'Speed-dependent auto-lock' {
    /** The doors lock once per ignition cycle when the speed exceeds the threshold. */
    attribute speedKph: real = 15.0;
  }
  requirement 'Crash unlock' {
    /** A crash signal unlocks the door within 10 ms and inhibits auto-lock afterwards. */
    attribute latencyMs: uint = 10;
  }
  requirement 'Bus timeout substitution' {
    /**
     * VehicleStatus frames with a repeated alive counter are ignored; missing valid frames
     * are detected 500 ms after the last valid one (20 ms resolution) and the speed is
     * substituted as invalid.
     */
    attribute timeoutMs: uint = 500;
  }
  requirement 'Network-managed sleep' {
    /**
     * After ignition off the ECU keeps its own network request for the post-run time, then
     * stays awake while the body CAN is active and goes to sleep only after the bus has been
     * silent for the NM timeout, writing NVRAM first. It wakes on CAN, LIN or the door handle.
     */
    attribute postRunMs: uint = 1000;
    attribute nmTimeoutMs: uint = 500;
  }
  requirement 'Fault memory' {
    /**
     * Faults are debounced and confirmed after two pre-failed reports, stored as trouble
     * codes and readable and clearable by a tester. Simplified: pending and confirmed are
     * set together, with no operation cycles and no aging.
     */
    attribute confirmationReports: uint = 2;
  }
  requirement 'Supply voltage protection' {
    /**
     * Below 9 V the window does not start and a moving window stops; a pinch reversal is
     * completed. An undervoltage is recorded and recovers only above 9.5 V.
     */
    attribute undervoltageMv: uint = 9000;
    attribute recoveryMv: uint = 9500;
  }
  requirement 'Window motor protection' {
    /** The window H-bridge is switched off at 30 A; a Hall signal without pulses stops the motor and disables one-touch. */
    attribute tripMa: uint = 30000;
  }
  requirement 'Input debouncing' {
    /** Switch panel states are accepted after two identical LIN frames, latch switches after three 20 ms samples. */
    attribute switchFrames: uint = 2;
    attribute latchSamples: uint = 3;
  }
  requirement 'Switch panel communication' {
    /** After five missing LIN responses the switches are treated as neutral; after three a fault is reported. */
    attribute substituteSlots: uint = 5;
  }
  requirement 'Watchdog supervision' {
    /**
     * Supervised software entities report alive; the external watchdog is triggered only
     * while every entity is correct. A failed supervision window stops triggering, so the
     * external watchdog expires.
     */
    attribute windowMs: uint = 200;
  }
  requirement 'Mirror auto-fold' {
    /** Locking folds this door's mirror, unlocking unfolds it; the fold motor stops at its end stop or after 1.5 s. */
    attribute maxFoldMs: uint = 1500;
  }
}
package DoorEcu {
  /**
   * Front-left door control unit (DCU) of a passenger car body domain: software
   * composition, environment and test bench. Top-level occurrences: the DCU software,
   * the LIN switch panel, the door mechanics plant model, the external watchdog, the
   * vehicle platform, and the interface-only actors driver, passenger, body control
   * module, diagnostic tester and power supply.
   *
   * Task mapping and what swa.ml 2.2 cannot express: an OS task is a Process node with a
   * period or response bound and a priority, and each component occurrence is placed on
   * exactly one task. Components are split so that the runnables carrying deadlines of
   * one occurrence belong to that task: interrupt-like receive sides (CAN, ADC), periodic
   * main functions and event tasks are separate occurrences. A receive entry that only
   * copies a value into an attribute stands for the RTE's implicit buffer update in the
   * sender's context; swa.ml has no non-activating read of a required attribute. The
   * language places occurrences, not individual runnables; task priority, preemption,
   * category and core binding are recorded as constant attributes without effect; the
   * reference run executes in logical zero time and does not simulate placement, so
   * deadlines and route latencies are declared budgets, checked only as logical evidence.
   * This model will be revisited with the planned language revision.
   */
  import Swaml::Views;
  import Swaml::Platform;
  import Swaml::Math;
  import DoorEcu::Types;
  import DoorEcu::Interfaces;
  import DoorEcu::Requirements;

  // ---------------------------------------------------------------- basic software

  component def IoHwAbInput {
    /**
     * I/O hardware abstraction, input side, in the ADC conversion-complete interrupt: the
     * ADC/ICU/DIO group is converted whenever the door hardware changes. Converts raw
     * counts to engineering units, switches the window H-bridge off at the trip current,
     * reports wake-capable edges (latch, LIN wake pulse) and distributes the values.
     */
    reversed port pins: EcuInputs;
    reversed port linWake: LinWakeLine;
    reversed port modeIn: ModeBroadcast;
    port window: WindowFeedbackPort;
    port supply: SupplyVoltage;
    port latch: LatchInputs;
    port lockSense: LockFeedback;
    port mirrorSense: MirrorFeedback;
    port trip: BridgeTrip;
    port wake: WakeIndication;
    port diag: DiagEvents;
    const attribute currentMaPerBit: uint = 10;
    const attribute supplyMvPerBit: uint = 5;
    const attribute bridgeTripMa: uint = 30000 /** H-bridge overcurrent trip, below the 32 A stall current. */;
    const attribute supplyHysteresisMv: uint = 100;
    attribute raw: PinInputs = record PinInputs {
      hallCount = 250;
      currentRaw = 0;
      supplyRaw = 2700;
      latchPrimary = true;
      latchSecondary = true;
      lockSwitchLocked = false;
      foldEndStop = false;
    };
    attribute currentMa: uint = 0;
    attribute supplyMv: uint = 13500;
    attribute reportedSupplyMv: uint = 0;
    attribute reportedLatch: LatchSample = record LatchSample { primary = true; secondary = true; };
    attribute reportedLockSwitch: bool = false;
    attribute lastFoldEndStop: bool = false;
    attribute lastFeedbackCounts: uint = 250;
    attribute sleeping: bool = false;
    attribute trips: uint = 0;
    operation acquire(sample: PinInputs) {
      /** Conversion complete: convert, trip the bridge at overcurrent, report a latch edge as local activity or wake-up. */
      if (sample.latchPrimary != raw.latchPrimary) {
        sleeping = false;
        publish wake.request(WakeSource.localInput);
      }
      raw = sample;
      currentMa = sample.currentRaw * currentMaPerBit;
      supplyMv = sample.supplyRaw * supplyMvPerBit;
      if (currentMa >= bridgeTripMa) {
        trips = trips + 1;
        publish trip.tripped();
        publish diag.report(FaultId.motorOvercurrent, true);
      }
    }
    operation distribute() {
      /** After acquire: window feedback while the motor draws current or moves, slow signals on change only. */
      if (currentMa > 0 or raw.hallCount != lastFeedbackCounts) {
        lastFeedbackCounts = raw.hallCount;
        send window.feedback(record WindowFeedback { positionCounts = raw.hallCount; currentMa = currentMa; supplyMv = supplyMv; });
      }
      if (supplyMv + supplyHysteresisMv <= reportedSupplyMv or supplyMv >= reportedSupplyMv + supplyHysteresisMv) {
        reportedSupplyMv = supplyMv;
        send supply.supplyMv(supplyMv);
      }
      var latchNow: LatchSample = record LatchSample { primary = raw.latchPrimary; secondary = raw.latchSecondary; };
      if (latchNow != reportedLatch) {
        reportedLatch = latchNow;
        send latch.latchSample(latchNow);
      }
      if (raw.lockSwitchLocked != reportedLockSwitch) {
        reportedLockSwitch = raw.lockSwitchLocked;
        send lockSense.lockSwitchLocked(reportedLockSwitch);
      }
      if (raw.foldEndStop and not lastFoldEndStop) {
        publish mirrorSense.foldEndStop();
      }
      lastFoldEndStop = raw.foldEndStop;
    }
    operation onLinWake() {
      if (sleeping) {
        sleeping = false;
        publish wake.request(WakeSource.lin);
      }
    }
    operation onMode(current: PowerMode) {
      sleeping = current == PowerMode.sleep;
    }
    schedule {
      on receive pins.inputs(sample) acquire(sample) deadline 1ms;
      after acquire distribute() deadline 2ms;
      on receive linWake.wakeup() onLinWake() deadline 1ms;
      on receive modeIn.changed(current) onMode(current);
    }
  }

  component def IoHwAbOutput {
    /**
     * I/O hardware abstraction, output side: drives the power stages on request, keeps the
     * window H-bridge off after a trip until the next stop command and switches every
     * output off in sleep.
     */
    port outputs: EcuOutputs;
    reversed port windowDrive: WindowMotorPort;
    reversed port lockDrive: LockMotorPort;
    reversed port mirrorDrive: MirrorMotorPort;
    reversed port heaterDrive: HeaterPort;
    reversed port puddleLamp: LampPwm;
    reversed port courtesyLamp: LampPwm;
    reversed port trip: BridgeTrip;
    reversed port modeIn: ModeBroadcast;
    attribute bridge: MotorCommand = record MotorCommand { direction = MotorDirection.stop; dutyPercent = 0; };
    attribute bridgeTripped: bool = false;
    attribute sleeping: bool = false;
    operation stopBridge() {
      send outputs.windowBridge(record MotorCommand { direction = MotorDirection.stop; dutyPercent = 0; });
    }
    operation driveWindow(command: MotorCommand) {
      bridge = command;
      if (command.direction == MotorDirection.stop) {
        bridgeTripped = false;
      }
      if (bridgeTripped or sleeping) {
        return;
      }
      send outputs.windowBridge(command);
    }
    operation onTrip() {
      if (not bridgeTripped) {
        bridgeTripped = true;
        stopBridge();
      }
    }
    operation driveLock(drive: LockDrive) {
      if (not sleeping) {
        send outputs.lockMotor(drive);
      }
    }
    operation driveMirror(drive: MirrorDrive) {
      send outputs.mirrorMotors(drive);
    }
    operation driveFold(command: FoldRequest) {
      send outputs.foldMotor(command);
    }
    operation driveHeater(percent: uint) {
      send outputs.mirrorHeaterPercent(percent);
    }
    operation drivePuddle(percent: uint) {
      send outputs.puddleLampPercent(percent);
    }
    operation driveCourtesy(percent: uint) {
      send outputs.courtesyLampPercent(percent);
    }
    operation onMode(current: PowerMode) {
      sleeping = current == PowerMode.sleep;
      if (sleeping) {
        stopBridge();
        send outputs.lockMotor(LockDrive.idle);
        send outputs.mirrorHeaterPercent(0);
        send outputs.puddleLampPercent(0);
        send outputs.courtesyLampPercent(0);
      }
    }
    schedule {
      on receive windowDrive.windowMotor(command) driveWindow(command) deadline 1ms;
      on receive trip.tripped() onTrip() deadline 1ms;
      on receive lockDrive.lockMotor(drive) driveLock(drive) deadline 1ms;
      on receive mirrorDrive.mirrorMotors(drive) driveMirror(drive) deadline 5ms;
      on receive mirrorDrive.foldMotor(command) driveFold(command) deadline 5ms;
      on receive heaterDrive.heaterPercent(percent) driveHeater(percent) deadline 5ms;
      on receive puddleLamp.dutyPercent(percent) drivePuddle(percent) deadline 5ms;
      on receive courtesyLamp.dutyPercent(percent) driveCourtesy(percent) deadline 5ms;
      on receive modeIn.changed(current) onMode(current) deadline 5ms;
    }
  }

  component def CanInterface {
    /**
     * CAN interface in the CAN receive interrupt (CanIf/PduR-like): Rx indications of
     * VehicleStatus (handed to the Com main function), immediate routing of the crash,
     * central-lock and comfort-close event frames, transmit requests, bus-activity
     * indications for network management and the CAN wake-up while asleep.
     */
    reversed port can: BodyCan;
    port rx: RxPdu;
    port crash: CrashPort;
    port lockRequests: LockRequests;
    port windowRequests: WindowRequests;
    port wake: WakeIndication;
    port nm: BusActivity;
    reversed port tx: TxPdu;
    reversed port lockStatus: LockStatus;
    reversed port remoteMirror: RemoteMirror;
    reversed port modeIn: ModeBroadcast;
    const attribute crashSeverityThreshold: uint = 1;
    attribute sleeping: bool = false;
    attribute wakeRequested: bool = false;
    attribute frames: uint = 0;
    operation indication() {
      /** Every received frame is bus activity; the first one while asleep is a CAN wake-up. */
      frames = frames + 1;
      publish nm.frameReceived();
      if (sleeping and not wakeRequested) {
        wakeRequested = true;
        publish wake.request(WakeSource.can);
      }
    }
    operation rxVehicleStatus(pdu: VehicleStatusPdu) {
      indication();
      send rx.vehicleStatus(pdu);
    }
    operation rxCrash(severity: uint) {
      if (severity >= crashSeverityThreshold) {
        publish crash.crashUnlock();
      }
      indication();
    }
    operation rxCentralLock(request: LockRequest) {
      indication();
      publish lockRequests.request(request);
    }
    operation rxComfortClose() {
      indication();
      publish windowRequests.request(WindowRequest.autoUp);
    }
    operation txDoorStatus(pdu: DoorStatusPdu) {
      send can.doorStatus(pdu);
    }
    operation txLockStatus(current: LockState) {
      publish can.lockStatus(current);
    }
    operation txRemoteMirror(direction: MirrorRequest) {
      publish can.remoteMirror(direction);
    }
    operation onMode(current: PowerMode) {
      sleeping = current == PowerMode.sleep;
      wakeRequested = false;
    }
    schedule {
      on receive can.vehicleStatus(pdu) rxVehicleStatus(pdu) deadline 2ms;
      on receive can.crash(severity) rxCrash(severity) deadline 1ms;
      on receive can.centralLock(request) rxCentralLock(request) deadline 2ms;
      on receive can.comfortClose() rxComfortClose() deadline 2ms;
      on receive tx.doorStatus(pdu) txDoorStatus(pdu) deadline 2ms;
      on receive lockStatus.changed(current) txLockStatus(current) deadline 2ms;
      on receive remoteMirror.adjust(direction) txRemoteMirror(direction) deadline 2ms;
      on receive modeIn.changed(current) onMode(current);
    }
  }

  component def ComMain {
    /**
     * Com main functions every 20 ms: VehicleStatus alive-counter check, deadline
     * monitoring and substitution (active only while the network is requested, in run),
     * signal routing, and the cyclic DoorStatusFL transmission every 100 ms.
     */
    reversed port rx: RxPdu;
    port vehicle: VehicleSignalsPort;
    port tx: TxPdu;
    port diag: DiagEvents;
    port alive: AliveSupervision;
    reversed port lockStatus: LockStatus;
    reversed port door: DoorState;
    reversed port window: WindowStatusPort;
    reversed port modeIn: ModeBroadcast;
    const attribute rxTimeoutMs: uint = 500;
    const attribute txPeriodMs: uint = 100;
    attribute pending: VehicleStatusPdu = record VehicleStatusPdu { speedKph = 0.0; ignitionOn = false; rolling = 0; };
    attribute fresh: bool = false;
    attribute lastRolling: uint = 16;
    attribute aliveErrors: uint = 0;
    attribute rxSeen: bool = false;
    attribute rxAgeMs: uint = 0;
    attribute timedOut: bool = false;
    attribute timeouts: uint = 0;
    attribute lastSignals: VehicleSignals = record VehicleSignals { speedKph = 0.0; speedValid = false; ignitionOn = false; };
    attribute txTimerMs: uint = 0;
    attribute txAlive: uint = 0;
    attribute framesSent: uint = 0;
    attribute doorAjar: bool = false;
    attribute locked: bool = false;
    attribute windowState: WindowStatus = record WindowStatus { positionCounts = 250; pinchActive = false; learned = false; };
    attribute powerMode: PowerMode = PowerMode.startup;
    operation networkActive() returns bool {
      return powerMode == PowerMode.run;
    }
    operation storePdu(pdu: VehicleStatusPdu) {
      pending = pdu;
      fresh = true;
    }
    operation storeLock(current: LockState) {
      locked = current == LockState.locked;
    }
    operation storeAjar(ajar: bool) {
      doorAjar = ajar;
    }
    operation storeWindow(status: WindowStatus) {
      windowState = status;
    }
    operation onMode(current: PowerMode) {
      powerMode = current;
      if (current != PowerMode.run) {
        rxAgeMs = 0;
      }
    }
    operation rxMainFunction() {
      /** 20 ms: accept a frame with a new alive counter, otherwise age the reception and substitute after the timeout. */
      if (fresh) {
        fresh = false;
        if (pending.rolling != lastRolling) {
          lastRolling = pending.rolling;
          rxSeen = true;
          rxAgeMs = 0;
          timedOut = false;
          lastSignals = record VehicleSignals { speedKph = pending.speedKph; speedValid = true; ignitionOn = pending.ignitionOn; };
          send vehicle.signals(lastSignals);
          return;
        }
        aliveErrors = aliveErrors + 1;
      }
      if (not rxSeen or not networkActive() or timedOut) {
        return;
      }
      rxAgeMs = rxAgeMs + 20;
      if (rxAgeMs >= rxTimeoutMs) {
        timedOut = true;
        timeouts = timeouts + 1;
        lastSignals = record VehicleSignals { speedKph = 0.0; speedValid = false; ignitionOn = lastSignals.ignitionOn; };
        send vehicle.signals(lastSignals);
      }
    }
    operation txMainFunction() {
      /** 20 ms: cyclic transmission of DoorStatusFL every 100 ms while awake. */
      if (powerMode == PowerMode.sleep) {
        return;
      }
      txTimerMs = txTimerMs + 20;
      if (txTimerMs >= txPeriodMs) {
        txTimerMs = 0;
        txAlive = (txAlive + 1) % 16;
        framesSent = framesSent + 1;
        send tx.doorStatus(record DoorStatusPdu {
          ajar = doorAjar;
          locked = locked;
          windowCounts = windowState.positionCounts;
          pinchActive = windowState.pinchActive;
          powerMode = powerMode;
          alive = txAlive;
        });
      }
    }
    operation reportDiagnostics() {
      /** 100 ms: VehicleStatus timeout monitor and the alive checkpoint. */
      if (rxSeen and networkActive()) {
        publish diag.report(FaultId.canTimeout, timedOut);
      }
      publish alive.checkpoint(SupervisedEntity.communication);
    }
    schedule {
      on receive rx.vehicleStatus(pdu) storePdu(pdu);
      on receive lockStatus.changed(current) storeLock(current);
      on receive door.ajar(ajar) storeAjar(ajar);
      on receive window.windowStatus(status) storeWindow(status);
      on receive modeIn.changed(current) onMode(current);
      on every 20ms rxMainFunction() deadline 2ms;
      after rxMainFunction txMainFunction() deadline 5ms;
      on every 100ms reportDiagnostics() deadline 10ms;
    }
  }

  component def LinMaster {
    /**
     * LIN master (LinIf-like) with a 20 ms schedule table holding one unconditional frame:
     * each slot evaluates the response received in the previous slot and sends the next
     * header. A missing response or a stale alive counter counts as missed; from the fifth
     * missed slot on the switches are substituted as neutral in every slot.
     */
    reversed port bus: LinBus;
    port frames: SwitchFrames;
    port diag: DiagEvents;
    port alive: AliveSupervision;
    reversed port modeIn: ModeBroadcast;
    const attribute substituteAfter: uint = 5;
    const attribute faultAfter: uint = 3;
    attribute response: LinResponse = record LinResponse {
      switches = record SwitchFrame {
        window = WindowRequest.neutral;
        lock = LockRequest.none;
        mirror = MirrorRequest.none;
        side = MirrorSide.driver;
        fold = FoldRequest.none;
        mirrorHeat = false;
      };
      alive = 256;
      valid = false;
    };
    attribute received: bool = false;
    attribute lastAlive: uint = 256;
    attribute missed: uint = 0;
    attribute polls: uint = 0;
    attribute sleeping: bool = false;
    operation storeResponse(frame: LinResponse) {
      response = frame;
      received = true;
    }
    operation missSlot() {
      missed = missed + 1;
      if (missed >= substituteAfter) {
        publish frames.frame(record SwitchFrame {
          window = WindowRequest.neutral;
          lock = LockRequest.none;
          mirror = MirrorRequest.none;
          side = MirrorSide.driver;
          fold = FoldRequest.none;
          mirrorHeat = false;
        });
      }
    }
    operation slot() {
      /** 20 ms schedule-table slot; no headers while asleep. */
      if (sleeping) {
        return;
      }
      if (polls > 0) {
        if (received and response.valid and response.alive != lastAlive) {
          missed = 0;
          lastAlive = response.alive;
          publish frames.frame(response.switches);
        } else {
          missSlot();
        }
      }
      received = false;
      polls = polls + 1;
      if (polls % 5 == 0) {
        publish alive.checkpoint(SupervisedEntity.linInterface);
      }
      publish bus.header();
    }
    operation onMode(current: PowerMode) {
      sleeping = current == PowerMode.sleep;
      if (sleeping) {
        polls = 0;
      }
    }
    operation reportDiagnostics() {
      if (not sleeping) {
        publish diag.report(FaultId.linNoResponse, missed >= faultAfter);
      }
    }
    schedule {
      on receive bus.response(frame) storeResponse(frame);
      on receive modeIn.changed(current) onMode(current);
      on every 20ms slot() deadline 2ms;
      on every 100ms reportDiagnostics() deadline 10ms;
    }
  }

  component def Dem {
    /**
     * Diagnostic event manager: counter-based debouncing of monitor reports (jump to zero,
     * +64 per pre-failed and -32 per pre-passed report, failed at 127), trouble-code status
     * per fault and function inhibition derived from the fault memory. Simplified: a fault
     * becomes pending and confirmed together; there are no operation cycles and no aging.
     */
    reversed port events: DiagEvents;
    port access: DtcAccess;
    port fim: PermissionPort;
    const attribute stepUp: int = 64;
    const attribute stepDown: int = 32;
    const attribute failedThreshold: int = 127;
    const attribute passedThreshold: int = -128;
    attribute counters: int[6] = [0, 0, 0, 0, 0, 0];
    attribute statuses: DtcStatus[6] = [
      record DtcStatus { testFailed = false; testFailedThisCycle = false; pending = false; confirmed = false; occurrences = 0; },
      record DtcStatus { testFailed = false; testFailedThisCycle = false; pending = false; confirmed = false; occurrences = 0; },
      record DtcStatus { testFailed = false; testFailedThisCycle = false; pending = false; confirmed = false; occurrences = 0; },
      record DtcStatus { testFailed = false; testFailedThisCycle = false; pending = false; confirmed = false; occurrences = 0; },
      record DtcStatus { testFailed = false; testFailedThisCycle = false; pending = false; confirmed = false; occurrences = 0; },
      record DtcStatus { testFailed = false; testFailedThisCycle = false; pending = false; confirmed = false; occurrences = 0; }
    ];
    attribute permission: FunctionPermission = record FunctionPermission { windowMotion = true; oneTouch = true; };
    attribute reports: uint = 0;
    operation indexOf(fault: FaultId) returns uint {
      if (fault == FaultId.motorOvercurrent) {
        return 0;
      }
      if (fault == FaultId.hallSensor) {
        return 1;
      }
      if (fault == FaultId.lockActuator) {
        return 2;
      }
      if (fault == FaultId.supplyUndervoltage) {
        return 3;
      }
      if (fault == FaultId.linNoResponse) {
        return 4;
      }
      return 5;
    }
    operation withCounter(index: uint, value: int) {
      counters = [
        pickInt(index == 0, value, counters[0]),
        pickInt(index == 1, value, counters[1]),
        pickInt(index == 2, value, counters[2]),
        pickInt(index == 3, value, counters[3]),
        pickInt(index == 4, value, counters[4]),
        pickInt(index == 5, value, counters[5])
      ];
    }
    operation withStatus(index: uint, value: DtcStatus) {
      statuses = [
        pickStatus(index == 0, value, statuses[0]),
        pickStatus(index == 1, value, statuses[1]),
        pickStatus(index == 2, value, statuses[2]),
        pickStatus(index == 3, value, statuses[3]),
        pickStatus(index == 4, value, statuses[4]),
        pickStatus(index == 5, value, statuses[5])
      ];
    }
    operation derivePermission() {
      /** Undervoltage or a confirmed overcurrent stops window motion; a confirmed Hall fault disables one-touch. */
      var overcurrent: DtcStatus = statuses[0];
      var hall: DtcStatus = statuses[1];
      var supply: DtcStatus = statuses[3];
      var next: FunctionPermission = record FunctionPermission {
        windowMotion = not supply.testFailed and not overcurrent.confirmed;
        oneTouch = not hall.confirmed;
      };
      if (next != permission) {
        var withdrawn: bool = permission.windowMotion and not next.windowMotion;
        permission = next;
        send fim.permission(next);
        if (withdrawn) {
          publish fim.motionInhibited();
        }
      }
    }
    operation publishPermission() {
      send fim.permission(permission);
    }
    operation report(fault: FaultId, failed: bool) {
      reports = reports + 1;
      var index: uint = indexOf(fault);
      var previous: int = counters[index];
      var counter: int = 0;
      if (failed) {
        counter = clampInt(pickInt(previous < 0, 0, previous) + stepUp, passedThreshold, failedThreshold);
      } else {
        counter = clampInt(pickInt(previous > 0, 0, previous) - stepDown, passedThreshold, failedThreshold);
      }
      if (counter == previous) {
        return;
      }
      withCounter(index, counter);
      var status: DtcStatus = statuses[index];
      if (counter >= failedThreshold and not status.testFailed) {
        withStatus(index, record DtcStatus {
          testFailed = true;
          testFailedThisCycle = true;
          pending = true;
          confirmed = true;
          occurrences = status.occurrences + 1;
        });
      }
      if (counter <= 0 and status.testFailed) {
        withStatus(index, record DtcStatus {
          testFailed = false;
          testFailedThisCycle = status.testFailedThisCycle;
          pending = status.pending;
          confirmed = status.confirmed;
          occurrences = status.occurrences;
        });
      }
      derivePermission();
    }
    operation readStatus(fault: FaultId) returns DtcStatus {
      var index: uint = indexOf(fault);
      return statuses[index];
    }
    operation clearAll() returns uint {
      /** Clear the fault memory; returns the number of confirmed codes that were cleared. */
      var cleared: uint = 0;
      for (s: DtcStatus in statuses) {
        if (s.confirmed) {
          cleared = cleared + 1;
        }
      }
      var empty: DtcStatus = record DtcStatus { testFailed = false; testFailedThisCycle = false; pending = false; confirmed = false; occurrences = 0; };
      statuses = [empty, empty, empty, empty, empty, empty];
      counters = [0, 0, 0, 0, 0, 0];
      derivePermission();
      return cleared;
    }
    schedule {
      on start publishPermission();
      on receive events.report(fault, failed) report(fault, failed) deadline 2ms;
      on call access.readStatus(fault) readStatus(fault) concurrent;
      on call access.clearAll() clearAll() deadline 10ms;
    }
  }

  component def Dcm {
    /**
     * Diagnostic communication manager: serves ReadDTCInformation-, ClearDiagnosticInformation-
     * and ReadDataByIdentifier-like services, mapping three-byte trouble codes to monitored
     * faults. It runs in its own task and calls the event manager in another task.
     */
    port service: Diagnostics;
    reversed port dem: DtcAccess;
    reversed port supply: SupplyVoltage;
    reversed port window: WindowStatusPort;
    const attribute dtcOvercurrent: uint = 10092569 /** 0x9A0019: window motor current above threshold. */;
    const attribute dtcHall: uint = 10092841 /** 0x9A0129: window Hall signal invalid. */;
    const attribute dtcLockActuator: uint = 10096647 /** 0x9A1007: lock actuator mechanical failure. */;
    const attribute dtcUndervoltage: uint = 10100758 /** 0x9A2016: supply voltage below threshold. */;
    const attribute dtcLin: uint = 12728199 /** 0xC23787: lost communication with the switch panel. */;
    const attribute dtcCan: uint = 12664967 /** 0xC14087: lost communication with the body control module. */;
    const attribute didSupplyMv: uint = 64769 /** 0xFD01 */;
    const attribute didWindowCounts: uint = 64770 /** 0xFD02 */;
    const attribute didLearned: uint = 64771 /** 0xFD03 */;
    attribute supplyMv: uint = 13500;
    attribute windowState: WindowStatus = record WindowStatus { positionCounts = 250; pinchActive = false; learned = false; };
    operation faultOf(dtc: uint) returns FaultId {
      if (dtc == dtcOvercurrent) {
        return FaultId.motorOvercurrent;
      }
      if (dtc == dtcHall) {
        return FaultId.hallSensor;
      }
      if (dtc == dtcLockActuator) {
        return FaultId.lockActuator;
      }
      if (dtc == dtcUndervoltage) {
        return FaultId.supplyUndervoltage;
      }
      if (dtc == dtcLin) {
        return FaultId.linNoResponse;
      }
      if (dtc == dtcCan) {
        return FaultId.canTimeout;
      }
      fail "requestOutOfRange: unsupported trouble code";
    }
    operation readDtcStatus(dtc: uint) returns DtcStatus {
      var fault: FaultId = faultOf(dtc);
      var status: DtcStatus = dem.readStatus(fault);
      return status;
    }
    operation clearDtcs() returns uint {
      var cleared: uint = dem.clearAll();
      return cleared;
    }
    operation readData(did: uint) returns uint {
      if (did == didSupplyMv) {
        return supplyMv;
      }
      if (did == didWindowCounts) {
        return windowState.positionCounts;
      }
      if (did == didLearned) {
        if (windowState.learned) {
          return 1;
        }
        return 0;
      }
      fail "requestOutOfRange: unsupported data identifier";
    }
    operation storeSupply(mv: uint) {
      supplyMv = mv;
    }
    operation storeWindow(status: WindowStatus) {
      windowState = status;
    }
    schedule {
      on call service.readDtcStatus(dtc) readDtcStatus(dtc) deadline 50ms;
      on call service.clearDtcs() clearDtcs() deadline 50ms;
      on call service.readData(did) readData(did) concurrent;
      on receive supply.supplyMv(mv) storeSupply(mv);
      on receive window.windowStatus(status) storeWindow(status);
    }
  }

  component def NvM {
    /**
     * NVRAM manager with one block, WindowCalibration: a read-all at start-up fills the RAM
     * mirror, application writes mark it dirty, and the asynchronous write-all job requested
     * at shutdown stores it in its background task and reports completion. A wake-up during
     * shutdown cancels the job; a cancellation while no job runs is discarded.
     */
    port calibration: CalibrationBlock;
    port control: NvmJobs;
    attribute nvBlock: WindowCalibration = record WindowCalibration {
      closedCounts = 0;
      openCounts = 1000;
      softStopCounts = 6;
      pinchZoneCounts = 450;
      pinchDeltaMa = 2000;
      learned = false;
    } /** Content of the emulated data flash, kept across the modeled power cycles. */;
    attribute ramMirror: WindowCalibration = record WindowCalibration {
      closedCounts = 0;
      openCounts = 1000;
      softStopCounts = 6;
      pinchZoneCounts = 450;
      pinchDeltaMa = 2000;
      learned = false;
    };
    attribute dirty: bool = false;
    attribute writeAllRequests: uint = 0;
    attribute writeCycles: uint = 0;
    attribute cancelled: uint = 0;
    operation readAll() {
      ramMirror = nvBlock;
      send calibration.windowCalibration(ramMirror);
    }
    operation store(block: WindowCalibration) {
      ramMirror = block;
      dirty = true;
    }
    operation writeAllJob() {
      /** Write every dirty block; the data flash program time is 4 ms. */
      interruptible {
        wait 4ms;
        writeAllRequests = writeAllRequests + 1;
        if (dirty) {
          nvBlock = ramMirror;
          dirty = false;
          writeCycles = writeCycles + 1;
        }
        publish control.writeAllDone(true);
      } on receive control.cancelWriteAll() {
        cancelled = cancelled + 1;
      }
    }
    schedule {
      on start readAll();
      on receive calibration.store(block) store(block);
      on receive control.writeAll() writeAllJob() deadline 100ms;
    }
  }

  component def WdgM {
    /**
     * Watchdog manager: alive supervision of four supervised entities in a 200 ms window
     * (1 to 3 checkpoints each, the first window after start-up or wake-up is a grace
     * window). The external watchdog is triggered every 40 ms while the global status is
     * correct; one failed window expires the global status and triggering stops for good,
     * so the external watchdog resets the ECU (the reset itself is not modeled).
     */
    reversed port alive: AliveSupervision;
    port line: WatchdogLine;
    reversed port modeIn: ModeBroadcast;
    const attribute minAlive: uint = 1;
    const attribute maxAlive: uint = 3;
    attribute linAlive: uint = 0;
    attribute latchAlive: uint = 0;
    attribute supplyAlive: uint = 0;
    attribute comAlive: uint = 0;
    attribute graceWindows: uint = 1;
    attribute expired: bool = false;
    attribute failedWindows: uint = 0;
    attribute lowPower: bool = false;
    attribute level: bool = false;
    attribute triggers: uint = 0;
    operation checkpoint(entity: SupervisedEntity) {
      if (entity == SupervisedEntity.linInterface) {
        linAlive = linAlive + 1;
      }
      if (entity == SupervisedEntity.latchMonitor) {
        latchAlive = latchAlive + 1;
      }
      if (entity == SupervisedEntity.supplyMonitor) {
        supplyAlive = supplyAlive + 1;
      }
      if (entity == SupervisedEntity.communication) {
        comAlive = comAlive + 1;
      }
    }
    operation correct(count: uint) returns bool {
      return count >= minAlive and count <= maxAlive;
    }
    operation resetCounters() {
      linAlive = 0;
      latchAlive = 0;
      supplyAlive = 0;
      comAlive = 0;
    }
    operation supervise() {
      /** 200 ms: evaluate the alive counters of the supervision window. */
      if (lowPower or graceWindows > 0) {
        if (graceWindows > 0) {
          graceWindows = graceWindows - 1;
        }
        resetCounters();
        return;
      }
      var ok: bool = correct(linAlive) and correct(latchAlive) and correct(supplyAlive) and correct(comAlive);
      if (not ok) {
        failedWindows = failedWindows + 1;
        expired = true;
      }
      resetCounters();
    }
    operation trigger() {
      /** 40 ms: toggle the trigger line while the global supervision status is correct. */
      if (not expired and not lowPower) {
        level = not level;
        triggers = triggers + 1;
        send line.trigger(level);
      }
    }
    operation onMode(current: PowerMode) {
      var asleep: bool = current == PowerMode.sleep;
      if (asleep != lowPower) {
        lowPower = asleep;
        graceWindows = 1;
        send line.lowPower(asleep);
      }
    }
    schedule {
      on receive alive.checkpoint(entity) checkpoint(entity);
      on receive modeIn.changed(current) onMode(current);
      on every 40ms trigger() deadline 2ms;
      on every 200ms supervise() deadline 5ms;
    }
  }

  component def ModeManager {
    /**
     * ECU state manager with network management: start-up, run while ignition is on,
     * post-run after ignition off (restarted by local activity), ready-sleep while the body
     * CAN is still active, shutdown with an asynchronous NVRAM write-all after 500 ms of bus
     * silence, sleep, and wake-up on a validated CAN, LIN or local wake-up source. Each
     * state change is broadcast to the mode users.
     */
    reversed port vehicle: VehicleSignalsPort;
    reversed port wake: WakeIndication;
    reversed port bus: BusActivity;
    reversed port nvm: NvmJobs;
    port modeOut: ModeBroadcast;
    attribute current: PowerMode = PowerMode.startup;
    attribute lastWake: WakeSource = WakeSource.none;
    attribute sleeps: uint = 0;
    attribute wakeups: uint = 0;
    attribute nvmStored: bool = false;
    attribute shutdownsAborted: uint = 0;
    operation announce(next: PowerMode) {
      current = next;
      publish modeOut.changed(next);
    }
    operation control() {
      initial startup;
      state startup {
        /** Power-on reset: initialization, then post-run unless the ignition is on. */
        on entry {
          announce(PowerMode.startup);
        }
        on receive vehicle.signals(s) when (s.ignitionOn) to run {
        }
        after 20ms to postRun {
        }
      }
      state run {
        on entry {
          announce(PowerMode.run);
        }
        on receive vehicle.signals(s) when (not s.ignitionOn) to postRun {
        }
      }
      state postRun {
        /** Own network request kept for the post-run time; local activity restarts it. */
        on entry {
          announce(PowerMode.postRun);
        }
        on receive vehicle.signals(s) when (s.ignitionOn) to run {
        }
        on receive wake.request(source) to postRun {
          lastWake = source;
        }
        after 1s to readySleep {
          announce(PowerMode.readySleep);
        }
      }
      state readySleep {
        /** Network released: every received frame restarts the 500 ms NM timeout. */
        on receive vehicle.signals(s) when (s.ignitionOn) to run {
        }
        on receive wake.request(source) to postRun {
          lastWake = source;
        }
        on receive bus.frameReceived() to readySleep {
        }
        after 500ms to shutdown {
        }
      }
      state shutdown {
        /** Bus silent: request the asynchronous write-all; bus activity or a wake-up aborts the shutdown. */
        on entry {
          announce(PowerMode.shutdown);
          publish nvm.writeAll();
        }
        on receive nvm.writeAllDone(ok) to sleep {
          nvmStored = ok;
        }
        on receive bus.frameReceived() to readySleep {
          shutdownsAborted = shutdownsAborted + 1;
          publish nvm.cancelWriteAll();
          announce(PowerMode.readySleep);
        }
        on receive wake.request(source) to postRun {
          lastWake = source;
          shutdownsAborted = shutdownsAborted + 1;
          publish nvm.cancelWriteAll();
        }
        after 200ms to sleep {
          nvmStored = false;
        }
      }
      state sleep {
        /** Low-power mode: only wake-capable inputs and the CAN transceiver stay active. */
        on entry {
          sleeps = sleeps + 1;
          announce(PowerMode.sleep);
        }
        on receive wake.request(source) to wakeup {
          lastWake = source;
        }
      }
      state wakeup {
        on entry {
          wakeups = wakeups + 1;
          announce(PowerMode.wakeup);
        }
        on receive vehicle.signals(s) when (s.ignitionOn) to run {
        }
        after 20ms to postRun {
        }
      }
    }
    schedule {
      on start control();
    }
  }

  // ---------------------------------------------------------- application software

  component def SwitchDebounce {
    /**
     * Switch panel debouncing: a switch state is accepted after two identical LIN frames
     * (40 ms at the 20 ms LIN schedule); accepted changes become window, lock, mirror and
     * heater requests.
     */
    reversed port frames: SwitchFrames;
    port window: WindowRequests;
    port lock: LockRequests;
    port mirror: MirrorRequests;
    port heater: HeaterRequest;
    port remoteMirror: RemoteMirror;
    const attribute stableFrames: uint = 2;
    attribute candidate: SwitchFrame = record SwitchFrame {
      window = WindowRequest.neutral;
      lock = LockRequest.none;
      mirror = MirrorRequest.none;
      side = MirrorSide.driver;
      fold = FoldRequest.none;
      mirrorHeat = false;
    };
    attribute debounced: SwitchFrame = record SwitchFrame {
      window = WindowRequest.neutral;
      lock = LockRequest.none;
      mirror = MirrorRequest.none;
      side = MirrorSide.driver;
      fold = FoldRequest.none;
      mirrorHeat = false;
    };
    attribute stableCount: uint = 0;
    operation publishChanges(previous: SwitchFrame, next: SwitchFrame) {
      if (next.window != previous.window) {
        publish window.request(next.window);
      }
      if (next.lock != previous.lock and next.lock != LockRequest.none) {
        publish lock.request(next.lock);
      }
      if (next.mirror != previous.mirror) {
        if (next.side == MirrorSide.driver) {
          publish mirror.adjust(next.mirror);
        } else {
          publish remoteMirror.adjust(next.mirror);
        }
      }
      if (next.fold != previous.fold and next.fold != FoldRequest.none) {
        publish mirror.fold(next.fold);
      }
      if (next.mirrorHeat != previous.mirrorHeat) {
        publish heater.heat(next.mirrorHeat);
      }
    }
    operation debounce(frame: SwitchFrame) {
      if (frame == candidate) {
        if (stableCount < stableFrames) {
          stableCount = stableCount + 1;
        }
      } else {
        candidate = frame;
        stableCount = 1;
      }
      if (stableCount >= stableFrames and frame != debounced) {
        publishChanges(debounced, frame);
        debounced = frame;
      }
    }
    schedule {
      on receive frames.frame(frame) debounce(frame) deadline 2ms;
    }
  }

  component def DoorLatchMonitor {
    /** Door-ajar and latch state: three identical 20 ms samples of both latch switches. */
    reversed port latch: LatchInputs;
    port door: DoorState;
    port alive: AliveSupervision;
    const attribute stableSamples: uint = 3;
    attribute sample: LatchSample = record LatchSample { primary = true; secondary = true; };
    attribute candidate: LatchSample = record LatchSample { primary = true; secondary = true; };
    attribute stableCount: uint = 0;
    attribute cycles: uint = 0;
    attribute latchState: LatchState = LatchState.primary;
    attribute ajar: bool = false;
    operation storeSample(value: LatchSample) {
      sample = value;
    }
    operation classify(value: LatchSample) returns LatchState {
      if (value.primary) {
        return LatchState.primary;
      }
      if (value.secondary) {
        return LatchState.secondary;
      }
      return LatchState.open;
    }
    operation debounce() {
      cycles = cycles + 1;
      if (cycles % 5 == 0) {
        publish alive.checkpoint(SupervisedEntity.latchMonitor);
      }
      if (sample == candidate) {
        if (stableCount < stableSamples) {
          stableCount = stableCount + 1;
        }
      } else {
        candidate = sample;
        stableCount = 1;
      }
    }
    operation evaluate() {
      if (stableCount < stableSamples) {
        return;
      }
      var next: LatchState = classify(candidate);
      if (next != latchState) {
        latchState = next;
        ajar = next != LatchState.primary;
        send door.ajar(ajar);
      }
    }
    schedule {
      on receive latch.latchSample(value) storeSample(value);
      on every 20ms debounce() deadline 2ms;
      after debounce evaluate() deadline 2ms;
    }
  }

  component def SupplyMonitor {
    /** Supply voltage monitor: undervoltage below 9.0 V for two 50 ms samples, recovery only above 9.5 V. */
    reversed port supply: SupplyVoltage;
    port diag: DiagEvents;
    port alive: AliveSupervision;
    const attribute underMv: uint = 9000;
    const attribute recoverMv: uint = 9500;
    const attribute qualifySamples: uint = 2;
    attribute supplyMv: uint = 13500;
    attribute lowSamples: uint = 0;
    attribute undervoltage: bool = false;
    operation store(mv: uint) {
      supplyMv = mv;
    }
    operation classify() {
      if (supplyMv < underMv) {
        if (lowSamples < qualifySamples) {
          lowSamples = lowSamples + 1;
        }
      }
      if (supplyMv >= recoverMv) {
        lowSamples = 0;
      }
      undervoltage = lowSamples >= qualifySamples;
    }
    operation report() {
      publish diag.report(FaultId.supplyUndervoltage, undervoltage);
      publish alive.checkpoint(SupervisedEntity.supplyMonitor);
    }
    schedule {
      on receive supply.supplyMv(mv) store(mv);
      on every 50ms classify() deadline 2ms;
      on every 100ms report() deadline 10ms;
    }
  }

  component def AntiPinch {
    /**
     * Anti-pinch and position supervision of the window lifter, triggered by every feedback
     * sample: inrush blanking, an adaptive running-current reference, pinch detection in the
     * pinch zone, the reversal distance, soft stops, Hall plausibility and the normalization
     * flag. The pinch state is resynchronized with every motor command, so detection is
     * re-armed for each close even if a reversal did not complete.
     */
    reversed port feedback: WindowFeedbackPort;
    reversed port drive: WindowMotorPort;
    reversed port calibration: CalibrationBlock;
    port events: WindowSupervision;
    port status: WindowStatusPort;
    port diag: DiagEvents;
    const attribute blankingSamples: uint = 5 /** 50 ms inrush blanking after a motor start. */;
    const attribute reversalCounts: uint = 280 /** About 125 mm at 0.45 mm per Hall count. */;
    const attribute hallStuckSamples: uint = 5;
    attribute cal: WindowCalibration = record WindowCalibration {
      closedCounts = 0;
      openCounts = 1000;
      softStopCounts = 6;
      pinchZoneCounts = 450;
      pinchDeltaMa = 2000;
      learned = false;
    };
    attribute direction: MotorDirection = MotorDirection.stop;
    attribute runSamples: uint = 0;
    attribute position: uint = 250;
    attribute lastPosition: uint = 250;
    attribute referenceMa: uint = 0;
    attribute peakDeltaMa: int = 0;
    attribute pinchPosition: uint = 0;
    attribute reversing: bool = false;
    attribute pinchActive: bool = false;
    attribute pinchEvents: uint = 0;
    attribute stuckSamples: uint = 0;
    attribute hallFaultSeen: bool = false;
    operation useCalibration(block: WindowCalibration) {
      cal = block;
    }
    operation motionEnded() {
      /** End of a motion: Hall monitor result and the window status for Com and the diagnostic services. */
      if (runSamples > blankingSamples and not hallFaultSeen) {
        publish diag.report(FaultId.hallSensor, false);
      }
      hallFaultSeen = false;
      send status.windowStatus(record WindowStatus { positionCounts = position; pinchActive = pinchActive; learned = cal.learned; });
    }
    operation trackCommand(command: MotorCommand) {
      if (command.direction != direction) {
        if (direction != MotorDirection.stop) {
          motionEnded();
        }
        direction = command.direction;
        runSamples = 0;
        stuckSamples = 0;
        if (direction != MotorDirection.down) {
          reversing = false;
        }
        if (direction == MotorDirection.up) {
          pinchActive = false;
        }
      }
    }
    operation confirmClosedStop() {
      /** Normalization: the first complete close marks the calibration as learned and requests an NVRAM write. */
      if (not cal.learned) {
        cal = record WindowCalibration {
          closedCounts = cal.closedCounts;
          openCounts = cal.openCounts;
          softStopCounts = cal.softStopCounts;
          pinchZoneCounts = cal.pinchZoneCounts;
          pinchDeltaMa = cal.pinchDeltaMa;
          learned = true;
        };
        publish calibration.store(cal);
      }
    }
    operation superviseClosing(currentMa: uint) {
      if (position <= cal.closedCounts + cal.softStopCounts) {
        confirmClosedStop();
        publish events.endPosition(true);
        return;
      }
      if (runSamples <= blankingSamples) {
        referenceMa = currentMa;
        return;
      }
      var delta: int = currentMa - referenceMa;
      if (delta > peakDeltaMa) {
        peakDeltaMa = delta;
      }
      if (position <= cal.closedCounts + cal.pinchZoneCounts and delta > cal.pinchDeltaMa and not reversing) {
        reversing = true;
        pinchActive = true;
        pinchPosition = position;
        pinchEvents = pinchEvents + 1;
        publish events.pinchDetected();
        return;
      }
      referenceMa = trunc((referenceMa * 7 + currentMa) / 8);
    }
    operation superviseOpening() {
      if (reversing and position >= pinchPosition + reversalCounts) {
        reversing = false;
        publish events.reversalComplete();
      }
      if (position + cal.softStopCounts >= cal.openCounts) {
        reversing = false;
        publish events.endPosition(false);
      }
    }
    operation evaluate(sample: WindowFeedback) {
      /** Data-received runnable for each window feedback sample. */
      lastPosition = position;
      position = sample.positionCounts;
      if (direction == MotorDirection.stop) {
        return;
      }
      runSamples = runSamples + 1;
      if (position == lastPosition and runSamples > blankingSamples) {
        stuckSamples = stuckSamples + 1;
        if (stuckSamples >= hallStuckSamples and not hallFaultSeen) {
          hallFaultSeen = true;
          publish diag.report(FaultId.hallSensor, true);
          publish events.sensorFault();
          return;
        }
      } else {
        stuckSamples = 0;
      }
      if (direction == MotorDirection.up) {
        superviseClosing(sample.currentMa);
      } else {
        superviseOpening();
      }
    }
    schedule {
      on receive feedback.feedback(sample) evaluate(sample) deadline 2ms;
      on receive drive.windowMotor(command) trackCommand(command) deadline 1ms;
      on receive calibration.windowCalibration(block) useCalibration(block);
    }
  }

  component def WindowLifter {
    /**
     * Window lifter: manual and one-touch movement in both directions, reversal after a
     * pinch, stop at the soft stops, on a Hall fault and on a motor run-time limit. A
     * withdrawn motion permission (undervoltage, confirmed overcurrent) stops any movement
     * except a pinch reversal, which is completed to release the obstacle.
     */
    reversed port requests: WindowRequests;
    reversed port supervision: WindowSupervision;
    reversed port permissionIn: PermissionPort;
    reversed port modeIn: ModeBroadcast;
    port motor: WindowMotorPort;
    const attribute dutyPercent: uint = 100;
    attribute permission: FunctionPermission = record FunctionPermission { windowMotion = true; oneTouch = true; };
    attribute powerMode: PowerMode = PowerMode.startup;
    attribute pinchReversals: uint = 0;
    attribute runTimeouts: uint = 0;
    attribute oneTouchCloses: uint = 0;
    attribute inhibitedStops: uint = 0;
    operation drive(direction: MotorDirection) {
      var duty: uint = 0;
      if (direction != MotorDirection.stop) {
        duty = dutyPercent;
      }
      send motor.windowMotor(record MotorCommand { direction = direction; dutyPercent = duty; });
    }
    operation motionAllowed() returns bool {
      return permission.windowMotion and powerMode != PowerMode.sleep;
    }
    operation oneTouchAllowed() returns bool {
      return motionAllowed() and permission.oneTouch;
    }
    operation control() {
      initial idle;
      state idle {
        on entry {
          drive(MotorDirection.stop);
        }
        on receive requests.request(command) when (command == WindowRequest.autoUp and oneTouchAllowed()) to autoUp {
          oneTouchCloses = oneTouchCloses + 1;
        }
        on receive requests.request(command) when ((command == WindowRequest.manualUp or command == WindowRequest.autoUp) and motionAllowed()) to manualUp {
        }
        on receive requests.request(command) when (command == WindowRequest.autoDown and oneTouchAllowed()) to autoDown {
        }
        on receive requests.request(command) when ((command == WindowRequest.manualDown or command == WindowRequest.autoDown) and motionAllowed()) to manualDown {
        }
      }
      state manualUp {
        on entry {
          drive(MotorDirection.up);
        }
        on receive supervision.pinchDetected() to reversing {
          pinchReversals = pinchReversals + 1;
        }
        on receive supervision.endPosition(closed) when (closed) to idle {
        }
        on receive supervision.sensorFault() to idle {
        }
        on receive permissionIn.motionInhibited() to idle {
          inhibitedStops = inhibitedStops + 1;
        }
        on receive requests.request(command) when (command == WindowRequest.autoUp and oneTouchAllowed()) to autoUp {
          oneTouchCloses = oneTouchCloses + 1;
        }
        on receive requests.request(command) when (command != WindowRequest.manualUp and command != WindowRequest.autoUp) to idle {
        }
        after 8s to idle {
          runTimeouts = runTimeouts + 1;
        }
      }
      state autoUp {
        /** One-touch close: continues after the switch is released; a down request stops it. */
        on entry {
          drive(MotorDirection.up);
        }
        on receive supervision.pinchDetected() to reversing {
          pinchReversals = pinchReversals + 1;
        }
        on receive supervision.endPosition(closed) when (closed) to idle {
        }
        on receive supervision.sensorFault() to idle {
        }
        on receive permissionIn.motionInhibited() to idle {
          inhibitedStops = inhibitedStops + 1;
        }
        on receive requests.request(command) when (command == WindowRequest.manualDown or command == WindowRequest.autoDown) to idle {
        }
        after 8s to idle {
          runTimeouts = runTimeouts + 1;
        }
      }
      state reversing {
        /**
         * Pinch reversal: open by the reversal distance. Switch requests and a withdrawn
         * motion permission are ignored, because opening releases the obstacle; a Hall fault
         * or the 1.2 s limit ends it.
         */
        on entry {
          drive(MotorDirection.down);
        }
        on receive supervision.reversalComplete() to idle {
        }
        on receive supervision.endPosition(closed) when (not closed) to idle {
        }
        on receive supervision.sensorFault() to idle {
        }
        after 1200ms to idle {
          runTimeouts = runTimeouts + 1;
        }
      }
      state manualDown {
        on entry {
          drive(MotorDirection.down);
        }
        on receive supervision.endPosition(closed) when (not closed) to idle {
        }
        on receive supervision.sensorFault() to idle {
        }
        on receive permissionIn.motionInhibited() to idle {
          inhibitedStops = inhibitedStops + 1;
        }
        on receive requests.request(command) when (command == WindowRequest.autoDown and oneTouchAllowed()) to autoDown {
        }
        on receive requests.request(command) when (command != WindowRequest.manualDown and command != WindowRequest.autoDown) to idle {
        }
        after 8s to idle {
          runTimeouts = runTimeouts + 1;
        }
      }
      state autoDown {
        on entry {
          drive(MotorDirection.down);
        }
        on receive supervision.endPosition(closed) when (not closed) to idle {
        }
        on receive supervision.sensorFault() to idle {
        }
        on receive permissionIn.motionInhibited() to idle {
          inhibitedStops = inhibitedStops + 1;
        }
        on receive requests.request(command) when (command == WindowRequest.manualUp or command == WindowRequest.autoUp) to idle {
        }
        after 8s to idle {
          runTimeouts = runTimeouts + 1;
        }
      }
    }
    operation updatePermission(next: FunctionPermission) {
      permission = next;
    }
    operation onMode(current: PowerMode) {
      powerMode = current;
    }
    schedule {
      on start control();
      on receive permissionIn.permission(next) updatePermission(next);
      on receive modeIn.changed(current) onMode(current);
    }
  }

  component def LockControl {
    /**
     * Central locking of the door: lock and unlock requests from the switch panel and the
     * key fob, speed-dependent auto-lock once per ignition cycle, crash unlock with priority
     * over every other state, timed actuator pulses and supervision of each lock pulse by
     * the lock position switch.
     */
    reversed port requests: LockRequests;
    reversed port vehicle: VehicleSignalsPort;
    reversed port crash: CrashPort;
    reversed port door: DoorState;
    reversed port feedback: LockFeedback;
    reversed port modeIn: ModeBroadcast;
    port motor: LockMotorPort;
    port status: LockStatus;
    port diag: DiagEvents;
    const attribute autoLockKph: real = 15.0;
    attribute ajar: bool = false;
    attribute switchLocked: bool = false;
    attribute autoLockArmed: bool = true;
    attribute autoLocked: bool = false;
    attribute crashLatched: bool = false;
    attribute locked: bool = false;
    attribute lockCycles: uint = 0;
    operation announce(next: LockState) {
      locked = next == LockState.locked;
      publish status.changed(next);
    }
    operation checkFeedback(expectLocked: bool) {
      publish diag.report(FaultId.lockActuator, switchLocked != expectLocked);
    }
    operation control() {
      initial unlocked;
      state unlocked {
        on receive crash.crashUnlock() to crashUnlocking {
        }
        on receive requests.request(command) when (command == LockRequest.lock and not ajar) to locking {
        }
        on receive vehicle.signals(s) when (s.speedValid and s.speedKph >= autoLockKph and autoLockArmed and not ajar) to locking {
          autoLockArmed = false;
          autoLocked = true;
        }
      }
      state locking {
        on entry {
          send motor.lockMotor(LockDrive.lockPulse);
        }
        on exit {
          send motor.lockMotor(LockDrive.idle);
        }
        on receive crash.crashUnlock() to crashUnlocking {
        }
        after 250ms to locked {
          lockCycles = lockCycles + 1;
          checkFeedback(true);
          announce(LockState.locked);
        }
      }
      state locked {
        on receive crash.crashUnlock() to crashUnlocking {
        }
        on receive requests.request(command) when (command == LockRequest.unlock) to unlocking {
        }
      }
      state unlocking {
        on entry {
          send motor.lockMotor(LockDrive.unlockPulse);
        }
        on exit {
          send motor.lockMotor(LockDrive.idle);
        }
        on receive crash.crashUnlock() to crashUnlocking {
        }
        after 250ms to unlocked {
          lockCycles = lockCycles + 1;
          announce(LockState.unlocked);
        }
      }
      state crashUnlocking {
        /** Crash unlock: drive the actuator open immediately, whatever the speed. */
        on entry {
          crashLatched = true;
          send motor.lockMotor(LockDrive.unlockPulse);
        }
        on exit {
          send motor.lockMotor(LockDrive.idle);
        }
        after 250ms to crashHold {
          announce(LockState.unlocked);
        }
      }
      state crashHold {
        /** After a crash: auto-lock stays inhibited; a manual lock is still accepted. */
        on receive crash.crashUnlock() to crashUnlocking {
        }
        on receive requests.request(command) when (command == LockRequest.lock and not ajar) to locking {
        }
      }
    }
    operation setAjar(value: bool) {
      ajar = value;
    }
    operation setFeedback(value: bool) {
      switchLocked = value;
    }
    operation onMode(current: PowerMode) {
      if (current == PowerMode.postRun and not crashLatched) {
        autoLockArmed = true;
      }
    }
    schedule {
      on start control();
      on receive door.ajar(value) setAjar(value);
      on receive feedback.lockSwitchLocked(value) setFeedback(value);
      on receive modeIn.changed(current) onMode(current);
    }
  }

  component def MirrorControl {
    /**
     * Exterior mirror of this door: glass adjustment while the joystick is held, and the
     * fold motor as an asynchronous job: fold or unfold on request or with the lock state,
     * stopping at the end stop or after 1.5 s.
     */
    reversed port request: MirrorRequests;
    reversed port lockStatus: LockStatus;
    reversed port feedback: MirrorFeedback;
    port drive: MirrorMotorPort;
    const attribute autoFold: bool = true;
    attribute folded: bool = false;
    attribute foldMoves: uint = 0;
    attribute foldTimeouts: uint = 0;
    operation adjust(direction: MirrorRequest) {
      var horizontal: int = 0;
      var vertical: int = 0;
      if (direction == MirrorRequest.left) {
        horizontal = -1;
      }
      if (direction == MirrorRequest.right) {
        horizontal = 1;
      }
      if (direction == MirrorRequest.up) {
        vertical = 1;
      }
      if (direction == MirrorRequest.down) {
        vertical = -1;
      }
      send drive.mirrorMotors(record MirrorDrive { horizontal = horizontal; vertical = vertical; });
    }
    operation foldControl() {
      initial stopped;
      state stopped {
        on entry {
          send drive.foldMotor(FoldRequest.none);
        }
        on receive request.fold(command) when (command == FoldRequest.fold and not folded) to folding {
        }
        on receive request.fold(command) when (command == FoldRequest.unfold and folded) to unfolding {
        }
        on receive lockStatus.changed(current) when (autoFold and current == LockState.locked and not folded) to folding {
        }
        on receive lockStatus.changed(current) when (autoFold and current == LockState.unlocked and folded) to unfolding {
        }
      }
      state folding {
        on entry {
          foldMoves = foldMoves + 1;
          send drive.foldMotor(FoldRequest.fold);
        }
        on receive feedback.foldEndStop() to stopped {
          folded = true;
        }
        on receive request.fold(command) when (command == FoldRequest.unfold) to unfolding {
        }
        on receive lockStatus.changed(current) when (autoFold and current == LockState.unlocked) to unfolding {
        }
        after 1500ms to stopped {
          foldTimeouts = foldTimeouts + 1;
        }
      }
      state unfolding {
        on entry {
          foldMoves = foldMoves + 1;
          send drive.foldMotor(FoldRequest.unfold);
        }
        on receive feedback.foldEndStop() to stopped {
          folded = false;
        }
        on receive request.fold(command) when (command == FoldRequest.fold) to folding {
        }
        on receive lockStatus.changed(current) when (autoFold and current == LockState.locked) to folding {
        }
        after 1500ms to stopped {
          foldTimeouts = foldTimeouts + 1;
        }
      }
    }
    schedule {
      on start foldControl();
      on receive request.adjust(direction) adjust(direction) deadline 5ms;
    }
  }

  component def MirrorHeater {
    /** Mirror heater: switched on request in the 100 ms task, with a 10 minute limit (not exercised by the bounded bench). */
    reversed port request: HeaterRequest;
    port drive: HeaterPort;
    const attribute heaterPercent: uint = 70;
    const attribute heaterLimitTicks: uint = 6000 /** 10 minutes in 100 ms ticks. */;
    attribute requested: bool = false;
    attribute heating: bool = false;
    attribute heaterTicks: uint = 0;
    operation store(enabled: bool) {
      requested = enabled;
    }
    operation tick() {
      if (requested and not heating) {
        heating = true;
        heaterTicks = 0;
        send drive.heaterPercent(heaterPercent);
      }
      if (not requested and heating) {
        heating = false;
        send drive.heaterPercent(0);
      }
      if (heating) {
        heaterTicks = heaterTicks + 1;
        if (heaterTicks >= heaterLimitTicks) {
          heating = false;
          requested = false;
          send drive.heaterPercent(0);
        }
      }
    }
    schedule {
      on receive request.heat(enabled) store(enabled);
      on every 100ms tick() deadline 10ms;
    }
  }

  component def CourtesyLighting {
    /**
     * Puddle and courtesy lamps in the 100 ms task: approach light for 30 s after unlocking,
     * door-open light, 2 s afterglow after the door closes, and both lamps off when the
     * vehicle locks.
     */
    reversed port door: DoorState;
    reversed port lockStatus: LockStatus;
    port puddle: LampRequest;
    port courtesy: LampRequest;
    const attribute approachTicks: uint = 300;
    const attribute afterglowTicks: uint = 20;
    attribute ajar: bool = false;
    attribute approachLeft: uint = 0;
    attribute afterglowLeft: uint = 0;
    attribute puddleOn: bool = false;
    attribute courtesyOn: bool = false;
    operation onDoor(value: bool) {
      if (ajar and not value) {
        afterglowLeft = afterglowTicks;
      }
      ajar = value;
    }
    operation onLock(current: LockState) {
      if (current == LockState.unlocked) {
        approachLeft = approachTicks;
      } else {
        approachLeft = 0;
        afterglowLeft = 0;
      }
    }
    operation tick() {
      if (approachLeft > 0) {
        approachLeft = approachLeft - 1;
      }
      if (afterglowLeft > 0) {
        afterglowLeft = afterglowLeft - 1;
      }
      var puddleNext: bool = ajar or approachLeft > 0;
      var courtesyNext: bool = ajar or afterglowLeft > 0;
      if (puddleNext != puddleOn) {
        puddleOn = puddleNext;
        send puddle.lampOn(puddleNext);
      }
      if (courtesyNext != courtesyOn) {
        courtesyOn = courtesyNext;
        send courtesy.lampOn(courtesyNext);
      }
    }
    schedule {
      on receive door.ajar(value) onDoor(value);
      on receive lockStatus.changed(current) onLock(current);
      on every 100ms tick() deadline 10ms;
    }
  }

  component def CourtesyLamp {
    /** Lamp driver with a soft start and soft stop: 20 % duty steps every 50 ms. */
    reversed port request: LampRequest;
    port output: LampPwm;
    const attribute stepPercent: uint = 20;
    attribute target: uint = 0;
    attribute duty: uint = 0;
    operation setTarget(lit: bool) {
      if (lit) {
        target = 100;
      } else {
        target = 0;
      }
    }
    operation ramp() {
      if (duty < target) {
        duty = duty + stepPercent;
        send output.dutyPercent(duty);
      }
      if (duty > target) {
        duty = duty - stepPercent;
        send output.dutyPercent(duty);
      }
    }
    schedule {
      on receive request.lampOn(lit) setTarget(lit);
      on every 50ms ramp() deadline 5ms;
    }
  }

  // ------------------------------------------------------------- software composition

  component def DoorControlUnit {
    /**
     * Software of the front-left door control unit: basic-software-like services and the
     * application components, joined by explicit routes in the manner of an RTE. The
     * boundary ports are the ECU connector, LIN with its wake line, CAN, the diagnostic
     * channel and the watchdog line. Routes between the two cores use the CrossCore policy.
     */
    reversed port pins: EcuInputs;
    port outputs: EcuOutputs;
    reversed port linBus: LinBus;
    reversed port linWake: LinWakeLine;
    reversed port canBus: BodyCan;
    port uds: Diagnostics;
    port wdgLine: WatchdogLine;
    component ioIn: IoHwAbInput;
    component ioOut: IoHwAbOutput;
    component canIf: CanInterface;
    component comMain: ComMain;
    component linIf: LinMaster;
    component dem: Dem;
    component dcm: Dcm;
    component nvm: NvM;
    component wdgM: WdgM;
    component ecuMode: ModeManager;
    component switches: SwitchDebounce;
    component latch: DoorLatchMonitor;
    component supply: SupplyMonitor;
    component antiPinch: AntiPinch;
    component window: WindowLifter;
    component lock: LockControl;
    component mirror: MirrorControl;
    component heater: MirrorHeater;
    component lighting: CourtesyLighting;
    component lamps: CourtesyLamp[2] {
      /** lamps[0] is the puddle lamp, lamps[1] the courtesy lamp. */
    }
    // boundary forwarding
    connect (pins, ioIn.pins);
    connect (linWake, ioIn.linWake);
    connect (outputs, ioOut.outputs);
    connect (linBus, linIf.bus);
    connect (canBus, canIf.can);
    connect (uds, dcm.service);
    connect (wdgLine, wdgM.line);
    // sensing and actuation (core 0)
    connect windowFeedback (ioIn.window, antiPinch.feedback);
    connect (ioIn.supply, supply.supply);
    connect (ioIn.supply, dcm.supply);
    connect (ioIn.latch, latch.latch);
    connect (ioIn.lockSense, lock.feedback);
    connect (ioIn.mirrorSense, mirror.feedback);
    connect bridgeTrip: RteQueued (ioIn.trip, ioOut.trip);
    connect windowMotor (window.motor, ioOut.windowDrive);
    connect (window.motor, antiPinch.drive);
    connect lockMotor (lock.motor, ioOut.lockDrive);
    connect (mirror.drive, ioOut.mirrorDrive);
    connect (heater.drive, ioOut.heaterDrive);
    connect (lighting.puddle, lamps[0].request);
    connect (lighting.courtesy, lamps[1].request);
    connect (lamps[0].output, ioOut.puddleLamp);
    connect (lamps[1].output, ioOut.courtesyLamp);
    // switch panel requests
    connect switchFrames (linIf.frames, switches.frames);
    connect windowRequests: RteQueued (switches.window, window.requests);
    connect comfortClose: CrossCore (canIf.windowRequests, window.requests);
    connect lockRequests: RteQueued (switches.lock, lock.requests);
    connect keyFob: CrossCore (canIf.lockRequests, lock.requests);
    connect mirrorRequests: CrossCore (switches.mirror, mirror.request);
    connect heaterRequests: CrossCore (switches.heater, heater.request);
    connect remoteMirror: CrossCore (switches.remoteMirror, canIf.remoteMirror);
    // window supervision
    connect pinch: RteQueued (antiPinch.events, window.supervision);
    connect (antiPinch.status, comMain.window);
    connect (antiPinch.status, dcm.window);
    connect (nvm.calibration, antiPinch.calibration);
    // CAN and vehicle state
    connect (canIf.rx, comMain.rx);
    connect (comMain.tx, canIf.tx);
    connect (comMain.vehicle, lock.vehicle);
    connect (comMain.vehicle, ecuMode.vehicle);
    connect crashPath: CrossCore (canIf.crash, lock.crash);
    connect (latch.door, lock.door);
    connect (latch.door, lighting.door);
    connect (latch.door, comMain.door);
    connect lockStatusToCan: CrossCore (lock.status, canIf.lockStatus);
    connect (lock.status, comMain.lockStatus);
    connect lockStatusToMirror: CrossCore (lock.status, mirror.lockStatus);
    connect (lock.status, lighting.lockStatus);
    // mode and network management
    connect (ioIn.wake, ecuMode.wake);
    connect canWake: CrossCore (canIf.wake, ecuMode.wake);
    connect busActivity: CrossCore (canIf.nm, ecuMode.bus);
    connect nvmJobs: CrossCore (ecuMode.nvm, nvm.control);
    connect (ecuMode.modeOut, ioIn.modeIn);
    connect (ecuMode.modeOut, ioOut.modeIn);
    connect (ecuMode.modeOut, canIf.modeIn);
    connect (ecuMode.modeOut, comMain.modeIn);
    connect (ecuMode.modeOut, linIf.modeIn);
    connect (ecuMode.modeOut, wdgM.modeIn);
    connect (ecuMode.modeOut, window.modeIn);
    connect (ecuMode.modeOut, lock.modeIn);
    // diagnostics
    connect (ioIn.diag, dem.events);
    connect (antiPinch.diag, dem.events);
    connect (lock.diag, dem.events);
    connect (supply.diag, dem.events);
    connect (linIf.diag, dem.events);
    connect (comMain.diag, dem.events);
    connect permission: CrossCore (dem.fim, window.permissionIn);
    connect dtcAccess (dcm.dem, dem.access);
    // alive supervision
    connect (linIf.alive, wdgM.alive);
    connect (latch.alive, wdgM.alive);
    connect (supply.alive, wdgM.alive);
    connect (comMain.alive, wdgM.alive);
  }

  // --------------------------------------------------------- environment and bench

  component def LinSwitchPanel {
    /**
     * Driver's door switch panel, a LIN slave: scans its contacts, answers each frame header
     * with the switch states and a rolling alive counter, and sends a wake-up pulse when a
     * contact changes while the cluster sleeps (no header for at least 100 ms). The bench
     * can unplug its connector.
     */
    reversed port contacts: SwitchContacts;
    port bus: LinBus;
    port wake: LinWakeLine;
    attribute window: WindowRequest = WindowRequest.neutral;
    attribute lock: LockRequest = LockRequest.none;
    attribute mirror: MirrorRequest = MirrorRequest.none;
    attribute side: MirrorSide = MirrorSide.driver;
    attribute fold: FoldRequest = FoldRequest.none;
    attribute mirrorHeat: bool = false;
    attribute alive: uint = 0;
    attribute idleTicks: uint = 0;
    attribute busAsleep: bool = false;
    attribute connected: bool = true;
    attribute wakePulses: uint = 0;
    operation unplug() {
      /** Bench fault injection: the panel connector is disconnected. */
      connected = false;
    }
    operation respond() {
      if (not connected) {
        return;
      }
      alive = (alive + 1) % 256;
      idleTicks = 0;
      busAsleep = false;
      publish bus.response(record LinResponse {
        switches = record SwitchFrame { window = window; lock = lock; mirror = mirror; side = side; fold = fold; mirrorHeat = mirrorHeat; };
        alive = alive;
        valid = true;
      });
    }
    operation contactChanged() {
      if (busAsleep and connected) {
        wakePulses = wakePulses + 1;
        publish wake.wakeup();
      }
    }
    operation onWindow(value: WindowRequest) {
      window = value;
      contactChanged();
    }
    operation onLock(value: LockRequest) {
      lock = value;
      contactChanged();
    }
    operation onMirror(value: MirrorRequest) {
      mirror = value;
      contactChanged();
    }
    operation onSide(value: MirrorSide) {
      side = value;
    }
    operation onFold(value: FoldRequest) {
      fold = value;
      contactChanged();
    }
    operation onHeat(value: bool) {
      mirrorHeat = value;
      contactChanged();
    }
    operation monitorBus() {
      idleTicks = idleTicks + 1;
      if (idleTicks >= 2) {
        busAsleep = true;
      }
    }
    schedule {
      on receive bus.header() respond() deadline 1ms;
      on receive contacts.window(value) onWindow(value);
      on receive contacts.lock(value) onLock(value);
      on receive contacts.mirror(value) onMirror(value);
      on receive contacts.side(value) onSide(value);
      on receive contacts.fold(value) onFold(value);
      on receive contacts.mirrorHeat(value) onHeat(value);
      on every 100ms monitorBus();
    }
  }

  component def DoorMechanics {
    /**
     * Test-bench plant model of the door, not ECU software: window regulator with motor
     * inrush, running and 32 A stall current, a pinch force rising by 2 N per millisecond of
     * blocked travel and 40 mA per newton, Hall counter (0.45 mm per count, 0 is fully
     * closed), latch, lock actuator with position switch, fold motor with end stop, heater
     * and lamps. The bench can block the regulator, freeze the Hall counter and jam the
     * lock actuator.
     */
    reversed port drive: EcuOutputs;
    port sensors: EcuInputs;
    reversed port occupant: PassengerInteraction;
    reversed port supply: SupplyTerminal;
    const attribute countsPerMs: real = 0.3 /** Window speed at 100 % duty and 13.5 V, about 135 mm/s. */;
    const attribute runningMa: real = 5500.0;
    const attribute inrushMa: real = 16000.0;
    const attribute stallMa: real = 32000.0;
    const attribute maPerNewton: real = 40.0;
    const attribute newtonPerMs: real = 2.0;
    const attribute handAtCounts: real = 150.0 /** An obstacle 68 mm below the closed position. */;
    const attribute openCounts: real = 1000.0;
    attribute position: real = 250.0 /** Initially open by about 110 mm. */;
    attribute motor: MotorCommand = record MotorCommand { direction = MotorDirection.stop; dutyPercent = 0; };
    attribute motorRunMs: uint = 0;
    attribute pinchForceN: real = 0.0;
    attribute peakPinchForceN: real = 0.0;
    attribute currentMa: real = 0.0;
    attribute handInWindow: bool = false;
    attribute doorOpen: bool = false;
    attribute regulatorBlocked: bool = false;
    attribute hallFrozen: bool = false;
    attribute frozenHall: uint = 0;
    attribute lockJammed: bool = false;
    attribute lockDrive: LockDrive = LockDrive.idle;
    attribute lockDriveMs: uint = 0;
    attribute boltLocked: bool = false;
    attribute foldDrive: FoldRequest = FoldRequest.none;
    attribute foldMs: uint = 0;
    attribute mirrorFolded: bool = false;
    attribute mirrorMotors: MirrorDrive = record MirrorDrive { horizontal = 0; vertical = 0; };
    attribute heaterPercent: uint = 0;
    attribute puddlePercent: uint = 0;
    attribute courtesyPercent: uint = 0;
    attribute supplyMv: uint = 13500;
    attribute changed: bool = true;
    attribute lastSample: PinInputs = record PinInputs {
      hallCount = 0;
      currentRaw = 0;
      supplyRaw = 0;
      latchPrimary = false;
      latchSecondary = false;
      lockSwitchLocked = false;
      foldEndStop = false;
    } /** The last converted sample: conversions run every step while the window motor runs, otherwise only on a change. */;
    operation blockRegulator(value: bool) {
      /** Bench fault injection: the regulator is mechanically blocked. */
      regulatorBlocked = value;
    }
    operation freezeHall(value: bool) {
      /** Bench fault injection: the Hall counter stops counting. */
      hallFrozen = value;
      frozenHall = trunc(position);
    }
    operation jamLockActuator(value: bool) {
      /** Bench fault injection: the lock bolt does not move. */
      lockJammed = value;
    }
    operation setMotor(command: MotorCommand) {
      if (command.direction != motor.direction) {
        motorRunMs = 0;
      }
      motor = command;
      changed = true;
    }
    operation setLock(value: LockDrive) {
      if (value != lockDrive) {
        lockDriveMs = 0;
      }
      lockDrive = value;
      changed = true;
    }
    operation setFold(value: FoldRequest) {
      if (value != foldDrive) {
        foldMs = 0;
      }
      foldDrive = value;
      changed = true;
    }
    operation setMirror(value: MirrorDrive) {
      mirrorMotors = value;
    }
    operation setHeater(value: uint) {
      heaterPercent = value;
    }
    operation setPuddle(value: uint) {
      puddlePercent = value;
    }
    operation setCourtesy(value: uint) {
      courtesyPercent = value;
    }
    operation setHand(value: bool) {
      handInWindow = value;
    }
    operation setHandle(value: bool) {
      doorOpen = value;
      changed = true;
    }
    operation setSupply(value: uint) {
      supplyMv = value;
      changed = true;
    }
    operation moveWindow(stepMs: uint) {
      var speed: real = countsPerMs * motor.dutyPercent / 100.0 * supplyMv / 13500.0;
      motorRunMs = motorRunMs + stepMs;
      var load: real = runningMa;
      if (motorRunMs <= 30) {
        load = inrushMa;
      }
      if (regulatorBlocked) {
        if (motorRunMs > 30) {
          load = stallMa;
        }
      } else {
        if (motor.direction == MotorDirection.up) {
          if (handInWindow and position <= handAtCounts) {
            pinchForceN = pinchForceN + newtonPerMs * stepMs;
            if (pinchForceN > peakPinchForceN) {
              peakPinchForceN = pinchForceN;
            }
            load = min(runningMa + pinchForceN * maPerNewton, stallMa);
          } else {
            position = max(position - speed * stepMs, 0.0);
            if (position <= 0.0) {
              load = stallMa;
            }
          }
        } else {
          pinchForceN = 0.0;
          position = min(position + speed * stepMs, openCounts);
          if (position >= openCounts) {
            load = stallMa;
          }
        }
      }
      currentMa = load;
    }
    operation step() {
      /** 10 ms plant step: integrate the active actuators, then trigger a conversion of the connector inputs. */
      var windowActive: bool = motor.direction != MotorDirection.stop and motor.dutyPercent > 0 and supplyMv >= 6000;
      if (not changed and not windowActive and lockDrive == LockDrive.idle and foldDrive == FoldRequest.none) {
        return;
      }
      changed = false;
      if (windowActive) {
        moveWindow(10);
      } else {
        currentMa = 0.0;
        pinchForceN = 0.0;
      }
      if (lockDrive != LockDrive.idle and not lockJammed) {
        lockDriveMs = lockDriveMs + 10;
        if (lockDriveMs >= 120) {
          boltLocked = lockDrive == LockDrive.lockPulse;
        }
      }
      if (foldDrive != FoldRequest.none) {
        foldMs = foldMs + 10;
        if (foldMs >= 800) {
          mirrorFolded = foldDrive == FoldRequest.fold;
        }
      }
      var hall: uint = trunc(position);
      if (hallFrozen) {
        hall = frozenHall;
      }
      var sample: PinInputs = record PinInputs {
        hallCount = hall;
        currentRaw = trunc(min(currentMa / 10.0, 4095.0));
        supplyRaw = trunc(supplyMv / 5.0);
        latchPrimary = not doorOpen;
        latchSecondary = not doorOpen;
        lockSwitchLocked = boltLocked;
        foldEndStop = foldDrive != FoldRequest.none and foldMs >= 800;
      };
      if (windowActive or sample != lastSample) {
        lastSample = sample;
        send sensors.inputs(sample);
      }
    }
    schedule {
      on receive drive.windowBridge(command) setMotor(command);
      on receive drive.lockMotor(value) setLock(value);
      on receive drive.mirrorMotors(value) setMirror(value);
      on receive drive.foldMotor(value) setFold(value);
      on receive drive.mirrorHeaterPercent(value) setHeater(value);
      on receive drive.puddleLampPercent(value) setPuddle(value);
      on receive drive.courtesyLampPercent(value) setCourtesy(value);
      on receive occupant.handInWindow(value) setHand(value);
      on receive occupant.innerHandle(value) setHandle(value);
      on receive supply.batteryMv(value) setSupply(value);
      on every 10ms step();
    }
  }

  component def ExternalWatchdog {
    /** Window watchdog of the system basis chip: expects at least one trigger edge per 100 ms unless in low-power mode. */
    reversed port line: WatchdogLine;
    attribute edges: uint = 0;
    attribute lowPower: bool = false;
    attribute windows: uint = 0;
    attribute expirations: uint = 0;
    operation onTrigger(level: bool) {
      edges = edges + 1;
    }
    operation onLowPower(value: bool) {
      lowPower = value;
    }
    operation checkWindow() {
      windows = windows + 1;
      if (edges == 0 and not lowPower) {
        expirations = expirations + 1;
      }
      edges = 0;
    }
    schedule {
      on receive line.trigger(level) onTrigger(level);
      on receive line.lowPower(value) onLowPower(value);
      on every 100ms checkWindow();
    }
  }

  component def Driver {
    /** Actor: the driver, operating the door switch panel. */
    port contacts: SwitchContacts;
  }
  component def Passenger {
    /** Actor: an occupant who opens the door or has a hand in the window opening. */
    port body: PassengerInteraction;
  }
  component def BodyControlModule {
    /** Actor: the body control module on body CAN (vehicle status, key fob, crash signal). */
    port bus: BodyCan;
  }
  component def DiagnosticTester {
    /** Actor: an off-board diagnostic tester on the diagnostic CAN channel. */
    reversed port uds: Diagnostics;
  }
  component def PowerSupply {
    /** Actor: the vehicle power net supplying the door module. */
    port terminal: SupplyTerminal;
  }

  // ------------------------------------------------------------------- platform

  component def OsTask specializes Process {
    /**
     * An OS task: period (0 for an event-activated task or interrupt), response bound of an
     * event task, priority (higher wins) and category. The values document the target
     * configuration; the reference run does not schedule by them.
     */
    const attribute periodUs: uint = 0;
    const attribute responseUs: uint = 0;
    const attribute priority: uint = 0;
    const attribute category: string = "basic";
  }
  component def SafetyCore specializes Partition {
    /** Core 0: sensing, actuation, window, lock, mode management and supervision. */
    const attribute clockMhz: uint = 160;
    component isrAdc: OsTask {
      redefines const attribute responseUs: uint = 500;
      redefines const attribute priority: uint = 60;
      redefines const attribute category: string = "isr2";
    }
    component taskEventHigh: OsTask {
      redefines const attribute responseUs: uint = 1000;
      redefines const attribute priority: uint = 50;
    }
    component taskEventLow: OsTask {
      redefines const attribute responseUs: uint = 10000;
      redefines const attribute priority: uint = 15;
    }
    component task20ms: OsTask {
      redefines const attribute periodUs: uint = 20000;
      redefines const attribute priority: uint = 30;
    }
    component task40ms: OsTask {
      redefines const attribute periodUs: uint = 40000;
      redefines const attribute priority: uint = 28;
    }
    component task50ms: OsTask {
      redefines const attribute periodUs: uint = 50000;
      redefines const attribute priority: uint = 25;
    }
  }
  component def ComfortCore specializes Partition {
    /** Core 1: communication, diagnostics, comfort functions and memory services. */
    const attribute clockMhz: uint = 160;
    component isrCan: OsTask {
      redefines const attribute responseUs: uint = 500;
      redefines const attribute priority: uint = 60;
      redefines const attribute category: string = "isr2";
    }
    component taskDem: OsTask {
      redefines const attribute responseUs: uint = 2000;
      redefines const attribute priority: uint = 40;
    }
    component task20ms: OsTask {
      redefines const attribute periodUs: uint = 20000;
      redefines const attribute priority: uint = 30;
    }
    component task50ms: OsTask {
      redefines const attribute periodUs: uint = 50000;
      redefines const attribute priority: uint = 25;
    }
    component task100ms: OsTask {
      redefines const attribute periodUs: uint = 100000;
      redefines const attribute priority: uint = 20;
    }
    component taskEventLow: OsTask {
      redefines const attribute responseUs: uint = 5000;
      redefines const attribute priority: uint = 18;
    }
    component taskDcm: OsTask {
      redefines const attribute responseUs: uint = 50000;
      redefines const attribute priority: uint = 12;
    }
    component taskBackground: OsTask {
      redefines const attribute responseUs: uint = 100000;
      redefines const attribute priority: uint = 1;
      redefines const attribute category: string = "extended";
    }
  }
  component def DoorModule specializes Node {
    /** Door module hardware: a dual-core automotive microcontroller with CAN and LIN. */
    const attribute flashKb: uint = 1024;
    const attribute ramKb: uint = 128;
    const attribute ref: string = "sysml:BodyDomain::DoorModule";
    component core0: SafetyCore;
    component core1: ComfortCore;
  }
  component def LinSlaveNode specializes Node {
    const attribute ref: string = "sysml:BodyDomain::DriverSwitchPanel";
  }
  component def BodyPlatform specializes Platform {
    /** Body domain hardware: four door modules (FL, FR, RL, RR) and the switch panel. */
    component doorModules: DoorModule[4];
    component switchPanelNode: LinSlaveNode;
  }

  // ----------------------------------------------------------- package context

  component dcu: DoorControlUnit;
  component switchPanel: LinSwitchPanel;
  component door: DoorMechanics;
  component watchdogIc: ExternalWatchdog;
  component driver: Driver;
  component passenger: Passenger;
  component bcm: BodyControlModule;
  component tester: DiagnosticTester;
  component supply: PowerSupply;
  component vehicle: BodyPlatform;

  connect connector (door.sensors, dcu.pins);
  connect harness (dcu.outputs, door.drive);
  connect lin: LinSlot (switchPanel.bus, dcu.linBus);
  connect linWakeLine (switchPanel.wake, dcu.linWake);
  connect bodyCan: BodyCanFrames (bcm.bus, dcu.canBus);
  connect diagnosticCan: UdsSession (tester.uds, dcu.uds);
  connect watchdogTrigger (dcu.wdgLine, watchdogIc.line);
  connect (driver.contacts, switchPanel.contacts);
  connect (passenger.body, door.occupant);
  connect (supply.terminal, door.supply);

  deployment 'Front left door' of dcu on vehicle {
    /**
     * Task mapping of the front-left door module. Each occurrence is placed on the one task
     * of its deadline-carrying runnables: a periodic task whose period divides the periods
     * of its runnables and does not exceed their deadlines' release grid, or an interrupt or
     * event task whose response bound is at most the smallest deadline it serves. Crash
     * chain budget: CAN interrupt 1 ms, CrossCore route 1 ms, lock state machine on the
     * 1 ms event task, lock output 1 ms: at most 4 ms against the 10 ms requirement.
     */
    deploy on doorModules[0];
    deploy ioIn on doorModules[0].core0.isrAdc;
    deploy ioOut on doorModules[0].core0.taskEventHigh;
    deploy antiPinch on doorModules[0].core0.taskEventHigh;
    deploy window on doorModules[0].core0.taskEventHigh;
    deploy lock on doorModules[0].core0.taskEventHigh;
    deploy switches on doorModules[0].core0.taskEventHigh;
    deploy ecuMode on doorModules[0].core0.taskEventLow;
    deploy linIf on doorModules[0].core0.task20ms;
    deploy latch on doorModules[0].core0.task20ms;
    deploy wdgM on doorModules[0].core0.task40ms;
    deploy supply on doorModules[0].core0.task50ms;
    deploy canIf on doorModules[0].core1.isrCan;
    deploy dem on doorModules[0].core1.taskDem;
    deploy comMain on doorModules[0].core1.task20ms;
    deploy lamps on doorModules[0].core1.task50ms;
    deploy heater on doorModules[0].core1.task100ms;
    deploy lighting on doorModules[0].core1.task100ms;
    deploy mirror on doorModules[0].core1.taskEventLow;
    deploy dcm on doorModules[0].core1.taskDcm;
    deploy nvm on doorModules[0].core1.taskBackground;
  }
  deployment 'Switch panel' of switchPanel on vehicle {
    deploy on switchPanelNode;
  }

  // ------------------------------------------------------------ cases and tests

  use case 'Lock and unlock' of dcu {
    /** The driver locks and unlocks with the panel; the key fob locks through the body control module. */
    send driver.contacts.lock(LockRequest.lock);
    on receive bcm.bus.lockStatus(reported) {
      assert reported == LockState.locked;
    } or after 400ms {
      fail "the door did not lock";
    }
    send driver.contacts.lock(LockRequest.none);
    wait 40ms;
    send driver.contacts.lock(LockRequest.unlock);
    on receive bcm.bus.lockStatus(reported) {
      assert reported == LockState.unlocked;
    } or after 400ms {
      fail "the door did not unlock";
    }
    publish bcm.bus.centralLock(LockRequest.lock);
    on receive bcm.bus.lockStatus(reported) {
      assert reported == LockState.locked;
    } or after 400ms {
      fail "the key fob did not lock the door";
    }
  }

  use case 'Close the window with one touch' of dcu {
    /** With the ignition on, a single tap of the one-touch detent closes the window; DoorStatusFL reports the closed position. */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = 0; });
    send driver.contacts.window(WindowRequest.autoUp);
    wait 50ms;
    send driver.contacts.window(WindowRequest.neutral);
    for (var cycle: uint = 1; cycle <= 10; cycle = cycle + 1) {
      wait 100ms;
      send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = cycle; });
    }
    on receive bcm.bus.doorStatus(status) {
      assert status.windowCounts <= 6 and not status.pinchActive;
    } or after 200ms {
      fail "no door status";
    }
  }

  use case 'Read fault memory' of dcu {
    /** The supply drops below 9 V; a tester reads the confirmed undervoltage code and the supply voltage, then clears the fault memory. */
    send supply.terminal.batteryMv(8000);
    wait 400ms;
    var status: DtcStatus = tester.uds.readDtcStatus(10100758);
    assert status.confirmed and status.testFailed;
    var supplyMv: uint = tester.uds.readData(64769);
    assert supplyMv >= 7900 and supplyMv <= 8100;
    send supply.terminal.batteryMv(13500);
    wait 300ms;
    var cleared: uint = tester.uds.clearDtcs();
    assert cleared == 1;
    var empty: DtcStatus = tester.uds.readDtcStatus(10100758);
    assert not empty.confirmed;
  }

  use case 'Wake on door handle' of dcu {
    /** The ECU sleeps after ignition off and bus silence; opening the door wakes it and the door status reports the open door. */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = false; rolling = 1; });
    wait 1700ms;
    send passenger.body.innerHandle(true);
    var reported: bool = false;
    until (reported, 5 times) {
      on receive bcm.bus.doorStatus(status) {
        reported = status.ajar and status.powerMode == PowerMode.postRun;
      } or after 300ms {
        fail "the door control unit did not wake";
      }
    }
    assert reported;
  }

  use case 'Comfort close from the key fob' of dcu {
    /** A long press on the key fob makes the body control module request a comfort close over CAN. */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = 0; });
    publish bcm.bus.comfortClose();
    var closed: bool = false;
    until (closed, 15 times) {
      on receive bcm.bus.doorStatus(status) {
        closed = status.windowCounts <= 6;
      } or after 200ms {
        fail "no door status";
      }
    }
    assert closed;
  }

  test 'Mirror adjust, heat and remote side' of dcu {
    /** The joystick drives the local mirror while held, the heater switches on, and the passenger side is commanded over CAN. */
    send driver.contacts.mirror(MirrorRequest.left);
    wait 80ms;
    assert door.mirrorMotors.horizontal == -1 and door.mirrorMotors.vertical == 0;
    send driver.contacts.mirror(MirrorRequest.none);
    wait 80ms;
    assert door.mirrorMotors.horizontal == 0;
    send driver.contacts.mirrorHeat(true);
    wait 180ms;
    assert door.heaterPercent == 70 and dcu.heater.heating;
    send driver.contacts.side(MirrorSide.passenger);
    send driver.contacts.mirror(MirrorRequest.up);
    on receive bcm.bus.remoteMirror(direction) {
      assert direction == MirrorRequest.up;
    } or after 200ms {
      fail "the passenger mirror request was not sent";
    }
    assert door.mirrorMotors.vertical == 0;
  }

  test 'Pinch reversal' of dcu {
    /**
     * One-touch close with a hand in the opening 68 mm below the closed position: the window
     * reverses before 100 N, opens by the reversal distance and reports the pinch.
     */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = 0; });
    send passenger.body.handInWindow(true);
    send driver.contacts.window(WindowRequest.autoUp);
    wait 50ms;
    send driver.contacts.window(WindowRequest.neutral);
    for (var cycle: uint = 1; cycle <= 14; cycle = cycle + 1) {
      wait 100ms;
      send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = cycle; });
    }
    assert dcu.window.pinchReversals == 1;
    assert dcu.antiPinch.pinchEvents == 1 and not dcu.antiPinch.reversing;
    assert door.peakPinchForceN > 0.0 and door.peakPinchForceN < 100.0;
    assert door.position >= 420.0;
    assert door.motor.direction == MotorDirection.stop;
    on receive bcm.bus.doorStatus(status) {
      assert status.pinchActive;
    } or after 200ms {
      fail "no door status";
    }
  }

  test 'Pinch protection after an interrupted reversal' of dcu {
    /**
     * The supply collapses to 5.5 V during a reversal, so the window stalls and the reversal
     * ends at its time limit. After recovery, a new one-touch close detects the same
     * obstacle again before 100 N.
     */
    send passenger.body.handInWindow(true);
    send driver.contacts.window(WindowRequest.autoUp);
    wait 50ms;
    send driver.contacts.window(WindowRequest.neutral);
    until (dcu.antiPinch.pinchEvents == 1, 60 times) {
      wait 10ms;
    }
    wait 100ms;
    send supply.terminal.batteryMv(5500);
    wait 1150ms;
    assert door.motor.direction == MotorDirection.stop;
    assert dcu.window.runTimeouts == 1 and not dcu.antiPinch.reversing;
    send supply.terminal.batteryMv(13500);
    wait 300ms;
    assert dcu.window.permission.windowMotion;
    send driver.contacts.window(WindowRequest.autoUp);
    wait 50ms;
    send driver.contacts.window(WindowRequest.neutral);
    wait 400ms;
    assert dcu.antiPinch.pinchEvents == 2 and dcu.window.pinchReversals == 2;
    assert door.peakPinchForceN < 100.0;
  }

  test 'One-touch close learns the closed stop' of dcu {
    /** A complete one-touch close stops at the soft stop and learns the closed position for NVRAM. */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = 0; });
    send driver.contacts.window(WindowRequest.autoUp);
    wait 50ms;
    send driver.contacts.window(WindowRequest.neutral);
    for (var cycle: uint = 1; cycle <= 10; cycle = cycle + 1) {
      wait 100ms;
      send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = cycle; });
    }
    assert door.position <= 6.0;
    assert door.motor.direction == MotorDirection.stop;
    assert dcu.window.oneTouchCloses == 1 and dcu.window.pinchReversals == 0;
    assert dcu.antiPinch.cal.learned;
    assert dcu.nvm.dirty;
    var learned: uint = tester.uds.readData(64771);
    assert learned == 1;
  }

  test 'Crash unlocks a locked door' of dcu {
    /** A crash signal unlocks a door locked by the key fob within 10 ms and inhibits auto-lock afterwards. */
    publish bcm.bus.centralLock(LockRequest.lock);
    on receive bcm.bus.lockStatus(reported) {
      assert reported == LockState.locked;
    } or after 400ms {
      fail "the door did not lock";
    }
    assert door.boltLocked;
    publish bcm.bus.crash(3);
    wait 10ms;
    assert door.lockDrive == LockDrive.unlockPulse;
    on receive bcm.bus.lockStatus(reported) {
      assert reported == LockState.unlocked;
    } or after 300ms {
      fail "no crash unlock";
    }
    assert dcu.lock.crashLatched and not door.boltLocked;
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 40.0; ignitionOn = true; rolling = 1; });
    wait 100ms;
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 42.0; ignitionOn = true; rolling = 2; });
    wait 400ms;
    assert not dcu.lock.locked and not dcu.lock.autoLocked;
  }

  test 'Auto-lock by speed' of dcu {
    /** The door locks once when the speed passes 15 km/h and the mirror folds; unlocking with the panel unfolds it. */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 5.0; ignitionOn = true; rolling = 1; });
    wait 100ms;
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 12.0; ignitionOn = true; rolling = 2; });
    wait 100ms;
    assert not dcu.lock.locked;
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 18.0; ignitionOn = true; rolling = 3; });
    on receive bcm.bus.lockStatus(reported) {
      assert reported == LockState.locked;
    } or after 400ms {
      fail "no auto-lock";
    }
    assert dcu.lock.autoLocked and not dcu.lock.autoLockArmed;
    wait 900ms;
    assert door.mirrorFolded and dcu.mirror.folded and dcu.mirror.foldTimeouts == 0;
    send driver.contacts.lock(LockRequest.unlock);
    on receive bcm.bus.lockStatus(reported) {
      assert reported == LockState.unlocked;
    } or after 400ms {
      fail "the panel did not unlock";
    }
    wait 900ms;
    assert not door.mirrorFolded and not dcu.mirror.folded and dcu.mirror.foldMoves == 2;
  }

  test 'Bus timeout fallback' of dcu {
    /**
     * A frame with a repeated alive counter is ignored; 500 ms after the last valid frame the
     * speed is substituted as invalid, the timeout is confirmed in the fault memory and
     * auto-lock acts again once valid frames return.
     */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 8.0; ignitionOn = true; rolling = 1; });
    wait 100ms;
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 9.0; ignitionOn = true; rolling = 2; });
    wait 200ms;
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 9.0; ignitionOn = true; rolling = 2; });
    wait 290ms;
    assert not dcu.comMain.timedOut and dcu.comMain.aliveErrors == 1;
    wait 60ms;
    assert dcu.comMain.timedOut and dcu.comMain.timeouts == 1;
    assert not dcu.comMain.lastSignals.speedValid and dcu.comMain.lastSignals.ignitionOn;
    assert dcu.ecuMode.current == PowerMode.run;
    wait 300ms;
    var status: DtcStatus = tester.uds.readDtcStatus(12664967);
    assert status.confirmed and status.testFailed;
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 20.0; ignitionOn = true; rolling = 3; });
    wait 30ms;
    assert not dcu.comMain.timedOut and dcu.comMain.lastSignals.speedValid;
    on receive bcm.bus.lockStatus(reported) {
      assert reported == LockState.locked;
    } or after 400ms {
      fail "no auto-lock after the bus recovered";
    }
  }

  test 'Sleep and wake' of dcu {
    /**
     * Ignition off and bus silence: post-run, ready-sleep, write-all and sleep with the
     * watchdog in low-power mode; a LIN wake-up from the switch panel wakes the ECU into
     * post-run.
     */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = 1; });
    wait 100ms;
    assert dcu.ecuMode.current == PowerMode.run;
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = false; rolling = 2; });
    wait 100ms;
    assert dcu.ecuMode.current == PowerMode.postRun;
    wait 1000ms;
    assert dcu.ecuMode.current == PowerMode.readySleep;
    wait 600ms;
    assert dcu.ecuMode.current == PowerMode.sleep and dcu.ecuMode.sleeps == 1;
    assert dcu.nvm.writeAllRequests == 1 and dcu.ecuMode.nvmStored;
    assert watchdogIc.lowPower and watchdogIc.expirations == 0;
    wait 200ms;
    send driver.contacts.window(WindowRequest.manualDown);
    wait 100ms;
    assert switchPanel.wakePulses == 1;
    assert dcu.ecuMode.lastWake == WakeSource.lin and dcu.ecuMode.wakeups == 1;
    assert dcu.ecuMode.current == PowerMode.postRun;
  }

  test 'Bus keeps the ECU awake after ignition off' of dcu {
    /** While the body control module keeps sending after ignition off, the ECU stays in ready-sleep; 500 ms after the bus falls silent it sleeps. */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = 0; });
    wait 100ms;
    for (var cycle: uint = 1; cycle <= 20; cycle = cycle + 1) {
      send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = false; rolling = cycle % 16; });
      wait 100ms;
    }
    assert dcu.ecuMode.current == PowerMode.readySleep;
    assert dcu.ecuMode.sleeps == 0 and dcu.nvm.writeAllRequests == 0;
    wait 600ms;
    assert dcu.ecuMode.current == PowerMode.sleep and dcu.ecuMode.sleeps == 1;
    assert dcu.nvm.writeAllRequests == 1;
  }

  test 'Calibration stored at shutdown' of dcu {
    /** A first complete close in post-run marks the window calibration learned; the write-all at shutdown stores the block. */
    send driver.contacts.window(WindowRequest.autoUp);
    wait 50ms;
    send driver.contacts.window(WindowRequest.neutral);
    wait 900ms;
    assert dcu.nvm.dirty and not dcu.nvm.nvBlock.learned;
    wait 650ms;
    assert dcu.ecuMode.current == PowerMode.sleep;
    assert dcu.nvm.writeCycles == 1 and not dcu.nvm.dirty and dcu.nvm.nvBlock.learned;
  }

  test 'Undervoltage fault reported' of dcu {
    /**
     * The supply drops to 8 V: the first pre-failed report does not confirm, the second
     * does, window motion is inhibited, 9.2 V does not recover it, 13.5 V does, and the
     * tester reads and clears the code.
     */
    send supply.terminal.batteryMv(8000);
    var counters: int[6] = dcu.dem.counters;
    until (counters[3] > 0, 50 times) {
      wait 10ms;
      counters = dcu.dem.counters;
    }
    var first: DtcStatus = tester.uds.readDtcStatus(10100758);
    assert counters[3] == 64 and not first.confirmed;
    wait 110ms;
    var failed: DtcStatus = tester.uds.readDtcStatus(10100758);
    assert failed.confirmed and failed.testFailed;
    assert not dcu.window.permission.windowMotion;
    send driver.contacts.window(WindowRequest.manualDown);
    wait 200ms;
    assert door.position == 250.0;
    send driver.contacts.window(WindowRequest.neutral);
    send supply.terminal.batteryMv(9200);
    wait 300ms;
    assert dcu.supply.undervoltage and not dcu.window.permission.windowMotion;
    send supply.terminal.batteryMv(13500);
    wait 300ms;
    var recovered: DtcStatus = tester.uds.readDtcStatus(10100758);
    assert recovered.confirmed and not recovered.testFailed;
    assert dcu.window.permission.windowMotion;
    var cleared: uint = tester.uds.clearDtcs();
    assert cleared == 1;
  }

  test 'Undervoltage stops a moving window' of dcu {
    /** The supply drops to 8 V while the window opens with the switch held: the window stops although the switch is still pressed. */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = 0; });
    send driver.contacts.window(WindowRequest.manualDown);
    wait 150ms;
    assert door.motor.direction == MotorDirection.down;
    send supply.terminal.batteryMv(8000);
    wait 450ms;
    assert not dcu.window.permission.windowMotion and dcu.window.inhibitedStops == 1;
    assert door.motor.direction == MotorDirection.stop;
    var stoppedAt: real = door.position;
    wait 100ms;
    assert door.position == stoppedAt;
  }

  test 'Watchdog serviced' of dcu {
    /** With every supervised entity alive, the external watchdog is triggered in every window. */
    wait 1s;
    assert not dcu.wdgM.expired and dcu.wdgM.failedWindows == 0;
    assert dcu.wdgM.triggers >= 24;
    assert watchdogIc.windows >= 9 and watchdogIc.expirations == 0;
  }

  test 'Watchdog stops on a supervision failure' of dcu {
    /** Extra alive indications of one entity (it runs too often) fail the window; triggering stops and the external watchdog expires. */
    wait 300ms;
    dcu.wdgM.checkpoint(SupervisedEntity.communication);
    dcu.wdgM.checkpoint(SupervisedEntity.communication);
    dcu.wdgM.checkpoint(SupervisedEntity.communication);
    dcu.wdgM.checkpoint(SupervisedEntity.communication);
    wait 300ms;
    assert dcu.wdgM.expired and dcu.wdgM.failedWindows == 1;
    var triggersAfterFailure: uint = dcu.wdgM.triggers;
    wait 200ms;
    assert dcu.wdgM.triggers == triggersAfterFailure;
    assert watchdogIc.expirations >= 2;
  }

  test 'Courtesy light afterglow' of dcu {
    /** Opening the door lights both lamps with a soft start; after closing, the courtesy lamp stays on for the afterglow. */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = 0; });
    send passenger.body.innerHandle(true);
    wait 400ms;
    assert dcu.latch.ajar and dcu.latch.latchState == LatchState.open;
    assert door.courtesyPercent == 100 and door.puddlePercent == 100;
    send passenger.body.innerHandle(false);
    wait 1s;
    assert not dcu.latch.ajar;
    assert door.courtesyPercent == 100 and door.puddlePercent == 0;
    wait 1600ms;
    assert door.courtesyPercent == 0;
  }

  test 'Debounced switch and latch inputs' of dcu {
    /**
     * A lock contact shorter than one LIN slot and a 30 ms latch bounce are filtered; a real
     * lock press then locks within 400 ms.
     */
    send driver.contacts.lock(LockRequest.lock);
    send passenger.body.innerHandle(true);
    wait 25ms;
    send driver.contacts.lock(LockRequest.none);
    wait 5ms;
    send passenger.body.innerHandle(false);
    wait 370ms;
    assert not dcu.lock.locked and dcu.lock.lockCycles == 0;
    assert not dcu.latch.ajar and dcu.lighting.afterglowLeft == 0 and door.courtesyPercent == 0;
    send driver.contacts.lock(LockRequest.lock);
    on receive bcm.bus.lockStatus(reported) {
      assert reported == LockState.locked;
    } or after 400ms {
      fail "the panel did not lock within 400 ms";
    }
    assert door.boltLocked;
  }

  test 'Switch panel lost' of dcu {
    /** The panel connector is unplugged while the driver holds the window switch: from the fifth missed slot the switches are neutral, the window stops and the LIN fault is confirmed. */
    send bcm.bus.vehicleStatus(record VehicleStatusPdu { speedKph = 0.0; ignitionOn = true; rolling = 0; });
    send driver.contacts.window(WindowRequest.manualDown);
    wait 150ms;
    assert door.motor.direction == MotorDirection.down;
    switchPanel.unplug();
    wait 200ms;
    assert dcu.linIf.missed >= 5;
    assert door.motor.direction == MotorDirection.stop;
    wait 200ms;
    var status: DtcStatus = tester.uds.readDtcStatus(12728199);
    assert status.confirmed;
  }

  test 'Hall sensor fault disables one-touch' of dcu {
    /** A frozen Hall counter stops the motor twice and confirms the Hall fault; a one-touch request then only moves the window while the switch is held. */
    door.freezeHall(true);
    send driver.contacts.window(WindowRequest.manualDown);
    wait 250ms;
    assert door.motor.direction == MotorDirection.stop;
    send driver.contacts.window(WindowRequest.neutral);
    wait 60ms;
    send driver.contacts.window(WindowRequest.manualDown);
    wait 250ms;
    assert door.motor.direction == MotorDirection.stop;
    assert not dcu.window.permission.oneTouch;
    send driver.contacts.window(WindowRequest.neutral);
    door.freezeHall(false);
    wait 60ms;
    send driver.contacts.window(WindowRequest.autoUp);
    wait 150ms;
    assert door.motor.direction == MotorDirection.up;
    send driver.contacts.window(WindowRequest.neutral);
    wait 80ms;
    assert door.motor.direction == MotorDirection.stop and dcu.window.oneTouchCloses == 0;
  }

  test 'Blocked window trips the bridge' of dcu {
    /** A blocked regulator draws stall current: the H-bridge trips at 30 A twice, the overcurrent code is confirmed and window motion is inhibited. */
    door.blockRegulator(true);
    send driver.contacts.window(WindowRequest.manualDown);
    wait 150ms;
    assert dcu.ioIn.trips == 1 and door.motor.direction == MotorDirection.stop;
    send driver.contacts.window(WindowRequest.neutral);
    wait 60ms;
    send driver.contacts.window(WindowRequest.manualDown);
    wait 150ms;
    assert dcu.ioIn.trips == 2 and door.motor.direction == MotorDirection.stop;
    assert not dcu.window.permission.windowMotion;
    send driver.contacts.window(WindowRequest.neutral);
    door.blockRegulator(false);
    wait 60ms;
    send driver.contacts.window(WindowRequest.manualDown);
    wait 150ms;
    assert door.motor.direction == MotorDirection.stop and door.position == 250.0;
  }

  test 'Lock actuator fault' of dcu {
    /** A jammed lock bolt makes two lock pulses fail their position check; the lock actuator code is confirmed. */
    door.jamLockActuator(true);
    publish bcm.bus.centralLock(LockRequest.lock);
    wait 300ms;
    publish bcm.bus.centralLock(LockRequest.unlock);
    wait 300ms;
    publish bcm.bus.centralLock(LockRequest.lock);
    wait 300ms;
    assert not door.boltLocked and dcu.lock.lockCycles == 3;
    var status: DtcStatus = tester.uds.readDtcStatus(10096647);
    assert status.confirmed and status.occurrences == 1;
  }

