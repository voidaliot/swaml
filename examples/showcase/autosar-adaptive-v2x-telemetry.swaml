  view architecture: General of app;
  view services: Interconnect of app;
  view 'deployment platform': General of vehicle;
  view 'V2X cases': Case of AdaptiveV2x;
  view 'awareness exchange': Sequence of 'Share awareness';
  view 'road hazard warning': Sequence of 'Warn driver of road hazard';
  view 'store and forward': Sequence of 'Offline store and forward';
  view inventory: Grid of app;
  view 'receive path': Flow of app.v2x.handleFrame;
  view 'hazard lifecycle': Flow of app.v2x.hazardLifecycle;
  view 'uplink session': Flow of app.uplink.session.session;
  view 'function group': Flow of app.stateManager.functionGroup;
  view 'awareness chain': Timing {
    /** Sensor sample to transmitted awareness message: gateway signal, state fusion, generation check, signing and channel transmission. */
    include app.vehicleState.onSpeed;
    include app.v2x.camCycle;
    include app.security.signDigest;
    include app.channels[0].transmit;
  }
  view 'warning chain': Timing {
    /** Received hazard to driver warning: channel delivery, verification and the receive path. */
    include app.channels[1].deliver;
    include app.v2x.handleFrame;
    include app.security.verifySignature;
  }
  view supervision: Timing of app.health.supervise;
}
