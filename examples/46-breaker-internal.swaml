package BreakerInternal {
  /** A persistence circuit breaker in the shape of the cloud model's PersistenceWriter. SelfBreaker keeps the shape of its 2.2 machine (migrated): every arrival in Closed leaves and reaches Closed again (to Closed), which exits and enters the state, and it trips only at the next arrival after the third failed write; in Open it leaves arrivals unhandled, so they are dropped. With states in the flow a line that does not leave stays: the state is not left, its entry does not run again and its timers keep running. InternalBreaker writes arrivals with a staying line, trips by the condition standing in Closed after that line, right after the third failed write, and counts the arrivals it sheds while Open without delaying the cool-down. */
  port def Stream {
    provides event accepted(t: uint);
  }
  port def StoreApi {
    provides operation put(t: uint) returns bool;
  }
  component def Store {
    /** Answers each put after 1 ms; while down, every put fails. */
    port api: StoreApi;
    attribute down: bool = false;
    attribute puts: uint = 0;
    operation handle(t: uint) returns bool {
      puts = puts + 1;
      wait 1ms;
      return not down and t >= 0;
    }
    operation setDown(value: bool) {
      down = value;
    }
    schedule {
      on call api.put(t) handle(t);
    }
  }
  component def InternalBreaker {
    /** The 3.0 shape. */
    reversed port stream: Stream;
    reversed port store: StoreApi;
    const attribute failureThreshold: uint = 3;
    attribute consecutiveFailures: uint = 0;
    attribute written: uint = 0;
    attribute shedArrivals: uint = 0;
    attribute trips: uint = 0;
    attribute halfOpenAtNs: uint = 0;
    operation write(t: uint) {
      var ok: bool = try(store.put(t), false);
      if (ok) {
        consecutiveFailures = 0;
        written = written + 1;
      } else {
        consecutiveFailures = consecutiveFailures + 1;
      }
    }
    operation circuit() {
      state Closed {
        on receive stream.accepted(t) {
          write(t);
        }
        if (consecutiveFailures >= failureThreshold) {
          trips = trips + 1;
          to Open;
        }
      }
      state Open {
        on receive stream.accepted(t) {
          shedArrivals = shedArrivals + 1;
        }
        after 20ms {
          halfOpenAtNs = Swaml::Time::now();
          exit;
        }
      }
      state HalfOpen {
        on entry {
          consecutiveFailures = 0;
        }
        on receive stream.accepted(t) {
          write(t);
          to Closed;
        }
      }
    }
    schedule {
      on start circuit();
    }
  }
  component def SelfBreaker {
    /** The 2.2 shape, migrated: the trip test leaves, and the statements after it are the 2.2 unguarded transition. */
    reversed port stream: Stream;
    reversed port store: StoreApi;
    const attribute failureThreshold: uint = 3;
    attribute consecutiveFailures: uint = 0;
    attribute written: uint = 0;
    attribute trips: uint = 0;
    attribute halfOpenAtNs: uint = 0;
    operation write(t: uint) {
      var ok: bool = try(store.put(t), false);
      if (ok) {
        consecutiveFailures = 0;
        written = written + 1;
      } else {
        consecutiveFailures = consecutiveFailures + 1;
      }
    }
    operation circuit() {
      state Closed {
        on receive stream.accepted(t) {
          if (consecutiveFailures >= failureThreshold) {
            trips = trips + 1;
            exit;
          }
          write(t);
          to Closed;
        }
      }
      state Open {
        after 20ms {
          halfOpenAtNs = Swaml::Time::now();
          exit;
        }
      }
      state HalfOpen {
        on entry {
          consecutiveFailures = 0;
        }
        on receive stream.accepted(t) {
          write(t);
          to Closed;
        }
      }
    }
    schedule {
      on start circuit();
    }
  }
  component def Feed {
    /** Interface-only actor that delivers arrivals to both breakers. */
    port toInternal: Stream;
    port toSelf: Stream;
  }
  component internal: InternalBreaker;
  component selfBreaker: SelfBreaker;
  component store: Store;
  component selfStore: Store;
  component feed: Feed;
  connect (internal.store, store.api);
  connect (selfBreaker.store, selfStore.api);
  connect (feed.toInternal, internal.stream);
  connect (feed.toSelf, selfBreaker.stream);
  associate feed, store, selfStore, selfBreaker to 'Store outage trips the breaker and recovers';
  test 'Store outage trips the breaker and recovers' of internal {
    /** Both stores are down; arrivals every 5 ms from 0 to 30 ms. The internal breaker trips right after its third failed write, at 11 ms, sheds the four arrivals at 15 to 30 ms while the cool-down keeps its epoch, and is half open at 31 ms. The breaker of the 2.2 shape trips only at the fourth arrival, at 15 ms, discards the arrivals while open and is half open at 35 ms. When the store is back, the next arrival closes both. */
    store.setDown(true);
    selfStore.setDown(true);
    for (var i: uint = 0; i <= 6; i = i + 1) {
      publish feed.toInternal.accepted(i);
      publish feed.toSelf.accepted(i);
      wait 5ms;
    }
    wait 1ms;
    assert internal.trips == 1 and internal.shedArrivals == 4 and internal.halfOpenAtNs == 31000000;
    assert selfBreaker.trips == 1 and selfBreaker.halfOpenAtNs == 35000000;
    assert store.puts == 3 and selfStore.puts == 3;
    store.setDown(false);
    selfStore.setDown(false);
    publish feed.toInternal.accepted(7);
    publish feed.toSelf.accepted(7);
    wait 5ms;
    assert internal.written == 1 and selfBreaker.written == 1 and internal.consecutiveFailures == 0;
  }
}
