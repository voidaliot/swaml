package States {
  import Swaml::Views;
  component Demo {
    attribute lit: bool = false;
    operation lamp() {
      state Off {
        after 2ms exit;
      }
      state On {
        on entry {
          lit = true;
        }
        on exit {
          lit = false;
        }
        after 3ms exit;
      }
      state Done {
      }
    }
    schedule {
      on start lamp();
    }
  }
  view states: Flow of Demo.lamp;
}
