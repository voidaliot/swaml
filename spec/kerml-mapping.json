    { "source": "Instance", "kernel": "Feature", "constraints": ["composite", "typed-by-definition", "multiplicity-one"] },
    { "source": "DataType", "kernel": "DataType", "constraints": ["value-semantics", "finite-record"] },
    { "source": "EnumType", "kernel": "DataType", "constraints": ["nominal-finite-domain"] },
    { "source": "Interface", "kernel": "Classifier", "constraints": ["nominal-versioned-contract", "member-kind"] },
