    { "source": "Send", "kernel": "SWAML-library-message-interaction", "constraints": ["typed-payload", "port-route", "emitter-provenance"] },
    { "source": "Request", "kernel": "SWAML-library-request-interaction", "constraints": ["correlation", "timeout", "result-or-failure"] }
