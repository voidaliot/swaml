{
  "languageVersion": "2.0",
  "source": "examples/16-requirements-and-views.swaml",
  "requirements": [
    {
      "id": "Traceability::Delivery",
      "attributes": [
        {
          "name": "description",
          "value": "\"Deliver startup message\""
        }
      ]
    }
  ],
  "satisfactions": [
    {
      "requirement": "Delivery",
      "source": "Demo.receiver",
      "status": "intent"
    }
  ],
  "cases": [
    {
      "name": "Startup",
      "kind": "verificationCase",
      "root": "Demo",
      "status": "inconclusive",
      "verify": [
        "Delivery"
      ],
      "steps": [
        {
          "name": "greeting",
          "kind": "publish",
          "source": "sender.output.message",
          "target": "receiver.input.message"
        }
      ]
    }
  ]
}
