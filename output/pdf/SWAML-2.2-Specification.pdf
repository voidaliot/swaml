            const key = (x.requirement.ref ? identity(x.requirement.ref) : x.requirement.$refText) + '|' + x.test.$refText;
            if (verified.has(key))
                this.report(x, 'SW2010', `Duplicate verify ${x.requirement.$refText} by ${x.test.$refText}.`);
            verified.add(key);
        }
    }
}

