"""Verify the sources embedded in an X.Y-named edition such as swa.ml 2.2.

The 1.x/2.0.0 helpers expect three-part revisions and stay unchanged for the
archived publications. A new edition always uses the strict current-source
gate: every embedded source must equal the canonical workspace bytes."""
from __future__ import annotations
import json
import re
from pathlib import Path, PurePosixPath
from typing import NamedTuple
from publication_archive import sha256, source_path


class PublicationInventory(NamedTuple):
    normative: list[str]
    guidance: list[str]
    examples: list[str]
    attachments: list[str]
    sources: list[str]


def publication_inventory(root: Path, edition: str = '2.2') -> PublicationInventory:
    """Canonical complete source inventory shared by this edition's build and gate.

    The ordered lists also control book sections, so the strict gate checks the
    complete builder contract rather than trusting a self-consistent PDF manifest.
    Archive verification deliberately uses its embedded inventory instead.
    """
    normative = ['docs/LANGUAGE_SPECIFICATION.md'] + [f'docs/spec/{name}' for name in [
        '01-structure-and-types.md', '02-communication.md', '03-behavior.md',
        '04-systems-and-conformance.md', '05-kerml-mapping.md', '06-execution-contract.md',
        '07-normalized-model.md', '08-conformance-obligations.md', '09-formal-semantics.md',
    ]] + ['docs/GRAPHICAL_NOTATION.md', 'docs/GRAPHICAL_CATALOG.md']
    guidance = ['docs/'+p+'.md' for p in [f'RELEASE_{edition.replace(".", "_")}', 'QUICK_START', 'USER_GUIDE', 'AI_GUIDE',
        'ARCHITECTURE_PATTERNS', 'ONTOLOGY_AND_VIEWS', 'SIMULATION', 'REQUIREMENTS_AND_DOCUMENTATION', 'KEYWORD_REFERENCE',
        'GRAPHICAL_EXAMPLES', 'IMPLEMENTATION_STATUS', 'TOOLING', 'VERSIONING', 'decisions/0016-swaml-2-0',
        'decisions/0017-readable-names-and-use-cases', 'decisions/0019-package-context',
        'decisions/0020-associated-test-access', 'decisions/0021-case-subject-calls']]
    examples = sorted(p.relative_to(root).as_posix() for p in (root/'examples').glob('*.swaml'))
    examples += sorted(p.relative_to(root).as_posix() for p in (root/'libraries').glob('*.swaml'))
    attachments = [f'docs/SWAML-{edition}-Reference.md', 'spec/standard.json', 'spec/keywords.json', 'spec/notation.json',
        'spec/graphical-examples.json', 'spec/modeling-overview.json', 'package.json', 'package-lock.json', 'tsconfig.json',
        f'scripts/build-spec-pdf-{edition}.py', f'scripts/check-spec-pdf-{edition}.py', 'scripts/publication_2_2_sources.py',
        'scripts/publication_archive.py', 'scripts/ci-pdf-requirements.txt', 'scripts/v2_scene.py', 'scripts/build-notation.py',
        'scripts/build-graphical-examples.py', 'scripts/build-reference.mjs', 'scripts/standard-version.mjs', 'scripts/test-publication-2-2.py']
    attachments += sorted(p.relative_to(root).as_posix()
        for folder in [f'docs/notation/{edition}', f'docs/figures/{edition}', 'resources/fonts', f'examples/simulation/{edition}', 'examples/notation']
        for p in (root/folder).glob('*') if p.is_file())
    attachments += sorted(p.relative_to(root).as_posix() for p in (root/'src').rglob('*.ts')
        if 'generated' not in p.parts and p.name != 'standard-library.ts')
    sources = list(dict.fromkeys(normative + guidance + ['src/language/swaml.langium', 'spec/kerml-mapping.json']
        + examples + ['LICENSE'] + attachments))
    return PublicationInventory(normative, guidance, examples, attachments, sources)


ESCAPABLE = re.compile(r'\\[!-/:-@\[-`{-~]')
FENCE = re.compile(r'^ {0,3}(`{3,}|~{3,})')


def prose_escapes(markdown: str) -> list[str]:
    """Return backslash escapes written in prose outside code spans and fences.

    Markdown silently drops the backslash of an escape such as \\' or \\\\, so a
    rule that spells source escapes would print wrong. Such text belongs in a code span."""
    found, fence = [], None
    for line in markdown.splitlines():
        marker = FENCE.match(line)
        if fence:
            if marker and marker.group(1)[0] == fence[0] and len(marker.group(1)) >= len(fence): fence = None
            continue
        if marker:
            fence = marker.group(1); continue
        # Remove code spans with matching backtick runs before looking for escapes.
        prose = re.sub(r'(`+)(?!`).*?(?<!`)\1(?!`)', '', line)
        found.extend(match.group(0) for match in ESCAPABLE.finditer(prose))
    return found


def canonical(path: Path) -> bytes:
    raw = path.read_bytes()
    return raw if path.suffix in ('.png', '.ttf') else raw.replace(b'\r\n', b'\n')


def verify_edition_sources(manifest, attachments, workspace: Path | None, edition: str):
    if not re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)', edition):
        raise ValueError('An edition uses MAJOR.MINOR only')
    if manifest.get('release') != edition or manifest.get('specificationRevision') != edition or manifest.get('languageVersion') != edition:
        raise ValueError(f'This checker requires edition {edition}')
    implementation = manifest.get('implementationRevision')
    if not isinstance(implementation, str) or not re.fullmatch(r'\d+\.\d+\.\d+', implementation):
        raise ValueError('The implementation package revision must be recorded separately as SemVer')
    sources = manifest.get('sources')
    if not isinstance(sources, list) or not sources:
        raise ValueError('Publication source manifest is empty')
    verified, names, folded = {}, set(), set()
    for entry in sources:
        path = source_path(entry['path'])
        name = entry['attachmentName']
        if path.casefold() in folded or name in names or name != path.replace('/', '__'):
            raise ValueError(f'Duplicate or noncanonical publication source: {path}')
        folded.add(path.casefold()); names.add(name)
        digest = entry['sha256']
        if not isinstance(digest, str) or not re.fullmatch('[0-9a-f]{64}', digest):
            raise ValueError(f'Invalid source digest: {path}')
        payload = attachments.get(name)
        if not isinstance(payload, list) or len(payload) != 1 or not isinstance(payload[0], bytes) or sha256(payload[0]) != digest:
            raise ValueError(f'Embedded source does not match its manifest: {path}')
        verified[path] = payload[0]
    if set(attachments) != names:
        raise ValueError('PDF attachments and source manifest differ')
    bundle = b''.join(entry['path'].encode() + b'\0' + verified[entry['path']] for entry in sources)
    if sha256(bundle) != manifest.get('sourceBundleSha256'):
        raise ValueError('Publication source bundle hash differs')
    if workspace is not None:
        expected = publication_inventory(workspace, edition).sources
        actual = list(verified)
        if actual != expected:
            missing = sorted(set(expected) - set(actual))
            extra = sorted(set(actual) - set(expected))
            detail = f'missing={missing}, extra={extra}' if missing or extra else 'noncanonical source order'
            raise ValueError('Publication sources differ from the complete current-source inventory: ' + detail)
    reference = f'docs/SWAML-{edition}-Reference.md'
    for required in ('spec/standard.json', 'spec/keywords.json', 'spec/notation.json', 'package.json', reference):
        if required not in verified:
            raise ValueError(f'Missing publication inventory/reference: {required}')
    if json.loads(verified['spec/standard.json']).get('version') != edition:
        raise ValueError('Embedded standard version differs from the edition')
    if json.loads(verified['package.json']).get('version') != implementation:
        raise ValueError('Embedded package version differs from the recorded implementation revision')
    for path in ('spec/keywords.json', 'spec/notation.json'):
        data = json.loads(verified[path])
        if data.get('languageVersion') != edition or data.get('edition') != edition:
            raise ValueError(f'Embedded inventory edition mismatch: {path}')
    if workspace is not None:
        for name, raw in verified.items():
            local = workspace.joinpath(*PurePosixPath(name).parts)
            if not local.is_file() or canonical(local) != raw:
                raise ValueError('Workspace source differs from its publication: ' + name)
    return verified

endstream
