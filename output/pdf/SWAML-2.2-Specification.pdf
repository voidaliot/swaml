import {readStandardVersion} from './standard-version.mjs';
import {readFile,writeFile,readdir} from 'node:fs/promises';
import {posix} from 'node:path';
import {SWAML_REFERENCE_PROFILE} from '../out/src/language/edition.js';
const standardVersion=await readStandardVersion();
const root=new URL('../',import.meta.url),check=process.argv.includes('--check');const read=async p=>(await readFile(new URL(p,root),'utf8')).replaceAll('\r\n','\n').replace(/^\uFEFF/,'');
async function output(p,s){if(check){if(await read(p)!==s)throw Error('Stale generated reference '+p);}else await writeFile(new URL(p,root),s);}
const keys=JSON.parse(await read('spec/keywords.json')),notation=JSON.parse(await read('spec/notation.json'));
const grammar=await read('src/language/swaml.langium'),terms=new Set([...grammar.matchAll(/'([A-Za-z]\w*)'/g)].map(m=>m[1]));if(keys.languageVersion!==standardVersion||terms.size!==keys.entries.length||keys.entries.some(e=>!terms.has(e.keyword)))throw Error('Keyword inventory mismatch');
let reference='# swa.ml '+standardVersion+' keyword reference\n\nGenerated from spec/keywords.json and the normative grammar. Examples here are grammar fragments; complete runnable models are in the usage guide and examples. '+keys.entries.filter(e=>e.contextual).length+' contextual words remain legal names outside their positions. call appears in the on call schedule trigger and in on call branches of case scripts.\n\n'+keys.entries.map(e=>'['+e.keyword+'](#keyword-'+e.keyword.toLowerCase()+')').join(' Â· ')+'\n\n';
for(const e of keys.entries){const c=notation.coverage.keywords.find(x=>x.term===e.keyword);if(!c)throw Error('Missing notation '+e.keyword);reference+='## Keyword: '+e.keyword+'\n\n'+e.meaning+'\n\n**Context:** '+e.concern+'. **Grammar:** '+e.productions.join(', ')+'. **Name use:** '+(e.contextual?'contextual':'reserved')+'.\n\n[Normative rule]('+posix.relative('docs',e.normative)+') Â· [Graphical catalog](GRAPHICAL_CATALOG.md).\n\n';}
reference+='## Symbols and precedence\n\nColon means typed by; returns names results. Dot is containment/member access; :: qualifies packages. Brackets express fixed extents, multiplicity or indexing. Parentheses group conditions/arguments and connector endpoints. There are no source arrows. Operators in ascending precedence are or, and, equality, numeric comparison, addition/subtraction, multiplication/division/remainder and unary not/minus. Only and/or short-circuit. Formal docs use /** */; ordinary comments remain lexical.\n';await output('docs/KEYWORD_REFERENCE.md',reference);
const chapters=['LANGUAGE_SPECIFICATION','QUICK_START','USER_GUIDE','AI_GUIDE','spec/01-structure-and-types','spec/02-communication','spec/03-behavior','spec/04-systems-and-conformance','spec/05-kerml-mapping','spec/06-execution-contract','spec/07-normalized-model','spec/08-conformance-obligations','spec/09-formal-semantics','GRAPHICAL_NOTATION','GRAPHICAL_CATALOG','GRAPHICAL_EXAMPLES','SIMULATION','ARCHITECTURE_PATTERNS','REQUIREMENTS_AND_DOCUMENTATION','ONTOLOGY_AND_VIEWS','KEYWORD_REFERENCE','IMPLEMENTATION_STATUS','REVIEW_2_0','RELEASE_2_0_0','RELEASE_2_1','RELEASE_2_2','TOOLING','decisions/0016-swaml-2-0','decisions/0017-readable-names-and-use-cases','decisions/0018-cases-belong-to-their-subject','decisions/0019-package-context','decisions/0020-associated-test-access','decisions/0021-case-subject-calls'];
let book='# swa.ml '+standardVersion+' â€” Complete language reference\n\nComplete reference for the '+standardVersion+' language. Headerless parser '+standardVersion+'; profile '+SWAML_REFERENCE_PROFILE+'. Generated from maintained '+standardVersion+' chapters. Published PDFs and frozen release references, including the 2.0 reference under history/2.0.0, are unchanged. The release notes describe edition changes and the migration from 2.0; no compatibility parser is included.\n\n## Contents\n\n'+chapters.map((c,i)=>'- ['+c+'](#chapter-'+(i+1)+')').join('\n')+'\n\n';
for(let i=0;i<chapters.length;i++){const p='docs/'+chapters[i]+'.md';let text=await read(p);text=text.replace(/\]\(([^)]+)\)/g,(all,target)=>{if(/^[a-z]+:|^#/.test(target))return all;const [path,anchor]=target.split('#');const normalized=posix.normalize(posix.join(posix.dirname(p),path));return ']('+posix.relative('docs',normalized)+(anchor?'#'+anchor:'')+')';});book+='<a id="chapter-'+(i+1)+'"></a>\n\n'+text+'\n\n---\n\n';}
book+='## Complete concrete grammar\n\n```text\n'+grammar.trim()+'\n```\n\n## Worked model sources\n\n';for(const f of (await readdir(new URL('examples/',root))).filter(f=>f.endsWith('.swaml')).sort())book+='### '+f+'\n\n```swaml\n'+(await read('examples/'+f)).trim()+'\n```\n\n';await output('docs/SWAML-'+standardVersion+'-Reference.md',book.trimEnd()+'\n');console.log(standardVersion+' keyword and complete references '+(check?'checked.':'generated.'));

endstream
