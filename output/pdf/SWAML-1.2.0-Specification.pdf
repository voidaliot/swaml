<polyline points="825,210 825,450" fill="none" stroke="#087f8c" stroke-width="2"/>
<polygon points="825.000,450.000 819.000,436.000 831.000,436.000" fill="#17324d"/>
<rect x="838" y="313" width="153.70000000000002" height="27" rx="0" fill="white" stroke="none"/>
<text x="844" y="334" font-size="20" font-weight="400" fill="#17324d">inventoryLink</text>
<polyline points="700,210 700,345 255,345 255,450" fill="none" stroke="#087f8c" stroke-width="2"/>
<polygon points="255.000,450.000 249.000,436.000 261.000,436.000" fill="#17324d"/>
<rect x="378" y="312" width="131.9" height="27" rx="0" fill="white" stroke="none"/>
