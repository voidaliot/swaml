<polyline points="313.0,93.0 325,88 313.0,83.0" fill="none" stroke="#111111" stroke-width="2"/>
<text x="153.508" y="188" font-size="18" font-weight="400" fill="#111111">sysml:Vehicle::leftComputer</text>
