  "stages": [
    {
      "id": "intent",
      "title": "1 Â· Start with the user outcome",
      "summary": "The use case describes the buyerâ€™s intent. Production claims requirement satisfaction; a verification case identifies the procedure that must supply evidence.",
      "width": 1080,
      "height": 770,
      "nodes": [
        {
          "id": "story",
          "title": "Buyer: place an order",
          "kind": "intent",
          "lines": [
            "Reserve available stock.",
            "Receive confirmation + receipt."
          ],
          "x": 20,
          "y": 50,
          "width": 500,
          "height": 150,
          "detail": "Informative use case: a buyer submits an order and expects acceptance only after stock is reserved. The BrowserClient component models the communicating client; this story adds no actor or runtime element."
        },
        {
          "id": "requirement",
          "title": "ReserveBeforeAccept",
          "kind": "intent",
          "lines": [
            "Reserve stock before",
            "confirmation and receipt."
          ],
          "x": 560,
          "y": 50,
          "width": 500,
          "height": 150,
          "detail": "The named requirement says: â€œAn accepted order reserves stock before its confirmation and receipt are published.â€ It defines the intended outcome, not an executable function.",
          "subject": "WebShop::ReserveBeforeAccept",
          "snippet": "requirement ReserveBeforeAccept { doc /* An accepted order reserves stock before its confirmation and receipt are published. */ }"
        },
        {
          "id": "case",
          "title": "Purchase",
          "kind": "intent",
          "lines": [
            "useCase for Production",
            "Six routed exchanges"
          ],
          "x": 560,
          "y": 340,
          "width": 500,
          "height": 150,
          "detail": "Purchase describes intended use through six routed exchanges and explicit dependencies. Design satisfaction belongs to Production.",
          "subject": "WebShop::Purchase"
        },
        {
          "id": "root",
          "title": "Production",
          "kind": "instance",
          "lines": [
            "Browser â†’ application",
            "Inventory + receipt worker"
          ],
          "x": 20,
          "y": 340,
          "width": 500,
          "height": 150,
          "detail": "Production closes the topology of browser, application, inventory and mailer. Purchase references this root; the case does not create a parallel execution.",
          "subject": "WebShop::Production"
        },
        {
          "id": "verification",
          "title": "CheckPurchase",
          "kind": "intent",
          "lines": [
            "verificationCase",
            "Inspect reservation + receipt"
          ],
          "x": 560,
          "y": 580,
          "width": 500,
          "height": 140,
          "detail": "The verification case specifies how to inspect the successful route and final stores. Its verify relation is intent; the linked simulator run is separate bounded evidence.",
          "subject": "WebShop::CheckPurchase"
        }
      ],
