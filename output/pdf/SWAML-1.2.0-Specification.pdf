        }
      ],
      "view": "sv",
      "takeaway": "Each exchange names an interface member, explicit connector and direction. Replies keep the request correlation; events have their own handlers."
    },
    {
      "id": "flow",
      "title": "3 Â· Open the checkout function",
      "summary": "fv subject: Production.application.checkout.submit. Control flow stays inside CheckoutService; inventory.reserve uses its owned client port and explicit route.",
      "width": 1080,
      "height": 765,
      "nodes": [
        {
          "id": "request",
          "title": "Call inventory",
          "kind": "behavior",
          "lines": [
            "call inventory.reserve(quantity)",
            "as reserved within 200 ms"
          ],
          "x": 20,
          "y": 40,
          "width": 640,
          "height": 140,
          "detail": "CheckoutService.submit sends a correlated request on its inventory port. Timeout, Unavailable, Rejected, Transport or RemoteFailure takes the terminating otherwise block.",
          "subject": "WebShop::Production.application.checkout.submit",
          "snippet": "call inventory.reserve(quantity) as reserved within 200 ms otherwise { return false; };"
        },
        {
          "id": "decision",
          "title": "not reserved?",
          "kind": "decision",
          "lines": [],
          "x": 20,
          "y": 280,
          "width": 640,
          "height": 140,
          "detail": "A successful request can still return false. This guard separates refusal from acceptance without publishing a confirmation.",
          "subject": "WebShop::Production.application.checkout.submit",
          "snippet": "if (not reserved) { return false; }"
        },
        {
          "id": "reject",
          "title": "Return false",
          "kind": "failure",
          "lines": [
            "Do not emit acceptance.",
            "Do not emit receipt."
          ],
          "x": 730,
          "y": 155,
          "width": 330,
          "height": 155,
          "detail": "The explicit otherwise and not-reserved branches return false. A timeout does not retract inventory-side effects that may already have happened.",
          "subject": "WebShop::Production.application.checkout.submit",
          "snippet": "return false;"
        },
        {
          "id": "accept",
          "title": "Accept in statement order",
          "kind": "behavior",
          "lines": [
            "acceptedOrders = acceptedOrders + 1;",
            "publish api.accepted(orderId);",
            "publish receipts.created(orderId);",
            "return true;"
          ],
          "x": 20,
          "y": 520,
          "width": 640,
          "height": 200,
          "detail": "These four statements execute in this order inside the checkout component. Both publications are explicit publish statements on owned ports, with connector policy applied separately.",
          "subject": "WebShop::Production.application.checkout.submit",
          "snippet": "acceptedOrders = acceptedOrders + 1; publish api.accepted(orderId); publish receipts.created(orderId); return true;"
        },
        {
          "id": "admission-failure",
          "title": "Publication failure",
          "kind": "failure",
          "lines": [
            "Activation fails.",
            "Prior effects remain."
          ],
          "x": 730,
          "y": 545,
          "width": 330,
          "height": 150,
          "detail": "If either publish encounters rejecting admission, the activation fails without rollback. Stock, the acceptedOrders increment and any earlier admitted publication remain committed; this example has no distributed transaction.",
          "subject": "WebShop::Production.application.checkout.submit"
        }
      ],
      "edges": [
        {
          "id": "reply",
          "source": "request",
          "target": "decision",
          "label": "reply",
          "kind": "flow",
          "points": [
            {
              "x": 340,
              "y": 180
            },
            {
              "x": 340,
              "y": 280
            }
          ],
          "labelX": 356,
          "labelY": 235
        },
        {
          "id": "request-failure",
          "source": "request",
          "target": "reject",
          "label": "otherwise",
          "kind": "flow",
          "points": [
            {
              "x": 660,
              "y": 110
            },
            {
              "x": 895,
              "y": 110
            },
            {
              "x": 895,
              "y": 155
            }
          ],
          "labelX": 744,
          "labelY": 96
        },
        {
          "id": "stock-rejected",
          "source": "decision",
          "target": "reject",
          "label": "true",
          "kind": "flow",
          "points": [
            {
              "x": 660,
              "y": 350
            },
            {
              "x": 895,
              "y": 350
            },
            {
              "x": 895,
              "y": 310
            }
          ],
          "labelX": 744,
          "labelY": 338
        },
        {
          "id": "stock-accepted",
          "source": "decision",
          "target": "accept",
          "label": "false",
          "kind": "flow",
          "points": [
            {
              "x": 340,
              "y": 420
            },
            {
              "x": 340,
              "y": 520
            }
          ],
          "labelX": 356,
          "labelY": 475
        },
        {
          "id": "publication-failed",
          "source": "accept",
          "target": "admission-failure",
          "label": "reject",
          "kind": "flow",
          "points": [
            {
              "x": 660,
              "y": 620
            },
            {
              "x": 730,
              "y": 620
            }
          ],
          "labelX": 665,
          "labelY": 602
        }
      ],
      "view": "fv",
      "takeaway": "Cases describe exchanges; functions implement decisions, private updates and explicit failure behavior. No automatic rollback is implied."
    },
    {
      "id": "functions",
      "title": "4 Â· Keep behavior with its owning component",
      "summary": "Each card is a concrete component instance and lists its owned functions. A component can own private data and behavior together with child components; every function belongs to exactly one instance.",
      "width": 1080,
      "height": 610,
      "nodes": [
        {
          "id": "browser",
          "title": "browser : BrowserClient",
          "kind": "instance",
          "lines": [
            "buy() Â· on start",
            "overOrder() Â· on manual",
            "confirmation(orderId)",
            "on receive checkout.accepted"
          ],
          "x": 20,
          "y": 40,
          "width": 500,
          "height": 220,
          "detail": "Production.browser is a BrowserClient instance. buy requests two items, overOrder requests 99 and asserts rejection, and confirmation records the accepted event. Private data: lastOrder, accepted and rejectedOversize.",
          "subject": "WebShop::Production.browser"
        },
        {
          "id": "checkout",
          "title": "application.checkout",
          "kind": "instance",
          "lines": [
            ": CheckoutService",
            "submit(orderId, quantity): bool",
            "on call api.submit",
            "private acceptedOrders"
          ],
          "x": 560,
          "y": 40,
          "width": 500,
          "height": 220,
          "detail": "Production.application is a WebApplication component instance. Its checkout child is a CheckoutService component. submit owns the flow shown in stage 3 and uses its owned api, inventory and receipts ports.",
          "subject": "WebShop::Production.application.checkout"
        },
        {
          "id": "stock",
          "title": "inventory.stock",
          "kind": "instance",
          "lines": [
            ": StockStore",
            "reserve(quantity): bool",
            "on call api.reserve",
            "private available"
          ],
          "x": 20,
          "y": 340,
          "width": 500,
          "height": 220,
          "detail": "Production.inventory is an InventoryService component instance. Its stock child rejects quantity <= 0 or quantity > available; otherwise it decrements its own available value and returns true.",
          "subject": "WebShop::Production.inventory.stock"
        },
        {
          "id": "mailer",
          "title": "mailer : ReceiptWorker",
          "kind": "instance",
          "lines": [
            "prepareReceipt(orderId)",
            "on receive input.created",
            "private lastOrder + sent"
          ],
          "x": 560,
          "y": 340,
          "width": 500,
          "height": 220,
          "detail": "ReceiptWorker.prepareReceipt receives the created event, records lastOrder and increments sent. It is a modeled receipt worker, with no undeclared external email transport.",
          "subject": "WebShop::Production.mailer"
        }
      ],
      "edges": [],
      "view": "Browser / grv",
      "takeaway": "One reusable definition can appear at multiple paths; ownership and private data always belong to the selected instance."
    },
    {
      "id": "structure",
      "title": "5 Â· Read the resulting software structure",
      "summary": "All four cards are immediate children of WebShop::Production. Named connectors join the shown owned ports; component cards expose their delegated component child.",
      "width": 1080,
      "height": 675,
      "nodes": [
        {
          "id": "browser",
          "title": "browser : BrowserClient",
          "kind": "instance",
          "lines": [
            "checkout : Checkout",
            "requires",
            "on clientProcess"
          ],
          "x": 20,
          "y": 40,
          "width": 470,
          "height": 170,
          "detail": "Component instance Production.browser, deployed on system:clientProcess. checkout is a requires port for Checkout 1.0.0. Requests flow outward; correlated replies and accepted events return over checkoutLink.",
          "subject": "WebShop::Production.browser"
        },
        {
          "id": "application",
          "title": "application : WebApplication",
          "kind": "instance",
          "lines": [
            "checkout : CheckoutService",
            "api / inventory / receipts",
            "on applicationContainer"
          ],
          "x": 590,
          "y": 40,
          "width": 470,
          "height": 170,
          "detail": "Component instance Production.application, deployed on system:applicationContainer. Its api, inventory and receipts ports delegate respectively to checkout.api, checkout.inventory and checkout.receipts; delegation adds no queues.",
          "subject": "WebShop::Production.application"
        },
        {
          "id": "inventory",
          "title": "inventory : InventoryService",
          "kind": "instance",
          "lines": [
            "stock : StockStore",
            "api : Inventory server",
            "on inventoryContainer"
          ],
          "x": 590,
          "y": 450,
          "width": 470,
          "height": 170,
          "detail": "Component instance Production.inventory, deployed on system:inventoryContainer. Its api delegates to stock.api. The stock instance owns available and reserve.",
          "subject": "WebShop::Production.inventory"
        },
        {
          "id": "mailer",
          "title": "mailer : ReceiptWorker",
          "kind": "instance",
          "lines": [
            "input : Receipts subscriber",
            "on workerContainer"
          ],
          "x": 20,
          "y": 450,
          "width": 470,
          "height": 170,
          "detail": "Component instance Production.mailer is deployed on system:workerContainer. Its input port receives Receipts.created and activates prepareReceipt.",
          "subject": "WebShop::Production.mailer"
        }
      ],
      "edges": [
        {
          "id": "checkoutLink",
          "source": "browser",
          "target": "application",
          "label": "checkoutLink",
          "kind": "route",
          "sourceSide": "top",
          "targetSide": "top",
          "detail": "browser.checkout â†’ application.api; Checkout 1.0.0 requires â†’ provides; qos RequestQueue: atMostOnce, fifo, capacity 16, overflow reject. Service events and correlated replies use the reverse direction.",
          "points": [
            {
              "x": 255,
              "y": 40
            },
            {
              "x": 255,
              "y": 8
            },
            {
              "x": 825,
              "y": 8
            },
            {
              "x": 825,
              "y": 40
            }
          ],
          "labelX": 468,
          "labelY": 34
        },
        {
          "id": "inventoryLink",
          "source": "application",
          "target": "inventory",
          "label": "inventoryLink",
          "kind": "route",
          "sourceSide": "bottom",
          "targetSide": "top",
          "detail": "application.inventory â†’ inventory.api; Inventory 1.0.0 client â†’ server; qos RequestQueue: atMostOnce, fifo, capacity 16, overflow reject. This connector has its own queues, independent of checkoutLink.",
          "points": [
            {
              "x": 825,
              "y": 210
            },
            {
              "x": 825,
              "y": 450
            }
          ],
          "labelX": 844,
          "labelY": 334
        },
        {
          "id": "receiptLink",
          "source": "application",
          "target": "mailer",
          "label": "receiptLink",
          "kind": "route",
          "sourceSide": "bottom",
          "targetSide": "top",
          "detail": "application.receipts â†’ mailer.input; Receipts 1.0.0 publisher â†’ subscriber; qos ReceiptQueue: atMostOnce, fifo, capacity 32, overflow reject. Delegation reaches application.checkout.receipts.",
          "points": [
            {
              "x": 700,
              "y": 210
            },
            {
              "x": 700,
              "y": 345
            },
            {
              "x": 255,
              "y": 345
            },
            {
              "x": 255,
              "y": 450
            }
          ],
          "labelX": 384,
          "labelY": 333
        }
      ],
      "view": "gv / iv",
      "takeaway": "Six descendant component instances, three explicit connectors and four external deployment targets form one closed root. Shared QoS values never merge queues."
    }
  ]
}

