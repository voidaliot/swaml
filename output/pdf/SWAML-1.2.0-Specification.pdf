<text x="54" y="54" font-size="20" font-weight="700" fill="#111111">Duration labels</text>
<polyline points="36,67 524,67" fill="none" stroke="#111111" stroke-width="2"/>
<text x="54" y="95" font-size="18" font-weight="400" fill="#111111">1 ns 1 us 1 ms 1 s</text>
</g></svg>

