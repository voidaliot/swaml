  "ontology": {
    "id": "ontology",
    "title": "One component concept, from architecture to behavior",
    "summary": "Components own child components, private data, functions and ports. Functions own calculations and flow or states. Solid arrows show ownership; dashed arrows show references. Requirements and cases describe intent; all views project the same model.",
    "view": "Concept map",
    "takeaway": "Function means behavior with flow or states. Calculation means a pure expression. Component means one reusable software boundary with its own state.",
    "width": 1100,
    "height": 1040,
    "nodes": [
      {
        "id": "root",
        "title": "Execution root",
        "kind": "instance",
        "x": 20,
        "y": 20,
        "width": 240,
        "height": 140,
        "lines": [
          "Inline or typed",
          "Closed architecture"
        ],
        "detail": "A top-level component usage selects a concrete architecture. It can declare local behavior and child components inline, or instantiate a reusable definition with deployment bindings. Every instance, including the root, has its own store."
      },
      {
        "id": "component",
        "title": "Component definition",
        "kind": "definition",
        "x": 350,
        "y": 20,
        "width": 360,
        "height": 140,
        "lines": [
          "Private variables + ports",
          "Behavior + children"
        ],
        "detail": "One software boundary owns private variables, functions, typed ports, child instances, connectors and delegations. The same rules apply to atomic and composite components."
      },
      {
        "id": "specialization",
        "title": "Specialization",
        "kind": "definition",
        "x": 830,
        "y": 20,
        "width": 240,
        "height": 140,
        "lines": [
          "One base component",
          "Explicit redefines"
        ],
        "detail": "A definition can specialize one base definition. It inherits effective members and may explicitly redefine compatible members. Child replacement must preserve its contract; cycles and silent overrides are rejected."
      },
      {
        "id": "children",
        "title": "Child components",
        "kind": "instance",
        "x": 20,
        "y": 300,
        "width": 240,
        "height": 140,
        "lines": [
          "Named instances",
          "Separate stores"
        ],
        "detail": "A component owns zero or more component usages. Each usage instantiates a component definition, recursively. Reusing a definition never shares mutable state. Instances are created statically with the root."
      },
      {
        "id": "functions",
        "title": "Functions",
        "kind": "behavior",
        "x": 290,
        "y": 300,
        "width": 240,
        "height": 140,
        "lines": [
          "Triggers + inputs",
          "Optional result"
        ],
        "detail": "Functions own local calculations and flow or states. They may activate through a trigger or be called locally with call name(args), returning a copied value with as name. Inter-component calls use call port.member(args) with a timeout and failure path."
      },
      {
        "id": "calculations",
        "title": "Calculations",
        "kind": "behavior",
        "x": 560,
        "y": 300,
        "width": 240,
        "height": 140,
        "lines": [
          "Typed inputs",
          "Expression + result"
        ],
        "detail": "A calc belongs only to its enclosing function and is available in that functionâ€™s expressions, states and guards. It accepts explicit copied inputs and returns a pure expression value. It cannot capture mutable state or call executable functions."
      },
      {
        "id": "ports",
        "title": "Ports and routes",
        "kind": "contract",
        "x": 830,
        "y": 300,
        "width": 240,
        "height": 140,
        "lines": [
          "Typed boundary",
          "Connect / delegate"
        ],
        "detail": "Ports expose a versioned interface with a role. Connectors route between compatible ports, including an owned port and a child port. Delegation forwards a boundary to a child. Every exchange between distinct components follows an explicit route."
      },
      {
        "id": "deployment",
        "title": "Deployment",
        "kind": "deployment",
        "x": 20,
        "y": 580,
        "width": 240,
        "height": 140,
        "lines": [
          "system: or sysml: URI",
          "Host resolves target"
        ],
        "detail": "Deployment maps an instance path to an external target identity. A system URI or SysML part URI can be used without introducing a SWAML hardware classifier. Parent allocations apply to descendants unless overridden. No SysML import or conformance is implied."
      },
      {
        "id": "flow",
        "title": "Flow or states",
        "kind": "behavior",
        "x": 290,
        "y": 580,
        "width": 240,
        "height": 140,
        "lines": [
          "Decisions + loops",
          "Calls + states"
        ],
        "detail": "After optional calculation declarations, a function owns flow or states. Flow includes var declarations, bounded loops, decisions, assignments, calls, sends and returns. States own entry/exit actions, with guarded transitions and effects."
      },
      {
        "id": "types",
        "title": "Value types",
        "kind": "value",
        "x": 560,
        "y": 580,
        "width": 240,
        "height": 140,
        "lines": [
          "bool Â· byte Â· uint Â· int",
          "real Â· string"
        ],
        "detail": "Typed inputs, results, payloads and private data use bool, byte, uint, int, real and string, plus nominal records/enums and fixed-size arrays. void denotes no result. byte and uint have enforced numeric bounds; values are copied across boundaries."
      },
      {
        "id": "interfaces",
        "title": "Interfaces",
        "kind": "contract",
        "x": 830,
        "y": 580,
        "width": 240,
        "height": 140,
        "lines": [
          "Data Â· events Â· RPC",
          "Versioned contracts"
        ],
        "detail": "Interfaces describe data, events and callable function signatures. The four kinds are senderReceiver, clientServer, publishSubscribe and service. Component functions implement incoming behavior; an interface signature has no executable body."
      },
      {
        "id": "requirements",
        "title": "Requirements",
        "kind": "intent",
        "x": 20,
        "y": 860,
        "width": 240,
        "height": 140,
        "lines": [
          "Attributes + doc",
          "No subject"
        ],
        "detail": "Requirements express obligations with immutable typed attributes and one optional formal doc. Design elements claim satisfaction through satisfy."
      },
      {
        "id": "useCases",
        "title": "Use cases",
        "kind": "intent",
        "x": 290,
        "y": 860,
        "width": 240,
        "height": 140,
        "lines": [
          "Intended use",
          "Root + exchanges"
        ],
        "detail": "useCase identifies intended use in a root context and may describe routed exchanges."
      },
      {
        "id": "verificationCases",
        "title": "Verification cases",
        "kind": "intent",
        "x": 560,
        "y": 860,
        "width": 240,
        "height": 140,
        "lines": [
          "Procedure + verify",
          "Evidence stays explicit"
        ],
        "detail": "verificationCase owns verify relations to requirements; docs describe the procedure. A relation is not a passed test."
      },
      {
        "id": "annotations",
        "title": "Docs + comments",
        "kind": "intent",
        "x": 830,
        "y": 860,
        "width": 240,
        "height": 140,
        "lines": [
          "One formal doc",
          "Ordinary notes"
        ],
        "detail": "A declaration can own one doc specification and many ordinary comments. Docs appear as compartments or table cells; comments are plain owned notes."
      }
