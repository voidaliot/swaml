<rect x="1" y="1" width="918" height="388" fill="#fafafa" stroke="#171717"/>
<text x="26" y="36" font-family="DejaVu Sans, sans-serif" font-size="21" fill="#171717">Declared and observed timing</text>
<line x1="26" y1="54" x2="894" y2="54" stroke="#171717"/>
<text x="40" y="90" font-family="DejaVu Sans, sans-serif" font-size="14" fill="#171717">Declared: every 5ms, deadline 3ms</text>
<line x1="170" y1="110" x2="170" y2="330" stroke="#171717"/>
<text x="160" y="355" font-family="DejaVu Sans, sans-serif" font-size="12" fill="#171717">0ms</text>
<line x1="320" y1="110" x2="320" y2="330" stroke="#171717"/>
<text x="310" y="355" font-family="DejaVu Sans, sans-serif" font-size="12" fill="#171717">5ms</text>
<line x1="470" y1="110" x2="470" y2="330" stroke="#171717"/>
<text x="460" y="355" font-family="DejaVu Sans, sans-serif" font-size="12" fill="#171717">10ms</text>
<line x1="620" y1="110" x2="620" y2="330" stroke="#171717"/>
<text x="610" y="355" font-family="DejaVu Sans, sans-serif" font-size="12" fill="#171717">15ms</text>
<line x1="770" y1="110" x2="770" y2="330" stroke="#171717"/>
<text x="760" y="355" font-family="DejaVu Sans, sans-serif" font-size="12" fill="#171717">20ms</text>
<text x="40" y="160" font-family="DejaVu Sans, sans-serif" font-size="13" fill="#171717">release</text>
<text x="40" y="240" font-family="DejaVu Sans, sans-serif" font-size="13" fill="#171717">observed</text>
