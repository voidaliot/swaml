                    if (!assignable(typeKey(sig.result), typeKey(ep.member.result)) || sig.parameters.length !== ep.member.parameters.length || sig.parameters.some((p, i) => (p.direction ?? 'in') !== (ep.member.parameters[i]?.direction ?? 'in')))
