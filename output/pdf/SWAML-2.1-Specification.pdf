stream
{
  "name": "@swaml/language",
  "version": "3.0.0",
  "private": true,
  "description": "Software Architecture Modeling Language: specification and Langium reference workbench",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10.2.3"
  },
  "exports": {
    ".": "./out/src/language/swaml-module.js",
    "./ast": "./out/src/language/generated/ast.js",
    "./simulation": "./out/src/simulation/simulator.js",
    "./timing": "./out/src/simulation/timing.js",
    "./projection": "./out/src/language/projection.js",
    "./semantic": "./out/src/language/semantic.js",
    "./presentation": "./out/src/language/presentation.js",
    "./names": "./out/src/language/names.js"
  },
  "bin": {
    "swaml": "./out/src/cli/main.js",
    "swaml-simulate": "./out/src/cli/simulate.js"
  },
  "scripts": {
    "langium:generate": "node scripts/build-library.mjs && langium generate",
    "build": "npm run langium:generate && tsc -p tsconfig.json",
    "test": "node --test out/test/v2/*.test.js",
    "validate:examples": "node scripts/validate-examples.mjs",
    "check": "npm run build && npm test && npm run validate:examples && node scripts/build-inventories.mjs --check && node scripts/standard-version.mjs && node scripts/check-docs.mjs && node scripts/check-simulations.mjs && node scripts/build-reference.mjs --check && node scripts/check-graphical-examples.mjs && node scripts/check-notation.mjs && node scripts/check-showcase.mjs && node scripts/check-modeling-overview.mjs && node scripts/check-public-content.mjs && node scripts/build-traceability-demo.mjs --check && node scripts/build-timing-demo.mjs --check",
    "simulate": "node out/src/cli/simulate.js",
    "docs:build": "node scripts/build-reference.mjs"
  },
  "dependencies": {
    "langium": "4.4.0",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-protocol": "3.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "langium-cli": "4.4.0",
    "typescript": "~5.9.3"
  }
}

endstream
endobj
