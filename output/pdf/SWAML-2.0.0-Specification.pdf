    {
      "id": "loops",
      "title": "Loops and copied iteration",
      "context": "SWAML 2.0; Loops::Demo",
      "syntax": "component Demo {\n    attribute count: int = 0;\n    operation boot() {\n      while (count < 2, 3 times) {\n        count = count + 1;\n      }\n      until (count == 4, 5 times) {\n        count = count + 1;\n      }\n      for (var i: int = 0; i < 2; i = i + 1) {\n        count = count + i;\n      }\n      for (x: int in[1, 2]) {\n        count = count + x;\n      }\n    }\n    schedule {\n      on start boot();\n    }\n  }",
      "model": "examples/18-control-loops.swaml",
