      "syntax": "component Demo {\n    attribute sum: int = 0;\n    attribute mode: Mode = Mode.idle;\n    attribute reading: Reading = record Reading {\n      value = 4.5;\n      unit = \"C\";\n    };\n    operation add(a: int, b: int) returns int {\n      return a + b;\n    }\n    operation boot() {\n      var values: int[3] =[1, 2, 3];\n      for (value: int in values) {\n        sum = add(sum, value);\n      }\n      mode = Mode.active;\n    }\n    schedule {\n      on start boot();\n    }\n  }",
      "model": "examples/05-values-and-flow.swaml",
