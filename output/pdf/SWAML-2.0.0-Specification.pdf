<rect x="440" y="155" width="300" height="125" fill="#ffffff" stroke="#171717"/>
<rect x="440" y="155" width="300" height="34" fill="#eeeeee" stroke="#171717"/>
<text x="452" y="178" font-family="DejaVu Sans, sans-serif" font-size="14" fill="#171717">child: Sensor</text>
<text x="452" y="213" font-family="DejaVu Sans, sans-serif" font-size="12" fill="#171717">port reading: Temperature</text>
<text x="452" y="235" font-family="DejaVu Sans, sans-serif" font-size="12" fill="#171717">provides attribute temperature: real</text>
