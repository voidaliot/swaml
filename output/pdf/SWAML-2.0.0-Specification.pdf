<text x="26" y="36" font-family="DejaVu Sans, sans-serif" font-size="21" fill="#171717">Queue-free boundary forwarding</text>
<line x1="26" y1="54" x2="894" y2="54" stroke="#171717"/>
<rect x="45" y="95" width="810" height="230" fill="#ffffff" stroke="#171717"/>
