      "syntax": "component def Receiver {\n    reversed port input: Messages;\n    attribute last: int = 0;\n    operation work() {\n      wait 2ms;\n      on receive input.message(value) {\n        last = value;\n      } or after 1ms {\n        last = - 1;\n      }\n    }\n    schedule {\n      on start work();\n    }\n  }",
