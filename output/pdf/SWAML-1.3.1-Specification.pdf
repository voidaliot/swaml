<rect x="53" y="149" width="182" height="77" rx="38" fill="#ffffff" stroke="#111111"/>
<text x="122.0" y="191" font-size="18" font-weight="400" fill="#111111">Shop</text>
<rect x="353" y="142" width="178" height="100" rx="0" fill="#ffffff" stroke="#111111"/>
<text x="375.5" y="198.0" font-size="18" font-weight="400" fill="#111111">AcceptedOrder</text>
<polyline points="235,190 352,190" fill="none" stroke="#111111" stroke-width="2" stroke-dasharray="7 5"/>
<polyline points="340.0,195.0 352,190 340.0,185.0" fill="none" stroke="#111111" stroke-width="2"/>
