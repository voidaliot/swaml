        "template": "function-timing",
        "header": [
          "tv: first.poll"
        ],
        "lines": [
          "declared: wcet 1 ms; deadline 30 ms; serial",
          "observed: reference logical time, zero CPU cost"
        ],
        "evidence": {
          "artifact": "spec/function-timing-demo.json",
          "run": "success",
          "functionPath": "first.poll",
          "activationIds": [
            "a6",
            "a12"
          ]
        },
        "observations": [
          {
            "id": "a6",
            "releasedMs": 2,
            "dispatchedMs": 2,
            "terminalMs": 6
          },
          {
            "id": "a12",
            "releasedMs": 3,
            "dispatchedMs": 6,
            "terminalMs": 10
          }
        ],
        "axis": {
          "endMs": 12,
          "tickMs": 2,
          "observationEndMs": 33,
          "deadlinesMs": [
            32,
            33
          ]
        }
      }
