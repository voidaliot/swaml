{
  "version": 1,
  "model": {
    "file": "examples/13-web-application.swaml",
    "package": "WebShop",
    "root": "WebShop::Production",
    "case": "WebShop::Purchase",
    "requirement": "WebShop::ReserveBeforeAccept",
    "simulation": "examples/simulation/13-web-application.json"
  },
  "ontology": {
    "id": "ontology",
    "title": "Software classifiers and behavior, from architecture to execution",
    "summary": "Class is the general structural category; component specializes class. Operation is the general executable category; function specializes operation. Both alternatives retain private state, owned children, typed ports and direct behavior. Solid arrows show ownership; dashed arrows show references.",
    "view": "Concept map",
    "takeaway": "Component specializes Class; Function specializes Operation. Calculations are pure and local to either executable category. Every occurrence has separate state.",
    "width": 1100,
    "height": 1040,
    "nodes": [
      {
        "id": "root",
        "title": "Execution root",
        "kind": "instance",
        "x": 20,
        "y": 20,
        "width": 240,
        "height": 140,
        "lines": [
          "Inline or typed",
          "Closed architecture"
        ],
        "detail": "A top-level class or component usage selects a closed execution architecture, inline or typed. Typed bodies contain deployment bindings only. Each occurrence owns separate stores."
      },
      {
        "id": "component",
        "title": "Class / Component",
        "kind": "definition",
        "x": 350,
        "y": 20,
        "width": 360,
        "height": 140,
        "lines": [
          "Component specializes Class",
          "Private state + ports"
        ],
        "detail": "Class is the general classifier; Component is its specialized category. Both own child usages, private values, typed ports and operations/functions. Definitions and occurrences retain different identities; no heap or cross-owner access is added."
      },
      {
        "id": "specialization",
        "title": "Specialization",
        "kind": "definition",
        "x": 830,
        "y": 20,
        "width": 240,
        "height": 140,
        "lines": [
          "One compatible base",
          "Explicit redefines"
        ],
        "detail": "A definition can specialize one base definition. It inherits effective members and may explicitly redefine compatible members. Child replacement must preserve its contract; cycles and silent overrides are rejected."
      },
      {
        "id": "children",
        "title": "Child usages",
        "kind": "instance",
        "x": 20,
        "y": 300,
        "width": 240,
        "height": 140,
        "lines": [
          "Class or Component",
          "Separate private stores"
        ],
        "detail": "A classifier owns statically named class/component usages. Each expands its compatible definition with independent state; component usages require component definitions, while class usages accept either category."
      },
      {
        "id": "functions",
        "title": "Operation / Function",
        "kind": "behavior",
        "x": 290,
        "y": 300,
        "width": 240,
        "height": 140,
        "lines": [
          "General â†’ specialized",
          "Triggers + inputs/result"
        ],
        "detail": "Operation is general executable behavior; Function specializes it. Both own local calculations and flow or states, use copied values and ordinary triggers, and preserve local/routed call isolation. Neither means pure calculation."
      },
      {
        "id": "calculations",
        "title": "Calculations",
        "kind": "behavior",
        "x": 560,
        "y": 300,
        "width": 240,
        "height": 140,
        "lines": [
          "Typed inputs",
          "Expression + result"
        ],
        "detail": "A calc belongs only to its enclosing operation/function. It accepts explicit copied inputs and returns a pure expression value; it cannot capture mutable state or call executable behavior."
      },
      {
        "id": "ports",
        "title": "Ports and routes",
        "kind": "contract",
        "x": 830,
        "y": 300,
        "width": 240,
        "height": 140,
        "lines": [
          "Typed boundary",
          "Connect / delegate"
        ],
        "detail": "Ports expose a versioned interface with a role. Connectors route between compatible ports, including an owned port and a child port. Delegation forwards a boundary to a child. Every exchange between distinct components follows an explicit route."
      },
      {
        "id": "deployment",
        "title": "Deployment",
        "kind": "deployment",
        "x": 20,
        "y": 580,
        "width": 240,
        "height": 140,
        "lines": [
          "system: or sysml: URI",
          "Host resolves target"
        ],
        "detail": "Deployment maps an instance path to an external target identity. A system URI or SysML part URI can be used without introducing a SWAML hardware classifier. Parent allocations apply to descendants unless overridden. No SysML import or conformance is implied."
      },
      {
        "id": "flow",
        "title": "Flow or states",
        "kind": "behavior",
        "x": 290,
        "y": 580,
        "width": 240,
        "height": 140,
        "lines": [
          "Decisions + loops",
          "Calls + states"
        ],
        "detail": "After optional calculation declarations, a function owns flow or states. Flow includes var declarations, bounded loops, decisions, assignments, calls, sends and returns. States own entry/exit actions, with guarded transitions and effects."
      },
      {
        "id": "types",
        "title": "Value types",
        "kind": "value",
        "x": 560,
        "y": 580,
        "width": 240,
        "height": 140,
        "lines": [
          "bool Â· byte Â· uint Â· int",
          "real Â· string"
        ],
        "detail": "Typed inputs, results, payloads and private data use bool, byte, uint, int, real and string, plus nominal records/enums and fixed-size arrays. void denotes no result. byte and uint have enforced numeric bounds; values are copied across boundaries."
      },
      {
        "id": "interfaces",
        "title": "Interfaces",
        "kind": "contract",
        "x": 830,
        "y": 580,
        "width": 240,
        "height": 140,
        "lines": [
          "Data Â· events Â· RPC",
          "Versioned contracts"
        ],
        "detail": "Interfaces describe data, events and callable function signatures. The four kinds are senderReceiver, clientServer, publishSubscribe and service. Component functions implement incoming behavior; an interface signature has no executable body."
      },
      {
        "id": "requirements",
        "title": "Requirements",
        "kind": "intent",
        "x": 20,
        "y": 860,
        "width": 240,
        "height": 140,
        "lines": [
          "Attributes + doc",
          "No subject"
        ],
        "detail": "Requirements express obligations with immutable typed attributes and one optional formal doc. Design elements claim satisfaction through satisfy."
      },
      {
        "id": "useCases",
        "title": "Use cases",
        "kind": "intent",
        "x": 290,
        "y": 860,
        "width": 240,
        "height": 140,
        "lines": [
          "Intended use",
          "Root + exchanges"
        ],
        "detail": "useCase identifies intended use in a root context and may describe routed exchanges."
      },
      {
        "id": "verificationCases",
        "title": "Verification cases",
        "kind": "intent",
        "x": 560,
        "y": 860,
        "width": 240,
        "height": 140,
        "lines": [
          "Procedure + verify",
          "Evidence stays explicit"
        ],
        "detail": "verificationCase owns verify relations to requirements; docs describe the procedure. A relation is not a passed test."
      },
      {
        "id": "annotations",
        "title": "Docs + comments",
        "kind": "intent",
        "x": 830,
        "y": 860,
        "width": 240,
        "height": 140,
        "lines": [
          "One formal doc",
          "Ordinary notes"
        ],
        "detail": "A declaration can own one doc specification and many ordinary comments. Docs appear as compartments or table cells; comments are plain owned notes."
      }
    ],
