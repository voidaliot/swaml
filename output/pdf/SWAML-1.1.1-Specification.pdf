{
  "schemaVersion": "1.0",
  "languageVersion": "1.1",
  "edition": "1.1.1",
  "title": "SWAML canonical graphical notation",
  "style": {
    "background": "white",
    "stroke": "#202020",
    "semanticColor": false,
    "ownership": "component â†’ unit â†’ operation; states directly inside operations",
    "scope": "Original SWAML notation, organized in a SysML-style reference table; not an OMG notation conformance claim."
  },
  "concepts": [
    {
      "id": "package",
      "title": "Package",
      "concern": "Structure and values",
      "kind": "node",
      "views": [
        "GV",
        "GRV"
      ],
      "keywords": [
        "package"
      ],
      "productions": [
        "Package"
      ],
      "syntax": "package Hello",
      "context": "Package header; declarations occupy its body.",
      "rules": [
        "Draw a tabbed rectangular namespace frame; the tab contains the package name.",
        "Nested compartments show owned declarations, not runtime instances created by package membership."
      ],
      "description": "Package. Draw a tabbed rectangular namespace frame; the tab contains the package name.",
      "source": {
        "model": "examples/01-hello.swaml",
        "path": "Hello"
      },
      "drawing": {
        "template": "package",
        "header": [
          "Hello"
        ],
        "lines": [
          "interface Greeting",
          "unit def Speaker",
          "component Demo"
        ]
      }
    },
    {
      "id": "import",
      "title": "Package import",
      "concern": "Structure and values",
      "kind": "edge",
      "views": [
        "GV",
        "GRV"
      ],
      "keywords": [
        "import"
