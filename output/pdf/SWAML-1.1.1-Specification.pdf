<polyline points="428,253 132,253" fill="none" stroke="#111111" stroke-width="2" stroke-dasharray="7 5"/>
<polyline points="144.0,248.0 132,253 144.0,258.0" fill="none" stroke="#111111" stroke-width="2"/>
