<svg xmlns="http://www.w3.org/2000/svg" width="560" height="280" viewBox="0 0 560 280" role="img" aria-labelledby="title desc">
<title id="title">Event subscriber port</title><desc id="desc">Event subscriber port. Draw a small square centered on the owning boundary and label its name: Interface and exact role.</desc>
<g font-family="DejaVu Sans, sans-serif" stroke-width="1.5">
<rect x="0" y="0" width="560" height="280" rx="0" fill="#ffffff" stroke="none"/>
<rect x="28" y="32" width="290" height="210" rx="0" fill="#ffffff" stroke="#111111"/>
<text x="44" y="62" font-size="19" font-weight="700" fill="#111111">status: Status</text>
<text x="44" y="88" font-size="19" font-weight="700" fill="#111111">subscriber</text>
<rect x="311" y="151" width="14" height="14" rx="0" fill="#ffffff" stroke="#111111"/>
<text x="350" y="88" font-size="18" font-weight="400" fill="#111111">Â«subscriberÂ»</text>
<polyline points="520,158 326,158" fill="none" stroke="#111111" stroke-width="2"/>
<polygon points="326,158 338.0,153.0 338.0,163.0" fill="#111111" stroke="#111111"/>
</g></svg>

endstream
