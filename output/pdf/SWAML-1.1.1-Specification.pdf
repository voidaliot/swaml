<polyline points="132,130 132,286" fill="none" stroke="#111111" stroke-width="2" stroke-dasharray="7 5"/>
<polyline points="428,130 428,286" fill="none" stroke="#111111" stroke-width="2" stroke-dasharray="7 5"/>
<polyline points="132,181 428,181" fill="none" stroke="#111111" stroke-width="2"/>
<polygon points="428,181 416.0,186.0 416.0,176.0" fill="#111111" stroke="#111111"/>
