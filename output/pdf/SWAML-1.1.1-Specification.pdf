<svg xmlns="http://www.w3.org/2000/svg" width="560" height="280" viewBox="0 0 560 280" role="img" aria-labelledby="title desc">
<title id="title">Interface connector</title><desc id="desc">Interface connector. Draw a solid directed connector between port squares, with connector identity and interface name visible.</desc>
<g font-family="DejaVu Sans, sans-serif" stroke-width="1.5">
<rect x="0" y="0" width="560" height="280" rx="0" fill="#ffffff" stroke="none"/>
<rect x="20" y="128" width="170" height="85" rx="0" fill="#ffffff" stroke="#111111"/>
<text x="38.008" y="176.5" font-size="18" font-weight="400" fill="#111111">speaker.output</text>
<rect x="370" y="128" width="170" height="85" rx="0" fill="#ffffff" stroke="#111111"/>
<text x="396.508" y="176.5" font-size="18" font-weight="400" fill="#111111">listener.input</text>
<rect x="183" y="164" width="14" height="14" rx="0" fill="#ffffff" stroke="#111111"/>
<rect x="363" y="164" width="14" height="14" rx="0" fill="#ffffff" stroke="#111111"/>
<polyline points="198,171 362,171" fill="none" stroke="#111111" stroke-width="2"/>
<polygon points="362,171 350.0,176.0 350.0,166.0" fill="#111111" stroke="#111111"/>
<text x="26" y="35" font-size="20" font-weight="700" fill="#111111">greeting: Greeting</text>
<text x="198.5" y="113" font-size="18" font-weight="400" fill="#111111">greeting: Greeting</text>
<text x="26" y="244" font-size="18" font-weight="400" fill="#111111">capacity 4; overflow reject</text>
</g></svg>

