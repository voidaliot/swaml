{
  "schemaVersion": "2.0",
  "language": "SWAML",
  "languageVersion": "1.1",
  "foundation": {
    "name": "KerML",
    "version": "1.0",
    "source": "https://www.omg.org/spec/KerML/1.0"
  },
  "status": "proposed-mapping-contract-not-an-exporter",
  "namespace": null,
  "mapping": [
    {
      "source": "Model",
      "kind": "element",
      "kernel": [
        "Package"
      ],
      "normative": "docs/spec/07-normalized-model.md",
      "semantic": "Workspace source container under a host-pinned 1.1 language edition; no file version header."
    },
    {
      "source": "Package",
      "kind": "element",
