<title id="title">Occurrence lifeline</title><desc id="desc">Occurrence lifeline. Draw a lifeline headed by the occurrence name: Type and a dashed vertical line.</desc>
<g font-family="DejaVu Sans, sans-serif" stroke-width="1.5">
<rect x="0" y="0" width="560" height="280" rx="0" fill="#ffffff" stroke="none"/>
<rect x="128" y="24" width="304" height="73" rx="0" fill="#ffffff" stroke="#111111"/>
<text x="223.5" y="66.5" font-size="18" font-weight="400" fill="#111111">caller: Caller</text>
<polyline points="280,98 280,255" fill="none" stroke="#111111" stroke-width="2" stroke-dasharray="7 5"/>
<text x="312" y="151" font-size="18" font-weight="400" fill="#111111">health: Health client</text>
</g></svg>

endstream
