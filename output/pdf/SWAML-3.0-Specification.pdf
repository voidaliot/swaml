}
const statementSlot = (n: AstNode) => n.$containerProperty === 'statements' || a.isFor(n.$container) && (n.$containerProperty === 'initializer' || n.$containerProperty === 'update');
const statementOwner = (n: AstNode) => isExecutable(n) || a.isScenario(n);
