    };
    private unique(items: readonly AstNode[], n: AstNode): void { const seen = new Set<string>(); for (const x of items as Node[])
        if (x.name) {
            if (seen.has(x.name))
                this.report(x, 'SW2001', `Duplicate name ${x.name} in ${identity(n)}.`);
            seen.add(x.name);
        } }
