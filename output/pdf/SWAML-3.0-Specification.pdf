    },
    {
      "source": "Association",
      "kind": "element",
      "kernel": [
        "Feature"
      ],
      "semantic": "Association: an associate statement records that top-level occurrences of the package take part in use cases or tests other than as their subject. A list statement lowers to one reference per occurrenceâ€“case pair, each with the statement and the positions of its occurrence and case in their lists as provenance (WP2-M03); ownership, order and occurrence identity are preserved.",
      "normative": "docs/spec/04-systems-and-conformance.md"
    },
    {
      "source": "Scenario",
      "kind": "element",
      "kernel": [
        "Feature"
      ],
      "semantic": "Scenario: preserve use cases, tests and associations, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/04-systems-and-conformance.md"
    },
