    },
    {
      "source": "ComponentDef",
      "kind": "element",
      "kernel": [
        "Structure"
      ],
      "semantic": "ComponentDef: preserve component definitions and usages, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/01-structure-and-types.md"
    },
    {
      "source": "ComponentUsage",
      "kind": "element",
