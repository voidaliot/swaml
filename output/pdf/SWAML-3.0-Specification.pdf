    private sequence(values: a.Expression[], flow: Flow): Value[] {
        const result: Value[] = [];
        for (const e of values) {
            const before = this.suspensions, v = this.expression(e, flow);
            if (this.suspensions !== before)
                result.forEach((r, i) => result[i] = aged(r));
