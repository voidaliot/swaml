                    const left = endpoint(c.structure, l.source)!, right = endpoint(c.structure, l.target)!;
                    if (left.child !== right.child)
                        this.aliases.set(`${c.path}.${left.child ? l.target : l.source}`, `${c.path}.${left.child ? l.source : l.target}`);
