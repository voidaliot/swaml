    },
    {
      "source": "ComponentMember",
      "kind": "grouping",
      "kernel": [],
      "semantic": "ComponentMember: preserve component definitions and usages, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/01-structure-and-types.md"
    },
    {
      "source": "Attribute",
      "kind": "element",
      "kernel": [
        "Feature"
      ],
      "semantic": "Attribute: preserve attributes and lexical locals, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
