/** The swa.ml edition this host selects. It is never inferred from source; files are headerless. */
export const SWAML_LANGUAGE_VERSION = '3.0' as const;
/** The execution profile of the reference interpreter for this edition. */
export const SWAML_REFERENCE_PROFILE = 'swaml-reference/3.0' as const;
/** The reference implementation package revision (package.json), reported as the language server identity. */
export const SWAML_IMPLEMENTATION_VERSION = '4.0.0' as const;

