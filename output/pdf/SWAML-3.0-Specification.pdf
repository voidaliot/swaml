      "kernel": [
        "Package"
      ],
      "semantic": "QualifiedName: preserve packages and imports, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/01-structure-and-types.md"
    },
    {
      "source": "ValuePath",
      "kind": "reference",
      "kernel": [
        "Feature"
      ],
      "semantic": "ValuePath: preserve typed expressions and operators, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/01-structure-and-types.md"
    },
    {
      "source": "Expression",
      "kind": "value",
      "kernel": [
        "Expression"
      ],
      "semantic": "Expression: a whole expression, a conditional or an operator expression (WP2-G01); it preserves typed expressions and operators, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/01-structure-and-types.md"
    },
    {
      "source": "ConditionalExpression",
      "kind": "value",
      "kernel": [
        "ControlFunctions::'if'"
      ],
      "semantic": "ConditionalExpression: a whole-expression conditional if (c) a else b (WP2-M02) that evaluates its bool condition and then only the selected branch; its type is the common type of both branches. It lowers to the kernel function ControlFunctions::'if' and preserves types, order, occurrence identity and source provenance.",
      "normative": "docs/spec/01-structure-and-types.md"
    },
    {
      "source": "OrExpression",
      "kind": "value",
      "kernel": [
        "Expression"
      ],
      "semantic": "OrExpression: preserve typed expressions and operators, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/01-structure-and-types.md"
    },
    {
      "source": "AndExpression",
      "kind": "value",
      "kernel": [
        "Expression"
      ],
      "semantic": "AndExpression: preserve typed expressions and operators, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/01-structure-and-types.md"
