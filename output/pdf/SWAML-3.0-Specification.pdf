        const enclosing = a.isStateStep(n) && a.isStateStep(n.$container) ? byPath.get(`${id.slice(0, id.length - n.name.length - 1)}.${n.$container.name}`) : undefined;
        const parent = a.isPackage(n) ? undefined : enclosing ?? ownerOf(id);
