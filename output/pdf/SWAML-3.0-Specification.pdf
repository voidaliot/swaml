                    if (packageEndpoint(this.target.package, l.source) && packageEndpoint(this.target.package, l.target))
                        this.routes.push({ id: l.name ?? `@package${i}`, endpoints: [l.source, l.target], policy: effectiveQos(l), ...routeMembers(l) });
                });
