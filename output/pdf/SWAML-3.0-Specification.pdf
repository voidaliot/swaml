    },
    {
      "source": "PortDef",
      "kind": "element",
      "kernel": [
        "Feature"
      ],
      "semantic": "PortDef: preserve directed port members, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/02-communication.md"
    },
    {
      "source": "PortUsage",
      "kind": "element",
      "kernel": [
        "Feature"
      ],
      "semantic": "PortUsage: preserve directed port members, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/02-communication.md"
    },
    {
      "source": "PortMember",
      "kind": "grouping",
      "kernel": [],
      "semantic": "PortMember: a directed attribute, event or operation member of a port. An attribute member with an initial value maps the initial value as the feature default value (WP6-S02); a sampled read p.m lowers to a read of a per-port-occurrence sample feature, not a transfer step (WP6-M03). It preserves direction, order, types and source provenance.",
      "normative": "docs/spec/02-communication.md"
    },
    {
      "source": "Connect",
      "kind": "element",
      "kernel": [
        "Connector"
      ],
      "semantic": "Connect: a connector between two ports with an optional connection policy and an optional body of member policies, each selecting the effective policy of one member route (WP6-S05, WP6-S07); it preserves ownership, order, occurrence identity and source provenance.",
      "normative": "docs/spec/02-communication.md"
    },
    {
      "source": "MemberPolicy",
      "kind": "reference",
      "kernel": [
        "Connector"
      ],
      "semantic": "MemberPolicy: references the effective policy of one member route of the owning connector (WP6-M02). It preserves order and source provenance.",
      "normative": "docs/spec/02-communication.md"
    },
    {
      "source": "QosPolicy",
      "kind": "element",
      "kernel": [
        "Connector"
      ],
      "semantic": "QosPolicy: preserve policy-bearing connection, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/02-communication.md"
    },
    {
      "source": "PolicySetting",
      "kind": "element",
      "kernel": [
        "Connector"
      ],
      "semantic": "PolicySetting: a named QoS setting with one expression value (WP4-G01); requestTimeout, maxLatency and maxAge are duration literals in nanoseconds and the other settings are not durations (WP4-S02). It preserves ownership, order and source provenance.",
      "normative": "docs/spec/02-communication.md"
    },
    {
      "source": "Operation",
      "kind": "element",
      "kernel": [
        "Behavior"
      ],
      "semantic": "Operation: preserve operations and nested ownership, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "OperationUsage",
      "kind": "element",
      "kernel": [
        "Behavior"
      ],
      "semantic": "OperationUsage: preserve operations and nested ownership, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Executable",
      "kind": "element",
      "kernel": [
        "Behavior"
      ],
      "semantic": "Executable: preserve operations and nested ownership, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "OperationBody",
      "kind": "grouping",
      "kernel": [],
      "semantic": "OperationBody: preserve operations and nested ownership, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Schedule",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Schedule: preserve schedule entry and successful chaining, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "ScheduleEntry",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "ScheduleEntry: a release trigger and its operation; a period or deadline is a literal or an expression of the constant sublanguage with one value per expanded occurrence (WP4-S04 to WP4-S07). An every, receive or after entry may carry a release guard, written if (g) after the call (SIF-G01), which lowers to a guard evaluated at the first step of the activation, before its arguments; a false guard is a skip that evaluates no argument, runs no operation and counts as completion for after successors (WP7-S01, WP7-M02). The guard is not part of trigger identity. It preserves entry order, trigger identity, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Block",
      "kind": "grouping",
      "kernel": [],
      "semantic": "Block: preserve statements and decisions, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Statement",
      "kind": "grouping",
      "kernel": [],
      "semantic": "Statement: preserve statements and decisions, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "StateStep",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "StateStep: a state written as a statement of the flow (SIF-G01): reached by the flow, a leave or a jump, its on entry runs once and it stays entered, waiting, until a look leaves it (SIF-R01, SIF-R05). Its braces hold entry and exit actions, event lines and statements, then inner states (SIF-S03). It lowers to a state usage of the operation's behaviour, preserving ownership, order, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "StateMember",
      "kind": "grouping",
      "kernel": [],
      "semantic": "StateMember: an item standing in a state's braces, an entry or exit action, an event line, a statement or an inner state (SIF-G01); items keep their written order, which is the order of a look (SIF-R02), and their statement identities.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "EventLine",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "EventLine: an on receive p.m(x) or after D line of a state (SIF-G01); its block runs at a look at which its event is present (SIF-R02, SIF-R03). A timer is a literal or a computed integral duration evaluated once at arrival (SIF-R01). It lowers to an accept action or time event of the state, preserving order, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "ShortBody",
      "kind": "grouping",
      "kernel": [],
      "semantic": "ShortBody: a body without braces that is exactly exit; or to S; (SIF-S08). It builds the same block as the braced form, so it lowers like it and has the same statement identities.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Leave",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Leave: exit; or to S; (SIF-G01), the statements that leave a state (SIF-R09).",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Exit",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Exit: leaves the state at whose level it is written and goes on with what is written next (SIF-R09); it lowers to a transition to the successor of that state, preserving order, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Jump",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Jump: to S leaves the states up to the list that contains S and reaches S, entering parents on the way (SIF-R09, SIF-S06); it lowers to a transition to S, preserving order, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "LocalVariable",
      "kind": "element",
      "kernel": [
        "Feature"
      ],
      "semantic": "LocalVariable: preserve attributes and lexical locals, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/01-structure-and-types.md"
    },
    {
      "source": "Assign",
      "kind": "element",
      "kernel": [
        "Feature"
      ],
      "semantic": "Assign: a statement that writes a place, a bare name or a root followed by selectors; it lowers to a whole-value write of the root (WP1-M02), preserving statement order, types, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Selector",
      "kind": "value",
      "kernel": [
        "Expression"
      ],
      "semantic": "Selector: a record field or array element of a copied value (WP1-M02). A read yields a copy; a place assignment lowers to a whole-value write of its root with one replaced feature value and never becomes a reference feature.",
      "normative": "docs/spec/01-structure-and-types.md"
    },
    {
      "source": "ExpressionStatement",
      "kind": "value",
      "kernel": [
        "Expression"
      ],
      "semantic": "ExpressionStatement: an operator expression used as a statement, never a conditional (WP2-G02); it preserves expression calls and copied out values, types, order, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Send",
      "kind": "element",
      "kernel": [
        "Feature"
      ],
      "semantic": "Send: preserve directed port members, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/02-communication.md"
    },
    {
      "source": "Return",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Return: preserve expression calls and copied out values, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "If",
      "kind": "element",
      "kernel": [
        "Feature"
      ],
      "semantic": "If: a decision statement that runs its then block when its bool condition holds and otherwise its else block or, written else if, another if statement (SIF-G01); it preserves statement order, types, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "ElseIf",
      "kind": "element",
      "kernel": [
        "Feature"
      ],
      "semantic": "ElseIf: the one if statement written directly after else (SIF-G01). It lowers exactly as an else block holding that statement, so else if (c) and else { if (c) } have one meaning; its if has the statement identity of the if in else { if (c) }, so rewriting one spelling as the other keeps every identity. It preserves order, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "While",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "While: preserve loops and copied iteration, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Until",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Until: preserve loops and copied iteration, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "For",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "For: preserve loops and copied iteration, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "ForUpdate",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "ForUpdate: preserve loops and copied iteration, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "ForEach",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "ForEach: preserve loops and copied iteration, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Wait",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Wait: a suspension for a literal duration or for a computed integral duration evaluated when the statement starts waiting (WP4-S03); it preserves statement order, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Receive",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Receive: a suspension until one of its branches takes input, with an optional timeout that is a literal or a computed integral duration evaluated when the statement starts waiting (WP4-S03); it preserves branch order, occurrence identity and source provenance.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "ReceiveBranch",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "ReceiveBranch: preserve suspending wait and receive, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Interruptible",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Interruptible: preserve armed interrupt and cancellation, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Fail",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Fail: preserve runtime failure and lazy fallback, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Assert",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "Assert: preserve runtime failure and lazy fallback, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "StateAction",
      "kind": "lowering",
      "kernel": [
        "Feature"
      ],
      "semantic": "StateAction: preserve states as steps of the flow, ownership, types, order, occurrence identity and source provenance as defined in its normative chapter.",
      "normative": "docs/spec/03-behavior.md"
    },
    {
      "source": "Deployment",
      "kind": "element",
