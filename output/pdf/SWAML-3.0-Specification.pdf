        for (const s of flowStates(op)) {
            if (seen.has(s.name))
                this.report(s, 'SW2008', `Two states are named ${formatName(s.name, MESSAGE_SPELLING)} in ${formatName(op.name, MESSAGE_SPELLING)} (SIF-S02).`, false, this.at(s, 'name'));
