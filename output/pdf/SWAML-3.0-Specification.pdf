      "keyword": "verify",
      "meaning": "Records the intent that a test of the package verifies a requirement; many-to-many.",
      "concern": "Requirements and package intent links",
      "normative": "docs/spec/04-systems-and-conformance.md",
      "example": "'verify' requirement=[Requirement:QualifiedName] 'by' test=[Scenario:Name] ';';",
      "contextual": false,
      "productions": [
        "Verification"
      ]
    },
    {
      "keyword": "view",
      "meaning": "Used in seven library view definitions; see its grammar contexts and normative constraints.",
      "concern": "Seven library view definitions",
      "normative": "docs/spec/04-systems-and-conformance.md",
      "example": "'view' 'def' name=Name documentation=Documentation? ';';",
