package Swaml::Numeric {
  /** Integer and real helpers and the correctly rounded square root (swa.ml 2.3). */
  operation def minInt(a: int, b: int) returns int { if (a < b) { return a; } return b; }
  operation def maxInt(a: int, b: int) returns int { if (a > b) { return a; } return b; }
  operation def clampInt(v: int, low: int, high: int) returns int { if (v < low) { return low; } if (v > high) { return high; } return v; }
  operation def clamp(v: real, low: real, high: real) returns real { if (v < low) { return low; } if (v > high) { return high; } return v; }
  operation def sqrt(v: real) returns real { /** Host intrinsic: IEEE-754 correctly rounded square root; an argument below zero is the runtime failure Arithmetic. */ }
}
package Swaml::Text {
  /** Decimal text of numbers and booleans (swa.ml 2.3). */
  operation def intText(v: int) returns string { /** Host intrinsic: decimal digits, '-' for negatives, no leading zeros. */ }
  operation def realText(v: real, decimals: uint) returns string { /** Host intrinsic: the exact binary value rounded to exactly decimals fraction digits, ties away from zero, plain notation, no signed zero; decimals above 15 or a magnitude of at least 1e21 is the runtime failure Bounds. */ }
  operation def boolText(v: bool) returns string { if (v) { return "true"; } return "false"; }
}
package Swaml::Time {
  /** The logical clock of the reference run (swa.ml 2.3). */
  operation def now() returns uint { /** Host intrinsic: the logical time of the evaluating step in nanoseconds since the run epoch; reads state. */ }
}
package Swaml::Os {
  /** Cores and operating-system tasks of a deployment platform (swa.ml 2.3). The values are design decisions checked statically (T1 to T7); costs and budgets belong to a target binding. With zero-cost steps a run orders equal-time work by priority and in-task position, but never preempts: an activation runs on its Core until it waits or ends before the next one of that Core starts. Preemption and response times belong to the target and its binding; kind, preemptive and responseNs have no runtime effect. */
  import Swaml::Platform;
  enum TaskKind {
    basic,
    extended,
    isr
  }
  component def Core specializes Node {
    /** A processor core. The Tasks of a Core are the Task occurrences whose nearest Core ancestor it is; Tasks without a Core ancestor form one implicit Core per platform root. */
  }
  component def Task specializes Process {
    /** An operating-system task: kind, priority (higher first, unique per Core), preemptability, period and response bound. */
    const attribute kind: TaskKind = TaskKind.basic;
    const attribute priority: uint = 0;
    const attribute preemptive: bool = true;
    const attribute periodNs: uint = 0 /** 0: event-activated. */;
    const attribute responseNs: uint = 0 /** Response bound of an event-activated task or ISR; 0: none. */;
  }
}
