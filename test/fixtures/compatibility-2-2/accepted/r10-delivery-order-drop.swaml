package Fz {
  port def In { requires event a(v: int); requires event b(v: int); requires event c(); }
  port def Out { provides event a(v: int); provides event b(v: int); provides event c(); }
  port def Ob { provides event res(v: int); }
  port def Ib { requires event res(v: int); }
  component def M {
    port i: In;
    port o: Ob;
    attribute n: int = 0;
    attribute m: int = 0;
    attribute k: int = 0;
    operation run() {
      initial S0;
      state S0 {
        on entry { m = m + 1; m = m + 1; publish o.res(3);  }
        on receive i.a(x) to S1 {  }
        on receive i.c() to S0 { k = k + 9; m = m + 1; publish o.res(11); }
        on receive i.c() when (n > 3) to S2 { m = m + 1; }
      }
      state S2 {
        on entry { m = m + 1; publish o.res(7); publish o.res(8);  }
        after 5ms to S0 {  }
        on receive i.c() to S2 { publish o.res(15); publish o.res(16); }
      }
      state S1 {
        on exit { k = k + 4; publish o.res(5); }
        after 7ms to S3 { m = m + 1; }
        on receive i.a(y) to S1 {  }
        after 4ms to S0 { m = m + 1; k = k + 14; }
      }
      state S3 {
        on receive i.a(y) to S2 { publish o.res(y + 17); m = m + 1; publish o.res(19); }
        on receive i.a(v) when (v > 1) to S3 { m = m + 1; }
        on receive i.a(x) to S1 {  }
        on receive i.a(y) when (y > 1) to S1 {  }
        on receive i.b(x) to S2 { publish o.res(x + 22); }
      }
    }
    schedule { on start run(); }
  }
  component def D {
    port q: Out;
    port w: Ib;
    attribute got: int = 0;
    operation emit() { publish q.c(); publish q.a(4); publish q.c(); publish q.a(4); wait 1ms; wait 5ms; wait 3ms; wait 4ms; publish q.a(1); publish q.b(0); }
    operation emitAll() { publish q.a(0); publish q.b(0); publish q.c(); }
    operation sink(v: int) { got = got * 3 + v; }
    schedule { on start emit(); on receive w.res(v) sink(v); }
  }
  component mm: M;
  component d: D;
  connect (d.q, mm.i);
  connect (mm.o, d.w);
}
