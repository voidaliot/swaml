package Fz {
  port def In { requires event a(v: int); requires event b(v: int); requires event c(); }
  port def Out { provides event a(v: int); provides event b(v: int); provides event c(); }
  port def Ob { provides event res(v: int); }
  port def Ib { requires event res(v: int); }
  component def M {
    port i: In;
    port o: Ob;
    attribute n: int = 0;
    attribute m: int = 0;
    attribute k: int = 0;
    operation run() {
      initial S0;
      state S0 {
        on receive i.c() to F0 { k = k + 2; publish o.res(3); publish o.res(4); }
        after 8ms to S2 {  }
        after 4ms to S1 {  }
        on receive i.a(v) to S1 { k = k + 5; publish o.res(v + 6); }
      }
      state S2 {
        on receive i.c() when (n > 0) to S0 {  }
      }
      state S1 {
        on entry { publish o.res(1);  }
        on receive i.c() to S2 { m = m + 1; k = k + 23; }
        on receive i.c() to S2 { publish o.res(19); m = m + 1; if (n > 3) { m = m + 21; } else { publish o.res(21); } }
        on receive i.a(v) to S2 { m = m + 1; n = n + v; m = m + 1; }
        on receive i.c() when (n > 3) to F0 { k = k + 7; }
        on receive i.c() when (n > 2) to S2 { if (n > 4) { m = m + 16; } else { publish o.res(16); } m = m + 1; if (n > 1) { m = m + 18; } else { publish o.res(18); } }
        on receive i.c() when (n > 3) to S2 { if (n > 1) { m = m + 24; } else { publish o.res(24); } publish o.res(25); }
        after 1ms to S2 { if (n > 1) { m = m + 9; } else { publish o.res(9); } publish o.res(10); }
        on receive i.b(x) to S2 { m = m + 1; }
        after 6ms to S2 { m = m + 1; }
        after 2ms to S2 { k = k + 14; }
      }
      final state F0 { }
    }
    operation helper() { var j: int = 0; while (j < 4) { n = n + 1; wait 3ms; j = j + 1; } }
    schedule { on start run(); on start helper(); }
  }
  component def D {
    port q: Out;
    port w: Ib;
    attribute got: int = 0;
    operation emit() { publish q.a(6); publish q.b(2); publish q.c(); wait 3ms; wait 2ms; publish q.c(); publish q.a(6); publish q.b(4); publish q.c(); publish q.c(); }
    operation emitAll() { publish q.a(0); publish q.b(0); publish q.c(); }
    operation sink(v: int) { got = got * 3 + v; }
    schedule { on start emit(); on receive w.res(v) sink(v); }
  }
  component mm: M;
  component d: D;
  connect (d.q, mm.i);
  connect (mm.o, d.w);
}
