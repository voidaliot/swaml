package Fz {
  port def In { requires event a(v: int); requires event b(v: int); requires event c(); }
  port def Out { provides event a(v: int); provides event b(v: int); provides event c(); }
  port def Ob { provides event res(v: int); }
  port def Ib { requires event res(v: int); }
  component def M {
    port i: In;
    port o: Ob;
    attribute n: int = 0;
    attribute m: int = 0;
    attribute k: int = 0;
    operation run() {
      initial S0;
      state S0 {
        on exit { if (n > 3) { m = m + 1; } else { publish o.res(1); } }
        on receive i.a(x) to F0 { m = m + 1; k = k + 27; k = k + 28; }
        on receive i.a(y) when (y > 3) to S0 { m = m + 1; k = k + 8; }
        on receive i.b(v) when (n > 3) to S2 { k = k + 9; m = m + 1; }
        on receive i.c() to S1 {  }
        on receive i.b(x) when (n > 3) to S2 { k = k + 11; m = m + 1; }
      }
      state S1 {
        on exit { if (n > 0) { m = m + 2; } else { publish o.res(2); } k = k + 3; m = m + 1; }
        after 1ms to F0 { k = k + 20; m = m + 1; if (n > 0) { m = m + 22; } else { publish o.res(22); } }
        after 8ms to S1 { k = k + 13; }
        on receive i.b(y) to S1 { publish o.res(y + 14); if (n > 1) { m = m + 15; } else { publish o.res(15); } }
        on receive i.c() when (n > 1) to F0 { publish o.res(19); }
        on receive i.a(y) when (n > 3) to F0 { publish o.res(y + 23); m = m + 1; publish o.res(25); }
      }
      state S2 {
        on exit { k = k + 5; k = k + 6; }
        on receive i.c() when (n > 3) to S1 { publish o.res(16); }
        after 3ms to F0 { m = m + 1; k = k + 18; }
        after 6ms to F0 {  }
      }
      final state F0 { on entry { if (n > 1) { m = m + 29; } else { publish o.res(29); } publish o.res(30); } }
    }
    schedule { on start run(); }
  }
  component def D {
    port q: Out;
    port w: Ib;
    attribute got: int = 0;
    operation emit() { publish q.c(); publish q.b(2); publish q.a(2); publish q.c(); publish q.a(0); wait 1ms; publish q.b(5); wait 3ms; wait 5ms; publish q.a(3); }
    operation emitAll() { publish q.a(0); publish q.b(0); publish q.c(); }
    operation sink(v: int) { got = got * 3 + v; }
    schedule { on start emit(); on receive w.res(v) sink(v); }
  }
  component mm: M;
  component d: D;
  connect (d.q, mm.i);
  connect (mm.o, d.w);
}
