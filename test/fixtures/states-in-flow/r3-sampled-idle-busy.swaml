package SampledIdleBusy {
  port def Sense { provides attribute current: uint = 0; }
  port def Cmd { provides event k(); }
  component def L {
    reversed port sense: Sense;
    reversed port cmd: Cmd;
    attribute got: uint = 0;
    operation run() {
      state closing {
        if (sense.current > 4500) exit;
        on receive sense.current(v) { }
        on receive cmd.k() { wait 2ms; }
      }
      state reversing {
        on receive sense.current(v) { got = v; }
      }
    }
    schedule { on start run(); }
  }
  component def Bench { port out: Sense; port c: Cmd; }
  component l: L;
  component bench: Bench;
  connect (bench.out, l.sense);
  connect (bench.c, l.cmd);
  associate bench to 'Idle', 'Busy';
  test 'Idle' of l {
    wait 1ms;
    send bench.out.current(5000);
    wait 5ms;
    assert l.got == 5000;
  }
  test 'Busy' of l {
    publish bench.c.k();
    wait 1ms;
    send bench.out.current(5000);
    wait 5ms;
    assert l.got == 5000;
  }
}
