    operation tick() {
      /** A periodic machine released every 100 ms: off until heating is requested; active switches the heater on in its on entry and off in its on exit, whichever way it is left. */
      while (true) {
        state off {
          if (requested) exit;
        }
        state active {
          on entry { heating = true; send drive.heaterPercent(heaterPercent); }
          on exit { heating = false; send drive.heaterPercent(0); }
          if (not requested) exit;
          // The 10 minute limit, counted as the 100 ms tick counter it replaces counted: 6000 releases from the release
          // that switched on, which is 6000 - 1 periods after the arrival look of active.
          after ((heaterLimitMs - 100) * 1ms) { requested = false; exit; }
        }
      }
    }
